root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown content files (including YAML front matter) must use spaces.
# YAML forbids tab characters for indentation.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# These service wrappers intentionally propagate JS failures to callers/Blazor.
# Teardown callers handle JSDisconnectedException; do not mask other failures here.
[src/Respondeo.UI/Services/{Interop/{BrowseStateInterop,DialogInterop,TallyInterop},Summa/SummaRefInterop,TextSizeService,ThemeService}.cs]
dotnet_diagnostic.BL0016.severity = none

# Navigation services must not hide JS failures behind successful storage or scroll results.
[src/Respondeo.UI/Services/Navigation/{BreadcrumbTrail,ScrollCoordinator,VisitedNodes}.cs]
dotnet_diagnostic.BL0016.severity = none
