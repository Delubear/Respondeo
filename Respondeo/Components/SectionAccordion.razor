@using System.Web
@using Microsoft.JSInterop
@using Respondeo.Content.Abstractions
@implements IDisposable
@inject IContentService Content
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_sections.Count > 0)
{
    <div class="accordion">
        @foreach (var section in _sections)
        {
            var isOpen = section.Id == _openId;
            var panelId = $"panel-{section.Id}";
            var headerId = $"header-{section.Id}";
            <section class="accordion__item @(isOpen ? "accordion__item--open" : null)">
                <h3 class="accordion__heading">
                    <button type="button"
                            id="@headerId"
                            class="accordion__trigger"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            aria-controls="@panelId"
                            @onclick="() => ToggleAsync(section.Id)">
                        <span class="accordion__title">@section.Title</span>
                        <span class="accordion__marker" aria-hidden="true">@(isOpen ? "\u2212" : "+")</span>
                    </button>
                </h3>
                @if (isOpen)
                {
                    <div id="@panelId" role="region" aria-labelledby="@headerId" class="accordion__panel">
                        @((MarkupString)section.BodyHtml)
                    </div>
                }
            </section>
        }
    </div>
}

@code {
    /// <summary>The parent node id; used as the base path when writing the ?section= query.</summary>
    [Parameter] public string NodeId { get; set; } = string.Empty;

    /// <summary>Ordered section content-node ids to present as collapsible panels.</summary>
    [Parameter] public IReadOnlyList<string> SectionIds { get; set; } = Array.Empty<string>();

    private const string QueryKey = "section";

    private readonly List<ContentNode> _sections = new();
    private string? _openId;
    private string? _pendingUrl;
    private string? _scrollToId;

    protected override async Task OnParametersSetAsync()
    {
        _sections.Clear();
        foreach (var id in SectionIds)
        {
            var node = await Content.GetByIdAsync(id);
            if (node is not null)
            {
                _sections.Add(node);
            }
        }

        var before = _openId;
        ApplyOpenFromUrl();
        // If the page loaded with a valid ?section= (e.g. a shared link), scroll it into view.
        if (_openId is not null && _openId != before)
        {
            _scrollToId = $"header-{_openId}";
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Sync the open panel when the URL changes (e.g. browser back/forward or a shared link).
        var previous = _openId;
        ApplyOpenFromUrl();
        if (previous != _openId)
        {
            if (_openId is not null)
            {
                _scrollToId = $"header-{_openId}";
            }
            StateHasChanged();
        }
    }

    // A valid ?section=<id> that matches a loaded section opens it; anything else collapses all.
    private void ApplyOpenFromUrl()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var value = HttpUtility.ParseQueryString(uri.Query).Get(QueryKey);
        _openId = value is not null && _sections.Any(s => s.Id == value) ? value : null;
    }

    private Task ToggleAsync(string id)
    {
        // Accordion behaviour: opening a section closes the others; clicking the open one closes it.
        _openId = _openId == id ? null : id;
        // Compute the shareable URL and update it silently after render (see OnAfterRenderAsync).
        _pendingUrl = Nav.GetUriWithQueryParameter(QueryKey, _openId);
        // When opening, reveal the section in case its content expands below the fold.
        _scrollToId = _openId is null ? null : $"header-{_openId}";
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingUrl is not null)
        {
            var url = _pendingUrl;
            _pendingUrl = null;
            // Update the address bar via the History API instead of NavigationManager.NavigateTo.
            // In Blazor WASM, NavigateTo raises LocationChanged, which retriggers FocusOnNavigate and
            // scrolls to the top. history.replaceState keeps the URL shareable without any navigation,
            // focus shift, or scroll, so the visitor stays exactly where they are.
            await JS.InvokeVoidAsync("respondeoUrl.replace", url);
        }

        if (_scrollToId is not null)
        {
            var target = _scrollToId;
            _scrollToId = null;
            // Smoothly bring the opened section into view (deep link on load or a normal open
            // whose expanded content runs past the bottom of the viewport).
            await JS.InvokeVoidAsync("respondeoScroll.intoView", target);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
