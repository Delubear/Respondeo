@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="scroll-progress" style="width:@ProgressStyle"></div>

<button type="button"
        class="back-to-top @(_showBackToTop ? "is-visible" : string.Empty)"
        @onclick="ScrollToTopAsync"
        aria-label="Back to top"
        title="Back to top">
    ↑
</button>

@code {
    private double _progress;
    private bool _showBackToTop;
    private DotNetObjectReference<ScrollAffordances>? _ref;
    private IJSObjectReference? _module;

    private string ProgressStyle => _progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scroll.js");
            _ref = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("register", _ref);
        }
    }

    [JSInvokable]
    public void OnScroll(double progress, bool showButton)
    {
        _progress = progress;
        _showBackToTop = showButton;
        StateHasChanged();
    }

    private async Task ScrollToTopAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollToTop");
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_module is not null)
        {
            _ = _module.InvokeVoidAsync("jumpToTop");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _ref?.Dispose();
    }
}
