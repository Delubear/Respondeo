@* Renders a content node's article body: title, summary, body HTML, optional
   sections accordion, and branch cards. Shared by the Node page and the stage
   landing pages so they present identical styling. *@
@inject IContentService Content

<article class="node" @key="Node.Id">
    <header class="node__header">
        <h1 class="node__title">@Node.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Node.Summary))
        {
            <p class="node__summary">@Node.Summary</p>
        }
    </header>

    <div class="node__body">
        @((MarkupString)Node.BodyHtml)
    </div>

    @if (Node.Sections.Count > 0)
    {
        <SectionAccordion NodeId="@Node.Id" SectionIds="Node.Sections" />
    }

    @if (_branches.Count > 0)
    {
        <section class="branches">
            <h2 class="branches__heading">@(_branches.Count == 1 ? "Where to go next" : "Where would you like to go next?")</h2>
            <CardGrid>
                @foreach (var branch in _branches)
                {
                    <Card Href="@branch.Href"
                          Title="@branch.Label"
                          Summary="@branch.Link.Prompt"
                          Cta="Continue →"
                          Level="3" />
                }
            </CardGrid>
        </section>
    }

    @if (Node.NextStage is not null)
    {
        <section class="next-stage">
            <p class="next-stage__eyebrow"><span>The Next Stage</span></p>
            <a class="next-stage__cta" href="@RelativeHref(Node.NextStage.Href)">
                <span class="next-stage__emblem" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                        <path d="@EmblemPath(Node.NextStage.Icon)" />
                    </svg>
                </span>
                <span class="next-stage__body">
                    <span class="next-stage__label">
                        @Node.NextStage.Label
                        <span class="next-stage__arrow" aria-hidden="true">→</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Node.NextStage.Prompt))
                    {
                        <span class="next-stage__prompt">
                            @foreach (var sentence in SplitSentences(Node.NextStage.Prompt))
                            {
                                <span class="next-stage__prompt-line">@sentence</span>
                            }
                        </span>
                    }
                </span>
            </a>
        </section>
    }
</article>

@code {
    [Parameter, EditorRequired] public ContentNode Node { get; set; } = default!;

    private readonly List<ResolvedBranch> _branches = new();

    protected override async Task OnParametersSetAsync()
    {
        var branches = new List<ResolvedBranch>();
        foreach (var link in Node.Branches)
        {
            var target = await Content.GetByIdAsync(link.To);
            var label = link.Label ?? target?.Title ?? link.To;
            var href = ContentRoutes.NodeHref(link.To, target?.Stage);
            branches.Add(new ResolvedBranch(link, label, href));
        }

        _branches.Clear();
        _branches.AddRange(branches);
    }

    // Splits the prompt into its sentences so each renders on its own line, keeping the
    // terminating punctuation attached to each sentence.
    private static IEnumerable<string> SplitSentences(string prompt) => System.Text.RegularExpressions.Regex
            .Split(prompt.Trim(), @"(?<=[.!?])\s+")
            .Where(s => !string.IsNullOrWhiteSpace(s));

    // Authored next-stage hrefs may include a leading slash (e.g. "/why-jesus"). A root-absolute
    // href ignores <base href> and would escape the app's sub-path when hosted under one (e.g.
    // GitHub Pages at /Respondeo/). Trim the leading slash so the link resolves relative to base.
    private static string RelativeHref(string href) => href.TrimStart('/');

    // Maps a configurable emblem name to an SVG path. The question mark is the default so a
    // transition that doesn't specify an icon reads as an open question rather than a fixed symbol.
    private static string EmblemPath(string? icon) => (icon?.Trim().ToLowerInvariant()) switch
    {
        "cross" => "M10 2h4v6h6v4h-6v10h-4V12H4V8h6z",
        "compass" => "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm4 4-5.5 2.5L8 16l5.5-2.5L16 8zm-4 3.2a.8.8 0 1 1 0 1.6.8.8 0 0 1 0-1.6z",
        "scroll" => "M6 2h11a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V4a2 2 0 0 1 2-2zm0 2v13a1 1 0 0 0 1 1h8.2A3 3 0 0 1 15 17V5a1 1 0 0 0-1-1H6zm3 3h6v2H9V7zm0 4h6v2H9v-2z",
        _ => "M11 18h2v-2h-2v2zm1-16C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.4 0-8-3.6-8-8s3.6-8 8-8 8 3.6 8 8-3.6 8-8 8zm0-14a4 4 0 0 0-4 4h2a2 2 0 1 1 3 1.7c-.8.6-2 1.3-2 3.3h2c0-1.3 1.2-1.6 2.2-2.6A4 4 0 0 0 12 6z",
    };

    private sealed record ResolvedBranch(BranchLink Link, string Label, string Href);
}
