@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The Home "journey reel": a vertical scroll-snap list of stage cards. Stage 1 sits
   at the BOTTOM and the journey climbs upward. Owns its JS interop lifecycle
   (import / init / dispose) and the scroll-affordance controls. Callers pass in the
   ordered list of stages; data loading stays with the page. *@

<div class="reel-wrap">
    <div class="reel" role="listbox" tabindex="0" aria-label="The journey, stage by stage. Use the arrow keys to move between stages." @ref="_reel">
        @for (var i = Stages.Count - 1; i >= 0; i--)
        {
            var stage = Stages[i];
            <div class="reel__step" role="option">
                <StageCard Href="@stage.Slug"
                           Icon="@Emblems.ForStage(stage.Slug)"
                           Label="@stage.Node.Title"
                           Eyebrow="@($"Stage {i + 1} of {Stages.Count}")"
                           Prompt="@stage.Node.Summary" />
            </div>
        }
    </div>

    <button type="button" class="reel__hint reel__hint--up" @onclick="ScrollUpAsync" aria-label="Show the next stage">
        <span class="reel__chevron"></span>
        <span class="reel__hint-label">Keep climbing</span>
    </button>
    <button type="button" class="reel__hint reel__hint--down" @onclick="ScrollDownAsync" aria-label="Show the previous stage">
        <span class="reel__hint-label">Earlier steps</span>
        <span class="reel__chevron"></span>
    </button>

    <div class="reel-dots" role="tablist" aria-label="Jump to a stage"></div>
</div>

@code {
    /// <summary>The ordered stages to render, one card per stage.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ReelStage> Stages { get; set; } = [];

    private ElementReference _reel;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The reel renders Stage 1 (the starting point) at the BOTTOM so the journey climbs
        // upward toward God. Start the reader there, and let the module apply an
        // IntersectionObserver fallback for the turning effect where scroll-driven CSS
        // animations aren't supported.
        if (Stages.Count > 0 && _module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reel.js");
            await _module.InvokeVoidAsync("init", _reel);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _reel);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone during teardown; nothing to clean up.
            }
        }
    }

    // Scroll upward (toward God / later stages).
    private async Task ScrollUpAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, -1);
        }
    }

    // Scroll downward (back toward the starting point / earlier stages).
    private async Task ScrollDownAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, 1);
        }
    }

    /// <summary>A single stage in the reel: its slug (route) and its landing node.</summary>
    public sealed record ReelStage(string Slug, ContentNode Node);
}
