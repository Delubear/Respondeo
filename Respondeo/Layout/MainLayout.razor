@inherits LayoutComponentBase

<div class="page">
    <a class="skip-link" href="#content">Skip to content</a>

    <ScrollAffordances />

    <header class="masthead">
        <ThemeToggle />
        <a class="masthead__brand" href="">
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
            <span class="masthead__name">Respondeo</span>
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
        </a>
        <p class="masthead__tag">Real questions. Reasoned answers.</p>
    </header>

    <MastheadNav />

    <main class="content" id="content" tabindex="-1">
        <div class="content__inner">
            @Body
        </div>
    </main>

    <footer class="colophon">
        <p>
            Presented in the spirit of St. Thomas Aquinas.
            Content is curated for study, not a substitute for the Magisterium of the Catholic Church.
        </p>
        <p>
            Quotations from the <i>Summa Theologiae</i> follow the English translation by the
            Fathers of the English Dominican Province (1920, second and revised edition), which is in the public domain.
        </p>
    </footer>
</div>

