@page "/why-the-church"
@inject IContentService Content

<PageTitle>Why the Church? &mdash; Respondeo</PageTitle>

@if (_loading)
{
    <Loading>Loading&hellip;</Loading>
}
else if (_node is null)
{
    <section class="landing">
        <h1 class="landing__title">Why the Church?</h1>
        <p class="landing__placeholder">Content for this stage is coming soon.</p>
    </section>
}
else
{
    <NodeArticle Node="_node" />
}

@code {
    private const string NodeId = "why-the-church";

    private ContentNode? _node;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _node = await Content.GetByIdAsync(NodeId);
        _loading = false;
    }
}
