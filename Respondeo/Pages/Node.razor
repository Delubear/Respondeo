@page "/node/{Id}"
@page "/{Stage}/node/{Id}"
@inject IContentService Content
@inject NavigationManager Nav
@inject IBreadcrumbTrail Trail

@if (_node is not null)
{
    <PageTitle>@_node.Title &mdash; Respondeo</PageTitle>
}

<Breadcrumb Crumbs="_crumbs" CurrentTitle="@_node?.Title" ShowArticles="_fromArticles" StageHref="@_stageHref" StageLabel="@_stageLabel" />

@if (_loading)
{
    <Loading>Loading&hellip;</Loading>
}
else if (_node is null)
{
    <section class="node">
        <h1>This path hasn't been written yet</h1>
        <p>There is no content node with the id "<code>@Id</code>".</p>
        <a class="btn" href="">Return to the start</a>
    </section>
}
else
{
    <NodeArticle Node="_node" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    // Captured from the nested "/{Stage}/node/{Id}" route. Not used for lookup (the id is the key);
    // it is present only so the stage-scoped URL resolves to this same page.
    [Parameter] public string? Stage { get; set; }

    private ContentNode? _node;
    private bool _loading = true;
    private bool _fromArticles;
    private string? _stageHref;
    private string? _stageLabel;
    private IReadOnlyList<Breadcrumb.Crumb> _crumbs = Array.Empty<Breadcrumb.Crumb>();

    protected override async Task OnParametersSetAsync()
    {
        // Resolve everything into locals before touching the fields the UI binds to.
        // Content is typically cached, so swapping atomically at the end keeps the
        // current node on screen during the load instead of blanking to the spinner,
        // which removes the flash/flicker when moving between nodes.
        var node = await Content.GetByIdAsync(Id);

        // Keep URLs canonical: the stage segment is cosmetic, so a mismatched (or missing) stage
        // in the URL would show the wrong breadcrumb root. When the URL's stage doesn't match the
        // node's real stage, redirect to the node's canonical URL.
        if (node is not null && !string.Equals(Stage ?? string.Empty, node.Stage ?? string.Empty, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(ContentRoutes.NodeHref(node), replace: true);
            return;
        }

        IReadOnlyList<Breadcrumb.Crumb> crumbs = Array.Empty<Breadcrumb.Crumb>();

        if (node is not null)
        {
            crumbs = await BuildBreadcrumbAsync(Id);
        }

        _node = node;
        _fromArticles = await Trail.IsFromArticlesAsync();

        // When the node belongs to a stage (and the visitor didn't arrive via Articles), root the
        // breadcrumb at that stage's landing page instead of Home so it reflects the section.
        if (!_fromArticles && node?.Stage is { Length: > 0 } stage)
        {
            _stageHref = stage;
            _stageLabel = SiteNavigation.Items.FirstOrDefault(i => string.Equals(i.Href, stage, StringComparison.OrdinalIgnoreCase))?.Label ?? node.Stage;
        }
        else
        {
            _stageHref = null;
            _stageLabel = null;
        }

        _crumbs = crumbs;
        _loading = false;
    }

    private async Task<IReadOnlyList<Breadcrumb.Crumb>> BuildBreadcrumbAsync(string id)
    {
        var trail = await Trail.VisitAsync(id);

        // The trail includes the current node as its last element; the rest are ancestors.
        var crumbs = new List<Breadcrumb.Crumb>(trail.Count);
        for (var i = 0; i < trail.Count - 1; i++)
        {
            var ancestor = await Content.GetByIdAsync(trail[i]);
            crumbs.Add(new Breadcrumb.Crumb(trail[i], ancestor?.Title ?? trail[i], ancestor?.Stage));
        }

        return crumbs;
    }
}
