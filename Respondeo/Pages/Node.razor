@page "/node/{Id}"
@inject IContentService Content
@inject NavigationManager Nav
@inject IBreadcrumbTrail Trail

@if (_node is not null)
{
    <PageTitle>@_node.Title &mdash; Respondeo</PageTitle>
}

<Breadcrumb Crumbs="_crumbs" CurrentTitle="@_node?.Title" ShowArticles="_fromArticles" />

@if (_loading)
{
    <Loading>Loading&hellip;</Loading>
}
else if (_node is null)
{
    <section class="node">
        <h1>This path hasn't been written yet</h1>
        <p>There is no content node with the id "<code>@Id</code>".</p>
        <a class="btn" href="">Return to the start</a>
    </section>
}
else
{
    <article class="node" @key="_node.Id">
        <header class="node__header">
            <h1 class="node__title">@_node.Title</h1>
            @if (!string.IsNullOrWhiteSpace(_node.Summary))
            {
                <p class="node__summary">@_node.Summary</p>
            }
        </header>

        <div class="node__body">
            @((MarkupString)_node.BodyHtml)
        </div>

        @if (_node.Sections.Count > 0)
        {
            <SectionAccordion NodeId="@_node.Id" SectionIds="_node.Sections" />
        }

        @if (_branches.Count > 0)
        {
            <section class="branches">
                <h2 class="branches__heading">Where would you like to go next?</h2>
                <CardGrid>
                    @foreach (var branch in _branches)
                    {
                        <Card Href="@($"node/{branch.Link.To}")"
                              Title="@branch.Label"
                              Summary="@branch.Link.Prompt"
                              Cta="Continue →"
                              Level="3" />
                    }
                </CardGrid>
            </section>
        }
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ContentNode? _node;
    private bool _loading = true;
    private bool _fromArticles;
    private readonly List<ResolvedBranch> _branches = new();
    private IReadOnlyList<Breadcrumb.Crumb> _crumbs = Array.Empty<Breadcrumb.Crumb>();

    protected override async Task OnParametersSetAsync()
    {
        // Resolve everything into locals before touching the fields the UI binds to.
        // Content is typically cached, so swapping atomically at the end keeps the
        // current node on screen during the load instead of blanking to the spinner,
        // which removes the flash/flicker when moving between nodes.
        var node = await Content.GetByIdAsync(Id);

        var branches = new List<ResolvedBranch>();
        IReadOnlyList<Breadcrumb.Crumb> crumbs = Array.Empty<Breadcrumb.Crumb>();

        if (node is not null)
        {
            foreach (var link in node.Branches)
            {
                var target = await Content.GetByIdAsync(link.To);
                var label = link.Label ?? target?.Title ?? link.To;
                branches.Add(new ResolvedBranch(link, label));
            }

            crumbs = await BuildBreadcrumbAsync(Id);
        }

        _node = node;
        _fromArticles = await Trail.IsFromArticlesAsync();
        _branches.Clear();
        _branches.AddRange(branches);
        _crumbs = crumbs;
        _loading = false;
    }

    private async Task<IReadOnlyList<Breadcrumb.Crumb>> BuildBreadcrumbAsync(string id)
    {
        var trail = await Trail.VisitAsync(id);

        // The trail includes the current node as its last element; the rest are ancestors.
        var crumbs = new List<Breadcrumb.Crumb>(trail.Count);
        for (var i = 0; i < trail.Count - 1; i++)
        {
            var ancestor = await Content.GetByIdAsync(trail[i]);
            crumbs.Add(new Breadcrumb.Crumb(trail[i], ancestor?.Title ?? trail[i]));
        }

        return crumbs;
    }

    private sealed record ResolvedBranch(BranchLink Link, string Label);
}
