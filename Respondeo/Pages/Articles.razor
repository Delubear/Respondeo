@page "/articles"
@inject IContentService Content
@inject IBreadcrumbTrail Trail

<PageTitle>All Articles &mdash; Respondeo</PageTitle>

<Breadcrumb CurrentTitle="All Articles" />

<section class="articles">
    <header class="articles__header">
        <h1 class="articles__title">All Articles</h1>
        <p class="articles__lede">
            Every article in one place. Sections are folded into their parent articles, so this is
            the complete set of standalone pieces you can explore.
        </p>
    </header>

    @if (_articles is null)
    {
        <Loading>Gathering the articles&hellip;</Loading>
    }
    else
    {
        <div class="articles__layout">
            <aside class="articles__sidebar">
                <h2 class="articles__sidebar-title">Topics</h2>
                <TopicFilter Topics="_topics" @bind-Selected="_selected" />
            </aside>

            <div class="articles__results">
                @if (Filtered.Count == 0)
                {
                    <p class="articles__empty">No articles match the selected topics.</p>
                }
                else
                {
                    <CardGrid>
                        @foreach (var node in Filtered)
                        {
                            <Card Href="@ContentRoutes.NodeHref(node)"
                                  Title="@node.Title"
                                  Summary="@node.Summary"
                                  Cta="Read →"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ContentNode>? _articles;
    private IReadOnlyList<string> _topics = Array.Empty<string>();
    private IReadOnlySet<string> _selected = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        await Trail.SetArticlesOriginAsync(true);

        var all = await Content.GetAllAsync();

        // A "section" is any node referenced in another node's Sections list; those are
        // presented inline on their parent page, so exclude them here. What remains are the
        // standalone articles.
        var sectionIds = all
            .SelectMany(n => n.Sections)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        _articles = all
            .Where(n => !sectionIds.Contains(n.Id))
            .OrderBy(n => n.Title, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        _topics = _articles
            .SelectMany(n => n.Topics)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    // Articles must contain ALL selected topics (intersection). No selection shows everything.
    private IReadOnlyList<ContentNode> Filtered =>
        _articles is null
            ? Array.Empty<ContentNode>()
            : _selected.Count == 0
                ? _articles
                : _articles
                    .Where(n => _selected.All(s => n.Topics.Contains(s, StringComparer.OrdinalIgnoreCase)))
                    .ToList();
}
