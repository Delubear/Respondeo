@page "/"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IContentService Content
@inject IBreadcrumbTrail Trail
@inject IJSRuntime JS

<PageTitle>Respondeo &mdash; Real questions. Reasoned answers.</PageTitle>

<section class="hero">
    <p class="hero__motto">Veritas</p>
    <h1 class="hero__title">One question leads to the next</h1>
    <p class="hero__lede">
        Reason climbs from asking whether God exists all the way to His Church.
        Start at the step that matches where you honestly stand, and follow the path upward.
    </p>
</section>

@if (_stages is null)
{
    <Loading>Preparing the way&hellip;</Loading>
}
else
{
    <div class="reel-wrap">
        <div class="reel" role="list" aria-label="The journey, stage by stage" @ref="_reel">
            @for (var i = _stages.Count - 1; i >= 0; i--)
            {
                var stage = _stages[i];
                <div class="reel__step" role="listitem">
                    <a class="reel__card" href="@stage.Slug">
                        <span class="reel__emblem" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                                <path d="@Emblems.Path(Emblems.ForStage(stage.Slug))" />
                            </svg>
                        </span>
                        <span class="reel__eyebrow">Stage @(i + 1) of @_stages.Count</span>
                        <span class="reel__title">@stage.Node.Title</span>
                        <span class="reel__summary">@stage.Node.Summary</span>
                        <span class="reel__cta">Begin &rarr;</span>
                    </a>
                </div>
            }
        </div>

        <button type="button" class="reel__hint reel__hint--up" @onclick="ScrollUpAsync" aria-label="Show the next stage">
            <span class="reel__chevron"></span>
            <span class="reel__hint-label">Keep climbing</span>
        </button>
        <button type="button" class="reel__hint reel__hint--down" @onclick="ScrollDownAsync" aria-label="Show the previous stage">
            <span class="reel__hint-label">Earlier steps</span>
            <span class="reel__chevron"></span>
        </button>
    </div>

    <div class="home__browse">
        <a class="btn" href="articles">Browse all articles</a>
    </div>
}

@code {
    private List<StageCard>? _stages;
    private ElementReference _reel;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();

        // A card for each stage landing node (id == the stage slug), linking to the stage page.
        var stages = new List<StageCard>();
        foreach (var item in SiteNavigation.Items.Where(i => i.Href.Length > 0))
        {
            var node = await Content.GetByIdAsync(item.Href);
            if (node is not null)
            {
                stages.Add(new StageCard(item.Href, node));
            }
        }

        _stages = stages;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The reel renders Stage 1 (the starting point) at the BOTTOM so the journey climbs
        // upward toward God. Start the reader there, and let the module apply an
        // IntersectionObserver fallback for the turning effect where scroll-driven CSS
        // animations aren't supported.
        if (_stages is not null && _module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reel.js");
            await _module.InvokeVoidAsync("init", _reel);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _reel);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone during teardown; nothing to clean up.
            }
        }
    }

    // Scroll upward (toward God / later stages).
    private async Task ScrollUpAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, -1);
        }
    }

    // Scroll downward (back toward the starting point / earlier stages).
    private async Task ScrollDownAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, 1);
        }
    }

    private sealed record StageCard(string Slug, ContentNode Node);
}
