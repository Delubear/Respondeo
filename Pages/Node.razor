@page "/node/{Id}"
@inject ContentService Content
@inject NavigationManager Nav
@inject IBreadcrumbTrail Trail

@if (_node is not null)
{
    <PageTitle>@_node.Title &mdash; Respondeo</PageTitle>
}

<nav class="breadcrumb">
    <a href="">Start</a>
    @foreach (var crumb in _crumbs)
    {
        <span class="breadcrumb__sep">/</span>
        <a class="breadcrumb__link" href="@($"node/{crumb.Id}")" title="@crumb.Title">@crumb.Title</a>
    }
    <span class="breadcrumb__sep">/</span>
    <span class="breadcrumb__current" title="@(_node?.Title)">@(_node?.Title ?? "…")</span>
</nav>

@if (_loading)
{
    <Loading>Loading&hellip;</Loading>
}
else if (_node is null)
{
    <section class="node">
        <h1>This path hasn't been written yet</h1>
        <p>There is no content node with the id "<code>@Id</code>".</p>
        <a class="btn" href="">Return to the start</a>
    </section>
}
else
{
    <article class="node">
        <header class="node__header">
            <h1 class="node__title">@_node.Title</h1>
            @if (!string.IsNullOrWhiteSpace(_node.Summary))
            {
                <p class="node__summary">@_node.Summary</p>
            }
        </header>

        <div class="node__body">
            @((MarkupString)_node.BodyHtml)
        </div>

        @if (_branches.Count > 0)
        {
            <section class="branches">
                <h2 class="branches__heading">Where would you like to go next?</h2>
                <CardGrid>
                    @foreach (var branch in _branches)
                    {
                        <Card Href="@($"node/{branch.Link.To}")"
                              Title="@branch.Label"
                              Summary="@branch.Link.Prompt"
                              Cta="Continue →"
                              Level="3" />
                    }
                </CardGrid>
            </section>
        }
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ContentNode? _node;
    private bool _loading = true;
    private readonly List<ResolvedBranch> _branches = new();
    private IReadOnlyList<Crumb> _crumbs = Array.Empty<Crumb>();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _branches.Clear();

        _node = await Content.GetByIdAsync(Id);

        if (_node is not null)
        {
            foreach (var link in _node.Branches)
            {
                var target = await Content.GetByIdAsync(link.To);
                var label = link.Label ?? target?.Title ?? link.To;
                _branches.Add(new ResolvedBranch(link, label));
            }

            await BuildBreadcrumbAsync();
        }

        _loading = false;
    }

    private async Task BuildBreadcrumbAsync()
    {
        var trail = await Trail.VisitAsync(Id);

        // The trail includes the current node as its last element; the rest are ancestors.
        var crumbs = new List<Crumb>(trail.Count);
        for (var i = 0; i < trail.Count - 1; i++)
        {
            var ancestor = await Content.GetByIdAsync(trail[i]);
            crumbs.Add(new Crumb(trail[i], ancestor?.Title ?? trail[i]));
        }

        _crumbs = crumbs;
    }

    private sealed record ResolvedBranch(BranchLink Link, string Label);

    private sealed record Crumb(string Id, string Title);
}
