<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<!-- Developer-only tool: not shipped, not part of the app. Kept out of the solution build. -->
	<IsPackable>false</IsPackable>
	<!-- Opt out of the repo's Central Package Management so this standalone tool pins its own versions. -->
	<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
	<!-- Expose the internal parser helpers (e.g. SplitArticleSections) to the unit test project. -->
	<InternalsVisibleTo Include="Respondeo.UnitTests" />
  </ItemGroup>

</Project>
