<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFramework>net10.0-android</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>Respondeo.Maui</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<EnableDefaultCssItems>false</EnableDefaultCssItems>
	<InvariantGlobalization>true</InvariantGlobalization>
	<PublishTrimmed>false</PublishTrimmed>

	<ApplicationTitle>Respondeo</ApplicationTitle>
	<ApplicationId>faith.respondeo.app</ApplicationId>
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>
	<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
	  Release trimming disables reflection-based System.Text.Json by default and strips DTO members the content
	  loaders deserialize by reflection; keep both so data loads on device.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
	  <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<!--
	  Respondeo.UI fingerprints its css/js filenames for the Wasm host, which rewrites index.html at publish.
	  The native host has no such rewrite, so package the plain-named copies that wwwroot/index.html links.
	-->
	<ItemGroup>
	  <MauiAsset Include="..\Respondeo.UI\wwwroot\css\*.css;..\Respondeo.UI\wwwroot\js\*.js"
				 LogicalName="wwwroot\_content\Respondeo.UI\%(RecursiveDir)$([System.IO.Path]::GetFileName('%(Identity)').Replace('.css','').Replace('.js',''))"
				 Condition="false" />
	  <MauiAsset Include="..\Respondeo.UI\wwwroot\css\*.css" LogicalName="wwwroot\_content\Respondeo.UI\css\%(Filename)%(Extension)" />
	  <MauiAsset Include="..\Respondeo.UI\wwwroot\js\*.js" LogicalName="wwwroot\_content\Respondeo.UI\js\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.65" Color="#141414" />
	<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#111111" BaseSize="128,128" />
	<EmbeddedResource Include="appsettings.json" LogicalName="Respondeo.Maui.appsettings.json" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
	<PackageReference Include="Microsoft.Maui.Controls" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Respondeo.Bible\Respondeo.Bible.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Shared\Respondeo.Content.Shared.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
	<ProjectReference Include="..\Respondeo.Content\Respondeo.Content.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgicalCalendar\Respondeo.LiturgicalCalendar.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgyOfTheHours\Respondeo.LiturgyOfTheHours.csproj" />
	<ProjectReference Include="..\Respondeo.UI\Respondeo.UI.csproj" />
  </ItemGroup>

</Project>
