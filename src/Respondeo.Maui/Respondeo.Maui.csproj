<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFramework>net10.0-android</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>Respondeo.Maui</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<EnableDefaultCssItems>false</EnableDefaultCssItems>
	<InvariantGlobalization>true</InvariantGlobalization>

	<ApplicationTitle>Respondeo</ApplicationTitle>
	<ApplicationId>faith.respondeo.app</ApplicationId>
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>
	<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
	<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#111111" />
	<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#111111" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Respondeo.Bible\Respondeo.Bible.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Shared\Respondeo.Content.Shared.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
	<ProjectReference Include="..\Respondeo.Content\Respondeo.Content.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgicalCalendar\Respondeo.LiturgicalCalendar.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgyOfTheHours\Respondeo.LiturgyOfTheHours.csproj" />
	<ProjectReference Include="..\Respondeo.UI\Respondeo.UI.csproj" />
  </ItemGroup>

</Project>
