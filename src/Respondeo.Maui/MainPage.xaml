<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:respondeo="clr-namespace:Respondeo;assembly=Respondeo.UI"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="Respondeo.Maui.MainPage"
             SafeAreaEdges="Container"
             BackgroundColor="#FAF9F6">

    <Grid SafeAreaEdges="Container" BackgroundColor="#FAF9F6">
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="#FAF9F6"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type respondeo:App}" />
                <RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
