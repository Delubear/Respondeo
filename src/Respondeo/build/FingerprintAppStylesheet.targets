<Project>

  <!--
	Fingerprint the stylesheet links (css/*.css or _content/<Library>/css/*.css) in the published index.html.

	The Blazor WASM SDK rewrites <script src> fingerprint placeholders but does NOT rewrite
	<link rel="stylesheet"> hrefs in a standalone WASM app (verified on .NET 10), so we do it here.
	The StaticWebAssetFingerprintPattern items in Respondeo.UI.csproj make the SDK emit a content-hashed
	<dir>/<name>.<hash>.css file per stylesheet; this task rewrites index.html to point at them. Because that edit
	happens after the SDK built service-worker-assets.js (which records index.html's integrity
	hash), the task also re-syncs that manifest entry - otherwise the PWA service worker blocks
	index.html on install with "SRI's integrity checks failed".

	Tracking upstream: https://github.com/dotnet/aspnetcore/issues/64342#issuecomment-3527590792
	If the SDK gains <link> fingerprint-placeholder support, this whole file can be replaced by a
	css/<name>#[.{fingerprint}].css placeholder per link in index.html
  -->
  <Target Name="FingerprintAppStylesheet" AfterTargets="Publish">
	<FingerprintAppStylesheet
	  WwwrootPath="$(PublishDir)wwwroot" />
  </Target>

  <UsingTask TaskName="FingerprintAppStylesheet" TaskFactory="RoslynCodeTaskFactory"
			 AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
	<ParameterGroup>
	  <WwwrootPath ParameterType="System.String" Required="true" />
	</ParameterGroup>
	<Task>
	  <Code Type="Fragment" Language="cs"><![CDATA[
		var indexHtmlPath = System.IO.Path.Combine(WwwrootPath, "index.html");
		if (!System.IO.File.Exists(indexHtmlPath))
		{
			Log.LogWarning("FingerprintAppStylesheet: index.html not found; skipping.");
			return true;
		}

		// Rewrite each <dir>/<name>.css link (dir is css or _content/<Library>/css) to the SDK-emitted <dir>/<name>.<hash>.css.
		var html = System.IO.File.ReadAllText(indexHtmlPath);
		var updatedHtml = html;
		foreach (System.Text.RegularExpressions.Match link in System.Text.RegularExpressions.Regex.Matches(html, "href=\"((?:_content/[^\"/]+/)?css)/([^\"/.]+)\\.css\""))
		{
			var dir = link.Groups[1].Value;
			var name = link.Groups[2].Value;
			var cssDir = System.IO.Path.Combine(WwwrootPath, dir.Replace('/', System.IO.Path.DirectorySeparatorChar));
			var hashedCss = System.IO.Directory.Exists(cssDir) ? System.IO.Directory.GetFiles(cssDir, name + ".*.css") : new string[0];
			if (hashedCss.Length != 1)
			{
				Log.LogWarning("FingerprintAppStylesheet: expected exactly one " + dir + "/" + name + ".<hash>.css but found " + hashedCss.Length + "; link left unchanged.");
				continue;
			}
			var hashedName = System.IO.Path.GetFileName(hashedCss[0]);
			updatedHtml = updatedHtml.Replace(link.Value, "href=\"" + dir + "/" + hashedName + "\"");
			Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "FingerprintAppStylesheet: rewrote " + dir + "/" + name + ".css link to " + dir + "/" + hashedName + ".");
		}
		if (updatedHtml == html)
		{
			Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "FingerprintAppStylesheet: no stylesheet links rewritten in index.html; nothing to do.");
			return true;
		}
		System.IO.File.WriteAllText(indexHtmlPath, updatedHtml);

		// Re-sync index.html's integrity in the PWA service-worker manifest, if present.
		var manifestPath = System.IO.Path.Combine(WwwrootPath, "service-worker-assets.js");
		if (!System.IO.File.Exists(manifestPath))
		{
			return true;
		}

		string newHash;
		using (var sha = System.Security.Cryptography.SHA256.Create())
		{
			newHash = "sha256-" + System.Convert.ToBase64String(sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(updatedHtml)));
		}

		var manifest = System.IO.File.ReadAllText(manifestPath);
		var match = System.Text.RegularExpressions.Regex.Match(manifest, "\"hash\":\\s*\"(sha256-[^\"]+)\",\\s*\"url\":\\s*\"index\\.html\"");
		if (!match.Success)
		{
			Log.LogWarning("FingerprintAppStylesheet: index.html entry not found in service-worker-assets.js; the PWA may fail SRI checks on install.");
			return true;
		}

		var oldHash = match.Groups[1].Value;
		if (oldHash != newHash)
		{
			System.IO.File.WriteAllText(manifestPath, manifest.Replace(oldHash, newHash));
			Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "FingerprintAppStylesheet: updated index.html integrity in service-worker-assets.js to " + newHash + ".");
		}
	  ]]></Code>
	</Task>
  </UsingTask>

</Project>
