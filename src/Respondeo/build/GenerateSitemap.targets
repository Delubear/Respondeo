<Project>

  <!--
	Regenerate wwwroot/sitemap.xml from the content manifests.

	The sitemap must list the app's real, crawlable routes, and those routes derive from the Summa
	part slug mapping (SummaParts) plus the shipped content manifests. Rather than duplicate that
	logic in MSBuild, we invoke the build/Respondeo.SitemapGenerator tool, which references
	Respondeo.Content.Summa and parses the manifests to emit an accurate sitemap.

	Build ordering: we use the <MSBuild> task (an in-process build, NOT `dotnet run`) to build the
	generator and capture its output DLL, then exec that DLL. A nested `dotnet run` inside the outer
	build fails (MSB3073) because the child process inherits the outer build's MSBuild state; the
	in-process <MSBuild> task avoids that entirely and does not pollute the WASM app with a
	ProjectReference to an Exe.

	Opt-in only: this runs ONLY when GenerateSitemapOnBuild=true, which the deploy pipeline sets on
	its `dotnet publish` step. Regular local/dev builds do not regenerate the sitemap. The file is a
	generated CI artifact (NOT tracked in git — see .gitignore); it is written fresh into the
	published output at deploy time.

	It runs BeforeTargets="BeforeBuild" so the freshly written wwwroot/sitemap.xml is picked up as a
	static web asset and published to the site root. The generator no-ops (leaves the file untouched)
	when nothing changed.
  -->
  <PropertyGroup>
	<!-- Off by default; the deploy workflow passes -p:GenerateSitemapOnBuild=true on publish. -->
	<GenerateSitemapOnBuild Condition="'$(GenerateSitemapOnBuild)' == ''">false</GenerateSitemapOnBuild>
	<SitemapGeneratorProject>$(MSBuildThisFileDirectory)..\..\..\build\Respondeo.SitemapGenerator\Respondeo.SitemapGenerator.csproj</SitemapGeneratorProject>
	<SitemapGeneratorDll>$(MSBuildThisFileDirectory)..\..\..\build\Respondeo.SitemapGenerator\bin\$(Configuration)\net10.0\Respondeo.SitemapGenerator.dll</SitemapGeneratorDll>
	<SitemapOutputPath>$(MSBuildProjectDirectory)\wwwroot\sitemap.xml</SitemapOutputPath>
	<!-- No trailing slash: a trailing '\' immediately before the closing quote in the Exec command
		 would escape the quote and merge the arguments. -->
	<RepoRootPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</RepoRootPath>
  </PropertyGroup>

  <Target Name="GenerateSitemap"
		  BeforeTargets="BeforeBuild"
		  Condition="'$(GenerateSitemapOnBuild)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(BuildingForLiveUnitTesting)' != 'true'">
	<Message Importance="high" Text="Generating sitemap.xml from content manifests..." />

	<!-- In-process build of the generator (NOT `dotnet run`, which fails nested inside this build). -->
	<MSBuild Projects="$(SitemapGeneratorProject)"
			 Targets="Build"
			 Properties="Configuration=$(Configuration)" />

	<Exec Command="dotnet exec &quot;$(SitemapGeneratorDll)&quot; &quot;$(RepoRootPath)&quot; &quot;$(SitemapOutputPath)&quot;"
		  WorkingDirectory="$(RepoRootPath)" />
  </Target>

</Project>
