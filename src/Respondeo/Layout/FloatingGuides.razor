@* Floating orbs live in the layout (not in the pages) so each persists as a single element across navigation
   within its area and animates only on true first appearance. The liturgical orb is one instance
   spanning every Discover-area route; it merely slides when its Raised state changes. Which orbs
   show on which route is declared in FloatingGuideRoutes (the single source of truth). The layout
   resolves Guides on each render so the orbs never lag a page behind. *@
@if (Guides.ShowLiturgicalOrb || ForcedOrb == OrbLauncher.Liturgical)
{
    <LiturgicalOrb Raised="Guides.LiturgicalOrbRaised" HideTrigger="!Guides.ShowLiturgicalOrb" />
}
@if (Guides.ShowPrayerGuide || ForcedOrb == OrbLauncher.Prayers)
{
    <GuideToPrayers HideTrigger="!Guides.ShowPrayerGuide" />
}
@if (Guides.ShowSaintGlossary || ForcedOrb == OrbLauncher.Saints)
{
    <SaintGlossaryOrb HideTrigger="!Guides.ShowSaintGlossary" />
}
@if (Guides.ShowSummaGuide || ForcedOrb == OrbLauncher.Summa)
{
    <SummaGuide HideTrigger="!Guides.ShowSummaGuide" />
}

@code {
    // Which orbs the current route shows, resolved by the layout from FloatingGuideRoutes.
    [Parameter, EditorRequired] public FloatingGuideState Guides { get; set; } = default!;

    // An orb opened from a pinned quick-menu entry, shown even off its own routes.
    [Parameter] public string? ForcedOrb { get; set; }
}
