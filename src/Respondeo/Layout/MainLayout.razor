@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AccessibilityInterop Accessibility
@inject Respondeo.Services.FeatureFlags Features
@inject ISeasonalPortrait Portrait
@inject IDayWatcher DayWatcher
@inject IJSRuntime JS

<div class="page page--inner @(_mastheadExpanded ? "page--masthead-open" : null)">
    <a class="skip-link" href="#content">Skip to content</a>

    <ScrollAffordances />
    <QuickMenu />

    @* The masthead and pillar switcher form one drag zone on phones: drag down to open the full masthead, up to close. *@
    <div class="masthead-zone" @ref="_mastheadZone">
    <header class="masthead">
        <ThemeToggle />
        @if (Features.AquinasPortrait)
        {
            <img class="masthead__portrait" src="@Portrait.CurrentImagePath" alt="St. Thomas Aquinas, after Sandro Botticelli" width="144" height="144" loading="lazy" />
        }
        <a class="masthead__brand" href="">
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
            <span class="masthead__name">Respondeo</span>
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
        </a>
        <p class="masthead__tag">Real questions. Reasoned answers.</p>
        @* Phones drag the masthead itself (down to open, up to close); this button is the keyboard and
           screen-reader route to the same toggle and is only visible while focused. *@
        <button type="button" class="masthead__expand" @onclick="ToggleMasthead"
                aria-expanded="@(_mastheadExpanded ? "true" : "false")"
                aria-label="@(_mastheadExpanded ? "Show less of the header" : "Show the full header")">
            <span class="masthead__expand-glyph" aria-hidden="true">&#8964;</span>
        </button>
    </header>

    <PillarNav />
    </div>
    <JourneyNav />
    <DiscoverNav />

    <main class="content" id="content" tabindex="-1">
        <div class="content__inner">
            @Body
        </div>
    </main>

    <footer class="colophon">
        <p>
            Presented in the spirit of St. Thomas Aquinas.
            Curated for study, not a substitute for the Magisterium of the Catholic Church.
        </p>
        <p class="colophon__meta">
            <a href="thanks">Thanks &amp; sources</a>
            <span class="colophon__sep" aria-hidden="true">&middot;</span>
            <a href="https://github.com/Delubear/Respondeo" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
            <span class="colophon__sep" aria-hidden="true">&middot;</span>
            <Feedback LinkText="Report an issue or share feedback" />
        </p>
    </footer>

    <InstallPrompt />
    <OfflinePackPrompt />
    <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="quick-menu" />
</div>

@* Floating orbs live here (not in the pages) so each persists as a single element across navigation
   within its area and animates only on true first appearance. The liturgical orb is one instance
   spanning every Discover-area route; it merely slides when its Raised state changes. Which orbs
   show on which route is declared in FloatingGuideRoutes (the single source of truth). *@
@if (_guides.ShowLiturgicalOrb)
{
    <LiturgicalOrb Raised="_guides.LiturgicalOrbRaised" />
}
@if (_guides.ShowPrayerGuide)
{
    <GuideToPrayers />
}
@if (_guides.ShowSaintGlossary)
{
    <SaintGlossaryOrb />
}
@if (_guides.ShowSummaGuide)
{
    <SummaGuide />
}

@code {
    // Which floating orbs the current route shows. Orbs live here (not in the pages) so an orb that applies
    // to several routes persists as one element across in-area navigation and only animates on true first
    // appearance. The route-to-orb mapping is declared in FloatingGuideRoutes.
    private FloatingGuideState _guides = FloatingGuideRoutes.Resolve(string.Empty);

    // On phones the slim masthead can be dragged open to the full one; the choice persists across navigation.
    // The drag itself runs in js/masthead-drag.js (per-frame finger tracking is too chatty for interop) and
    // reports only the final state here.
    private bool _mastheadExpanded;
    private ElementReference _mastheadZone;
    private DotNetObjectReference<MainLayout>? _selfRef;

    private void ToggleMasthead() => _mastheadExpanded = !_mastheadExpanded;

    [JSInvokable]
    public void SetMastheadExpanded(bool expanded)
    {
        _mastheadExpanded = expanded;
        StateHasChanged();
    }

    // Cloudflare Web Analytics (loaded in index.html) auto-tracks SPA route changes via the History API, so no manual pageview call is needed here.
    // We still hook LocationChanged to announce the new page to assistive technology on every in-app navigation.
    protected override void OnInitialized()
    {
        UpdateGuides();
        Nav.LocationChanged += OnLocationChanged;
        DayWatcher.DayChanged += OnDayChanged;
    }

    // Start the day watcher once the renderer is live (JS interop is unavailable during OnInitialized).
    // It listens for the tab becoming visible again and re-checks the date, so a tab left open overnight
    // refreshes the moment the user returns to it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DayWatcher.StartAsync();
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("respondeoMasthead.attach", _mastheadZone, _selfRef);
        }
    }

    // The watched day rolled over while the tab sat open; re-render so the masthead's seasonal portrait
    // (which reads the date live) picks up the new day's image.
    private async void OnDayChanged() => await InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateGuides();
        StateHasChanged();
        await AnnounceAsync();
    }

    // Resolve which floating orbs the current route shows from the single source of truth.
    private void UpdateGuides()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        _guides = FloatingGuideRoutes.Resolve(path);
    }

    // FocusOnNavigate moves focus to the main content on navigation, but a SPA route change is otherwise silent to screen readers.
    // Post the new page title to a polite live region so assistive technology announces the destination page.
    private async Task AnnounceAsync()
    {
        try
        {
            await Accessibility.AnnounceAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit/runtime is going away (e.g. during teardown); nothing to announce.
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        DayWatcher.DayChanged -= OnDayChanged;
        _selfRef?.Dispose();
    }
}

