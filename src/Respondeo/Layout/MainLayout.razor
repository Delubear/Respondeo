@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AccessibilityInterop Accessibility
@inject Respondeo.Services.FeatureFlags Features
@inject Respondeo.LiturgicalCalendar.ILiturgicalCalendar Calendar
@inject Func<DateOnly> Today

<div class="page">
    <a class="skip-link" href="#content">Skip to content</a>

    <ScrollAffordances />

    <header class="masthead">
        <ThemeToggle />
        @if (Features.AquinasPortrait)
        {
            <img class="masthead__portrait" src="@PortraitSrc" alt="St. Thomas Aquinas, after Sandro Botticelli" width="144" height="144" loading="lazy" />
        }
        <a class="masthead__brand" href="">
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
            <span class="masthead__name">Respondeo</span>
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
        </a>
        <p class="masthead__tag">Real questions. Reasoned answers.</p>
    </header>

    <PillarNav />
    <MastheadNav />
    <DiscoverNav />

    <main class="content" id="content" tabindex="-1">
        <div class="content__inner">
            @Body
        </div>
    </main>

    <footer class="colophon">
        <p>
            Presented in the spirit of St. Thomas Aquinas.
            Curated for study, not a substitute for the Magisterium of the Catholic Church.
        </p>
        <p class="colophon__meta">
            <a href="thanks">Thanks &amp; sources</a>
            <span class="colophon__sep" aria-hidden="true">&middot;</span>
            <a href="https://github.com/Delubear/Respondeo" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
            <span class="colophon__sep" aria-hidden="true">&middot;</span>
            <Feedback LinkText="Report an issue or share feedback" />
        </p>
    </footer>

    <InstallPrompt />
</div>

@code {
    // During Christmas Time, Aquinas dons a festive hat; the rest of the year he keeps his usual portrait.
    private string PortraitSrc =>
        Calendar.ForDate(Today()).Season == Respondeo.LiturgicalCalendar.LiturgicalSeason.Christmas
            ? "images/aquinas-christmas.jpg"
            : "images/aquinas.jpg";

    // Cloudflare Web Analytics (loaded in index.html) auto-tracks SPA route changes via the History API, so no manual pageview call is needed here.
    // We still hook LocationChanged to announce the new page to assistive technology on every in-app navigation.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await AnnounceAsync();
    }

    // FocusOnNavigate moves focus to the main content on navigation, but a SPA route change is otherwise silent to screen readers.
    // Post the new page title to a polite live region so assistive technology announces the destination page.
    private async Task AnnounceAsync()
    {
        try
        {
            await Accessibility.AnnounceAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit/runtime is going away (e.g. during teardown); nothing to announce.
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

