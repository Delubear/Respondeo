@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <a class="skip-link" href="#content">Skip to content</a>

    <ScrollAffordances />

    <header class="masthead">
        <ThemeToggle />
        <a class="masthead__brand" href="">
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
            <span class="masthead__name">Respondeo</span>
            <span class="masthead__mark" aria-hidden="true">&#10013;</span>
        </a>
        <p class="masthead__tag">Real questions. Reasoned answers.</p>
    </header>

    <MastheadNav />

    <main class="content" id="content" tabindex="-1">
        <div class="content__inner">
            @Body
        </div>
    </main>

    <footer class="colophon">
        <p>
            Presented in the spirit of St. Thomas Aquinas.
            Content is curated for study, not a substitute for the Magisterium of the Catholic Church.
        </p>
    </footer>
</div>

@code {
    // Cloudflare Web Analytics (loaded in index.html) auto-tracks SPA route changes via the History
    // API, so no manual pageview call is needed here. We still hook LocationChanged to announce the
    // new page to assistive technology on every in-app navigation.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await AnnounceAsync();
    }

    // FocusOnNavigate moves focus to the main content on navigation, but a SPA route change is
    // otherwise silent to screen readers. Post the new page title to a polite live region so
    // assistive technology announces the destination page.
    private async Task AnnounceAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("respondeoA11y.announce");
        }
        catch (JSDisconnectedException)
        {
            // The circuit/runtime is going away (e.g. during teardown); nothing to announce.
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

