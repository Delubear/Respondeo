@* A small floating "today in the Church" orb shown only on the Discover root pages.
    It matches the shared floating-circle family (back-to-top, prayer guide, Summa guide): a bottom-right circle that slides up to stack above the back-to-top arrow.
    It is visually identical to the other circles and differs only by its calendar icon.
    Tapping it opens a Dialog with today's season, color, celebration, the saint of the day, and a short explanation of the liturgical year. *@

@inject ILiturgicalCalendar Calendar
@inject ISaintService Saints
@inject Func<DateOnly> Today
@inject IDayWatcher DayWatcher
@inject ICalendarPreference Preference
@implements IDisposable

<FloatingGuide OrbKey="@OrbLauncher.Liturgical" HideTrigger="HideTrigger" Title="Today in the Church" Eyebrow="Where we are in the liturgical year"
               AriaLabel="@($"Today in the Church: {_view.SeasonName}")" Tooltip="Today in the Church"
               DialogClass="dialog--liturgy" Raised="Raised" OnOpening="SyncToToday">
    <Icon>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg">
            <path d="M3 9H21M7 3V5M17 3V5M8 15H10M14 15H16M6.2 21H17.8C18.9201 21 19.4802 21 19.908 20.782C20.2843 20.5903 20.5903 20.2843 20.782 19.908C21 19.4802 21 18.9201 21 17.8V8.2C21 7.07989 21 6.51984 20.782 6.09202C20.5903 5.71569 20.2843 5.40973 19.908 5.21799C19.4802 5 18.9201 5 17.8 5H6.2C5.0799 5 4.51984 5 4.09202 5.21799C3.71569 5.40973 3.40973 5.71569 3.21799 6.09202C3 6.51984 3 7.07989 3 8.2V17.8C3 18.9201 3 19.4802 3.21799 19.908C3.40973 20.2843 3.71569 20.5903 4.09202 20.782C4.51984 21 5.07989 21 6.2 21Z"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </Icon>
    <ChildContent>
        <div class="liturgy">
            <div class="liturgy__status">
                <div class="liturgy__today">
                    <span class="liturgy__swatch liturgy__swatch--@_view.ColorClass" aria-hidden="true"></span>
                    <div class="liturgy__headline">
                        <p class="liturgy__season">@_view.SeasonName</p>
                        <p class="liturgy__ferial">@_view.DayLabel</p>
                        <p class="liturgy__color">Liturgical color: @_view.ColorName</p>
                        @if (_view.ColorClue is { } clue)
                        {
                            <p class="liturgy__color-clue">@clue</p>
                        }
                    </div>
                </div>

                @if (_view.Celebration is { } celebration)
                {
                    var profile = celebration.Id is not null ? _profiles.GetValueOrDefault(celebration.Id) : null;
                    <div class="liturgy__celebrations">
                        <p class="liturgy__saint-intro">@_view.CelebrationIntro</p>
                        <div class="liturgy__carousel">
                            @if (_view.CanCycle)
                            {
                                <button type="button" class="liturgy__cycle-btn" aria-label="Previous optional memorial" @onclick="_view.Previous">&lsaquo;</button>
                            }
                            <SaintHighlightCard Name="@celebration.Name" Slug="@celebration.Id" Note="@(_view.IsOptionalMemorial ? "Optional memorial" : null)" Dates="@profile?.Dates"
                                                Summary="@(profile?.Summary ?? celebration.Summary)" OnNavigate="context.CloseAsync">
                                <Detail>
                                    @if (_view.OptionalMemorialColor is { } memorialColor)
                                    {
                                        <span class="liturgy__memorial-color">
                                            <span class="liturgy__swatch liturgy__swatch--@memorialColor.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                            @memorialColor if kept
                                        </span>
                                    }
                                </Detail>
                            </SaintHighlightCard>
                            @if (_view.CanCycle)
                            {
                                <button type="button" class="liturgy__cycle-btn" aria-label="Next optional memorial" @onclick="_view.Next">&rsaquo;</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <hr class="liturgy__rule" />

            <GuideSection Title="Colors and their meaning">
            <p>
                The Church keeps time differently from the calendar on the wall. Her year turns through
                seasons &mdash; each with its own color, mood, and mysteries to pray.
            </p>
            <ul class="liturgy__seasons">
                <li>
                    <span class="liturgy__swatch liturgy__swatch--violet" aria-hidden="true"></span>
                    <div class="liturgy__season-text">
                        <span class="liturgy__season-name">Advent &amp; Lent</span>
                        Violet &mdash; seasons of preparation and penance (rose on Gaudete and Laetare Sundays).
                    </div>
                </li>
                <li>
                    <span class="liturgy__swatch liturgy__swatch--white" aria-hidden="true"></span>
                    <div class="liturgy__season-text">
                        <span class="liturgy__season-name">Christmas &amp; Easter</span>
                        White &mdash; the great seasons of joy and light.
                    </div>
                </li>
                <li>
                    <span class="liturgy__swatch liturgy__swatch--red" aria-hidden="true"></span>
                    <div class="liturgy__season-text">
                        <span class="liturgy__season-name">Feasts of the Lord's Passion &amp; the Martyrs</span>
                        Red &mdash; Palm Sunday, Good Friday, Pentecost, and the witness of the martyrs.
                    </div>
                </li>
                <li>
                    <span class="liturgy__swatch liturgy__swatch--green" aria-hidden="true"></span>
                    <div class="liturgy__season-text">
                        <span class="liturgy__season-name">Ordinary Time</span>
                        Green &mdash; the weeks of growth outside the festal seasons.
                    </div>
                </li>
            </ul>
            </GuideSection>

            <GuideSection Title="Degrees of celebration">
            <p>
                Not every day carries the same weight. The Church ranks her celebrations, and the higher
                the rank, the more fully the day's prayers and readings give way to it.
            </p>
            <GuideList>
                <GuideItem Term="Solemnity">The highest rank &mdash; the greatest mysteries and saints (Easter, Christmas,
                    Pentecost, the Immaculate Conception). A solemnity begins the evening before and,
                    like a Sunday, outranks almost everything else.</GuideItem>
                <GuideItem Term="Feast">A major celebration kept on its own day but without the evening-before beginning (the Transfiguration, the Apostles, the Baptism of the Lord).</GuideItem>
                <GuideItem Term="Memorial">A remembrance of a saint, woven into the ordinary prayers of the day rather than replacing them. Some are obligatory; many are optional.</GuideItem>
                <GuideItem Term="Feria">An ordinary weekday with no assigned celebration, taking the color and prayers of its season.</GuideItem>
            </GuideList>
            </GuideSection>

            <p class="liturgy__disclaimer">
                @DisclaimerLead Your own country, diocese, or religious community may keep additional
                feasts or observe some days differently, so the celebration near you can vary. For what
                is kept locally, always defer to your diocese or parish.
            </p>
        </div>
    </ChildContent>
    <Footer>
        <div class="liturgy-foot">
            <details class="liturgy-menu">
                <summary class="liturgy-menu__toggle">
                    <span class="visually-hidden">Calendar: </span>@CalendarName
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="liturgy-menu__panel">
                    <fieldset class="liturgy-menu__group">
                        <legend>Calendar</legend>
                        <label><input type="radio" name="liturgy-region" checked="@(!IsUs)" @onchange="() => SetCalendarAsync(LiturgicalCalendarOptions.Default)" /> General Roman</label>
                        <label><input type="radio" name="liturgy-region" checked="@IsUs" @onchange="() => SetCalendarAsync(new(CalendarRegion.UnitedStates))" /> United States (USCCB)</label>
                    </fieldset>
                    @if (IsUs)
                    {
                        <label class="liturgy-menu__check">
                            <input type="checkbox" checked="@Preference.Options.AscensionOnThursday"
                                   @onchange="e => SetCalendarAsync(new(CalendarRegion.UnitedStates, AscensionOnThursday: e.Value is true))" />
                            Keep the Ascension on Thursday
                        </label>
                    }
                </div>
            </details>
            <button type="button" class="btn" @onclick="context.CloseAsync">Close</button>
        </div>
    </Footer>
</FloatingGuide>

@code {
    private TodayInTheChurch _view = default!;
    private DateOnly _loadedFor;

    // Full saint profiles for the day's linked celebrations, keyed by slug, so the card can show dates and summary.
    private readonly Dictionary<string, SaintRecord> _profiles = new(StringComparer.Ordinal);

    // The in-flight (or finished) profile load for the current day. The first load reads the whole saint catalog,
    // so opening waits on it; otherwise the top card renders bare and then grows when the dates and summary arrive.
    private Task _profilesLoad = Task.CompletedTask;

    /// <summary>
    /// When true, the orb sits one slot higher than normal so it clears another floating control that already occupies the base slot (e.g. the Prayer Guide button on the prayers page).
    /// </summary>
    [Parameter] public bool Raised { get; set; }

    [Parameter] public bool HideTrigger { get; set; }

    private bool IsUs => Preference.Options.Region == CalendarRegion.UnitedStates;

    private string CalendarName => IsUs ? "United States (USCCB)" : "General Roman Calendar";

    private string DisclaimerLead => IsUs
        ? "This follows the proper calendar of the United States (USCCB), with the Ascension kept on "
            + (Preference.Options.AscensionOnThursday ? "Thursday." : "Sunday.")
        : "This follows the General Roman Calendar, the Church's universal calendar for the Ordinary Form.";

    private Task SetCalendarAsync(LiturgicalCalendarOptions options) => Preference.SetAsync(options);

    private async void OnCalendarChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDayAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        DayWatcher.DayChanged += OnDayChanged;
        Preference.Changed += OnCalendarChanged;
        // Build the view before awaiting the stored preference: that await yields to a first render that reads _view.
        // If the stored calendar differs from the default, Changed reloads the day.
        var load = LoadDayAsync();
        await Preference.InitializeAsync();
        await load;
    }

    // Resolves today's day and starts loading its saint profiles. The view is set synchronously, so it is current
    // in the same render that opens the dialog; callers await the returned profile load.
    private Task LoadDayAsync()
    {
        _loadedFor = Today();
        _view = TodayInTheChurch.For(Calendar.ForDate(_loadedFor));
        _profilesLoad = LoadProfilesAsync(_view.LinkedSlugs().ToList());
        return _profilesLoad;
    }

    private async Task LoadProfilesAsync(IReadOnlyList<string> slugs)
    {
        _profiles.Clear();
        foreach (var id in slugs)
        {
            if (await Saints.GetByIdAsync(id) is { } record)
            {
                _profiles[id] = record;
            }
        }
    }

    // The watched day rolled over (e.g. the tab sat open past midnight); rebuild on the renderer thread so the orb
    // and its dialog reflect the new date without a reload.
    private async void OnDayChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDayAsync();
            StateHasChanged();
        });
    }

    // The day watcher only re-checks the date when the tab regains focus, which may not have happened yet when the
    // orb is tapped. Bring the day up to date before the dialog opens, and open only once its profiles have loaded.
    private Task SyncToToday() => Today() != _loadedFor ? LoadDayAsync() : _profilesLoad;

    public void Dispose()
    {
        DayWatcher.DayChanged -= OnDayChanged;
        Preference.Changed -= OnCalendarChanged;
    }
}

