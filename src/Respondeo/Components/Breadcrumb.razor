@* Presentational breadcrumb of the visitor's navigation trail. Pure UI: it renders the already-resolved crumbs and the current node title. Trail building stays with the caller. *@

<nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
        @if (StageHref is not null)
        {
            <li class="breadcrumb__item">
                <a href="@StageHref">@StageLabel</a>
            </li>
        }
        else
        {
            <li class="breadcrumb__item">
                <a href="">Home</a>
            </li>
        }
        @if (ShowArticles)
        {
            <li class="breadcrumb__item">
                <span class="breadcrumb__sep" aria-hidden="true">/</span>
                <a class="breadcrumb__articles" href="articles">Articles</a>
            </li>
        }
        @if (BackHref is not null)
        {
            <li class="breadcrumb__item">
                <span class="breadcrumb__sep" aria-hidden="true">/</span>
                <a class="breadcrumb__link breadcrumb__back" href="@BackHref" title="@BackLabel">@BackLabel</a>
            </li>
        }
        @foreach (var crumb in Crumbs)
        {
            <li class="breadcrumb__item">
                <span class="breadcrumb__sep" aria-hidden="true">/</span>
                <a class="breadcrumb__link" href="@ContentRoutes.NodeHref(crumb.Id, crumb.Stage)" title="@crumb.Title">@crumb.Title</a>
            </li>
        }
        <li class="breadcrumb__item">
            <span class="breadcrumb__sep" aria-hidden="true">/</span>
            <span class="breadcrumb__current" aria-current="page" title="@CurrentTitle">@(CurrentTitle ?? "…")</span>
        </li>
    </ol>
</nav>

@code {
    /// <summary>The ancestor crumbs leading up to (but excluding) the current node.</summary>
    [Parameter] public IReadOnlyList<Crumb> Crumbs { get; set; } = Array.Empty<Crumb>();

    /// <summary>Title of the node currently being viewed, shown as the final, non-linked crumb.</summary>
    [Parameter] public string? CurrentTitle { get; set; }

    /// <summary>When true, renders an Articles link after Home (the visitor arrived via the /articles index).</summary>
    [Parameter] public bool ShowArticles { get; set; }

    /// <summary>Optional stage landing route (e.g. "why-god"); when set it replaces Home as the breadcrumb root.</summary>
    [Parameter] public string? StageHref { get; set; }

    /// <summary>Label for the stage root crumb (e.g. "Why God?").</summary>
    [Parameter] public string? StageLabel { get; set; }

    /// <summary>
    /// Optional raw href for a "back" crumb inserted after the stage root. Used by Summa question
    /// pages to link back to the article a cross-reference jump started from.
    /// </summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>Label for the back crumb (e.g. "Q. 2, A. 3").</summary>
    [Parameter] public string? BackLabel { get; set; }

    /// <summary>A single ancestor step in the breadcrumb trail.</summary>
    public sealed record Crumb(string Id, string Title, string? Stage = null);
}
