@* Presentational breadcrumb of the visitor's navigation trail. Pure UI: it renders the already-resolved crumbs and the current node title. Trail building stays with the caller. *@
@inject IJSRuntime JS
@implements IAsyncDisposable

<nav class="breadcrumb" aria-label="Breadcrumb" @ref="_root">
    <button type="button" class="breadcrumb__chevron breadcrumb__chevron--prev" aria-label="Scroll breadcrumb left" tabindex="-1" @onclick="ScrollLeftAsync">
        <span aria-hidden="true">&lsaquo;</span>
    </button>
    <ol class="breadcrumb__list">
        @if (StageHref is not null)
        {
            <li class="breadcrumb__item">
                <a href="@StageHref">@StageLabel</a>
            </li>
        }
        else
        {
            <li class="breadcrumb__item">
                <a href="">Home</a>
            </li>
        }
        @if (BackHref is not null)
        {
            <li class="breadcrumb__item">
                <span class="breadcrumb__sep" aria-hidden="true">/</span>
                <a class="breadcrumb__link breadcrumb__back" href="@BackHref" title="@BackLabel">@BackLabel</a>
            </li>
        }
        @foreach (var crumb in Crumbs)
        {
            <li class="breadcrumb__item">
                <span class="breadcrumb__sep" aria-hidden="true">/</span>
                @if (crumb.Plain)
                {
                    <span class="breadcrumb__link breadcrumb__link--plain" title="@crumb.Title">@crumb.Title</span>
                }
                else
                {
                    <a class="breadcrumb__link" href="@CrumbHref(crumb)" title="@crumb.Title">@crumb.Title</a>
                }
            </li>
        }
        <li class="breadcrumb__item">
            <span class="breadcrumb__sep" aria-hidden="true">/</span>
            <span class="breadcrumb__current" aria-current="page" title="@CurrentTitle">@(CurrentTitle ?? "…")</span>
        </li>
    </ol>
    <button type="button" class="breadcrumb__chevron breadcrumb__chevron--next" aria-label="Scroll breadcrumb right" tabindex="-1" @onclick="ScrollRightAsync">
        <span aria-hidden="true">&rsaquo;</span>
    </button>
</nav>

@code {
    /// <summary>The ancestor crumbs leading up to (but excluding) the current node.</summary>
    [Parameter] public IReadOnlyList<Crumb> Crumbs { get; set; } = Array.Empty<Crumb>();

    /// <summary>Title of the node currently being viewed, shown as the final, non-linked crumb.</summary>
    [Parameter] public string? CurrentTitle { get; set; }

    /// <summary>Optional stage landing route (e.g. "why-god"); when set it replaces Home as the breadcrumb root.</summary>
    [Parameter] public string? StageHref { get; set; }

    /// <summary>Label for the stage root crumb (e.g. "Why God?").</summary>
    [Parameter] public string? StageLabel { get; set; }

    /// <summary>
    /// Optional raw href for a "back" crumb inserted after the stage root. Used by Summa question
    /// pages to link back to the article a cross-reference jump started from.
    /// </summary>
    [Parameter] public string? BackHref { get; set; }

    /// <summary>Label for the back crumb (e.g. "Q. 2, A. 3").</summary>
    [Parameter] public string? BackLabel { get; set; }

    /// <summary>
    /// A single ancestor step in the breadcrumb trail. When <see cref="Href"/> is null the crumb links to a Markdown node route built from <see cref="Id"/>/<see cref="Stage"/>;
    // when set it links directly to that explicit href.
    // When <see cref="Plain"/> is true the crumb renders as non-linked text (e.g. a Summa part, which has no landing page).
    /// </summary>
    public sealed record Crumb(string Id, string Title, string? Stage = null, string? Href = null, bool Plain = false);

    private static string CrumbHref(Crumb crumb) => crumb.Href ?? ContentRoutes.NodeHref(crumb.Id, crumb.Stage);

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string? _lastTrailSignature;

    // Identity of the rendered trail. We only want to re-anchor the scroll (jump back to the current crumb)
    // when the trail itself actually changes — i.e. the visitor navigated to a new node.
    // Re-rendering for any other reason (such as a chevron click, which is a normal component event) must NOT re-anchor, or the user's manual scroll gets snapped away.
    private string TrailSignature => string.Join('>', Crumbs.Select(c => c.Id)) + "#" + (CurrentTitle ?? string.Empty);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Keep the trail on one scrollable line: land on the current (right-most) crumb and show the edge chevrons whenever, and whichever way, it can scroll.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/breadcrumb.js");
            _lastTrailSignature = TrailSignature;
            await _module.InvokeVoidAsync("init", _root);
        }
        else if (_module is not null)
        {
            // Only re-anchor when the crumbs genuinely changed (navigated to a new node).
            // Skip re-renders triggered by chevron clicks or other UI events so manual scrolling sticks.
            var signature = TrailSignature;
            if (signature != _lastTrailSignature)
            {
                _lastTrailSignature = signature;
                await _module.InvokeVoidAsync("refresh", _root);
            }
        }
    }

    private async Task ScrollLeftAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("step", _root, -1);
        }
    }

    private async Task ScrollRightAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("step", _root, 1);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone during teardown; nothing to clean up.
            }
        }
    }
}
