@* The praying thread: an ordered list of steps (section banners, mystery headings and prayer rows)
   with per-bead markers. The parent owns the session and completion rules; this component is purely
   presentational and raises callbacks for the three interactions. The current prayer row keeps the
   id "devotion-current-step" so the parent's focus/scroll interop continues to target it. *@

<ol class="devotion__list">
    @for (var i = 0; i < Session.Beads.Count; i++)
    {
        var step = Session.Beads[i];
        var itemDone = Session.IsItemDone(i);
        var itemCurrent = step.IsPrayer && step.PrayerOrdinal == Session.CompletedCount;
        <li class="devotion__step @(itemDone ? "is-done" : null) @(itemCurrent ? "is-current" : null)">
            <span class="devotion__marker devotion__marker--@(step.BeadType ?? "none")" aria-hidden="true">
                @if (step.BeadType == "cross")
                {
                    <svg class="devotion__cross" viewBox="0 0 24 24">
                        <path d="M10.5 2h3v5h5v3h-5v12h-3V10h-5V7h5z" />
                    </svg>
                }
                else if (step.BeadType == "medal")
                {
                    <svg class="devotion__medal" viewBox="0 0 24 24">
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zm-.9 2.6v2.4H8.7v1.8h2.4v4.6h1.8v-4.6h2.4V9.5h-2.4V7.1z" />
                    </svg>
                }
                else if (step.BeadType == "between")
                {
                    <span class="devotion__pip"></span>
                    <span class="devotion__pip"></span>
                    <span class="devotion__pip"></span>
                }
            </span>

            <div class="devotion__step-body">
                @if (step.IsSection)
                {
                    <div class="devotion__section">
                        <h2 class="devotion__section-title">@step.Heading</h2>
                        @if (!string.IsNullOrWhiteSpace(step.ExplanationHtml))
                        {
                            <button type="button"
                                    class="devotion__section-info"
                                    @onclick="() => OnOpenInfo.InvokeAsync(step)"
                                    aria-label="@($"About {step.Heading}")"
                                    title="About this part">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM11 11h2v6h-2z" />
                                </svg>
                            </button>
                        }
                    </div>
                }
                else if (step.MysteryTitle is not null)
                {
                    <div class="devotion__mystery">
                        @if (!string.IsNullOrWhiteSpace(step.Heading))
                        {
                            <p class="eyebrow">@step.Heading</p>
                        }
                        <h2 class="devotion__mystery-title">@step.MysteryTitle</h2>
                        @if (!string.IsNullOrWhiteSpace(step.MysteryReflectionHtml))
                        {
                            <div class="devotion__reflection">
                                @((MarkupString)step.MysteryReflectionHtml)
                            </div>
                        }
                    </div>
                }
                else if (step.IsPrayer)
                {
                    var done = step.PrayerOrdinal < Session.CompletedCount;
                    var current = step.PrayerOrdinal == Session.CompletedCount;
                    var clickable = current || step.PrayerOrdinal == Session.CompletedCount - 1;
                    <div class="devotion__prayer-row @(done ? "is-done" : null) @(current ? "is-current" : null) @(!done && !current ? "is-upcoming" : null)">
                        <button type="button"
                                id="@(current ? "devotion-current-step" : null)"
                                class="devotion__prayer-main"
                                @onclick="() => OnToggle.InvokeAsync(step.PrayerOrdinal)"
                                disabled="@(!clickable)"
                                aria-current="@(current ? "step" : null)"
                                aria-label="@Session.PrayerStepLabel(step, done, current, PrayerName(step), PrayerNote(step))"
                                aria-pressed="@done">
                            <span class="devotion__prayer-name">
                                @if (!string.IsNullOrWhiteSpace(step.Role))
                                {
                                    <span class="devotion__role devotion__role--@step.Role" aria-hidden="true">@RoleLabel(step.Role)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(step.Heading) && step.Heading != step.PrayerTitle)
                                {
                                    <span class="devotion__prayer-lead">@step.Heading</span>
                                }
                                @PrayerName(step)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(PrayerNote(step)))
                            {
                                <span class="devotion__prayer-note">@PrayerNote(step)</span>
                            }
                        </button>
                        <button type="button"
                                class="devotion__prayer-book"
                                @onclick="() => OnOpenPrayer.InvokeAsync(step)"
                                aria-label="@($"Read the words of {PrayerName(step)}")"
                                title="Read the text">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 6.5C10.6 5.4 8.6 4.75 6.25 4.75c-1 0-1.95.12-2.75.32v12.6c.8-.2 1.75-.32 2.75-.32 2.35 0 4.35.65 5.75 1.75 1.4-1.1 3.4-1.75 5.75-1.75 1 0 1.95.12 2.75.32V5.07c-.8-.2-1.75-.32-2.75-.32C15.4 4.75 13.4 5.4 12 6.5zm0 0v11.5" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </li>
    }
</ol>

@code {
    /// <summary>The live praying session owning the thread and completion state.</summary>
    [Parameter, EditorRequired] public DevotionSession Session { get; set; } = default!;

    /// <summary>Whether prayer names/notes should render in Latin.</summary>
    [Parameter] public bool ShowLatin { get; set; }

    /// <summary>Raised with a prayer's ordinal when its completion is toggled.</summary>
    [Parameter] public EventCallback<int> OnToggle { get; set; }

    /// <summary>Raised when the reader opens a prayer's words.</summary>
    [Parameter] public EventCallback<DevotionBead> OnOpenPrayer { get; set; }

    /// <summary>Raised when the reader opens a section banner's explanation.</summary>
    [Parameter] public EventCallback<DevotionBead> OnOpenInfo { get; set; }

    // The prayer's name in the active language: the Latin name when the Latin view is on and one
    // exists, otherwise the vernacular title.
    private string? PrayerName(DevotionBead step) =>
        ShowLatin && !string.IsNullOrWhiteSpace(step.PrayerLatinTitle) ? step.PrayerLatinTitle : step.PrayerTitle;

    // The step's rubric in the active language: the Latin note when the Latin view is on and one
    // exists, otherwise the vernacular note.
    private string? PrayerNote(DevotionBead step) =>
        ShowLatin && !string.IsNullOrWhiteSpace(step.NoteLatin) ? step.NoteLatin : step.Note;

    // A short "who says this" badge for liturgical steps: the versicle/response marks for priest and
    // people, or a readable word for the rest.
    private static string RoleLabel(string? role) => role switch
    {
        "priest" => "\u2123",   // ℣ — versicle
        "people" => "\u211F",   // ℟ — response
        "all" => "All",
        "reader" => "Reader",
        _ => string.Empty,
    };
}
