@* Renders a content node's article body: title, summary, body HTML, optional
   sections accordion, and branch cards. Shared by the Node page and the stage
   landing pages so they present identical styling. *@
@inject IContentService Content
@inject IInquiryFlow Flow
@inject IVisitedNodes Visited
@inject IJSRuntime JS
@implements IAsyncDisposable

<article class="node" @key="Node.Id">
    <header class="pillar__header">
        <h1 class="pillar__title">@Node.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Node.Summary))
        {
            <p class="pillar__lede">@Node.Summary</p>
        }
    </header>

    <div class="content-body" @ref="_body">
        @((MarkupString)Node.BodyHtml)
    </div>

    @if (Node.Sections.Count > 0)
    {
        <SectionAccordion NodeId="@Node.Id" SectionIds="Node.Sections" />
    }

    @if (_branches.Count > 0)
    {
        <section class="branches">
            <h2 class="branches__heading">@(_branches.Count == 1 ? "Where to go next" : "Where would you like to go next?")</h2>
            <CardGrid>
                @foreach (var branch in _branches)
                {
                    <Card Href="@branch.Href"
                          Title="@branch.Label"
                          Summary="@branch.Link.Prompt"
                          Cta="Continue →"
                          Visited="@_visited.Contains(branch.Link.To)"
                          Level="3" />
                }
            </CardGrid>
        </section>
    }

    @if (_nextStage is not null)
    {
        <section class="next-stage">
            <p class="next-stage__eyebrow"><span>The Next Stage</span></p>
            <div class="next-stage__plate">
                <StageCard Href="@_nextStage.Href"
                           Icon="@_nextStage.Icon"
                           Label="@_nextStage.Label"
                           Prompt="@_nextStage.Prompt" />
            </div>
        </section>
    }
</article>

@code {
    [Parameter, EditorRequired] public InquiryNode Node { get; set; } = default!;

    private readonly List<ResolvedBranch> _branches = new();
    private StageLink? _nextStage;
    private IReadOnlySet<string> _visited = new HashSet<string>();
    private ElementReference _body;
    private IJSObjectReference? _tableModule;

    protected override async Task OnParametersSetAsync()
    {
        var branches = new List<ResolvedBranch>();
        foreach (var link in await Flow.GetBranchesAsync(Node.Id))
        {
            var target = await Content.GetByIdAsync(link.To);
            var label = link.Label ?? target?.Title ?? link.To;
            var href = ContentRoutes.NodeHref(link.To, target?.Stage);
            branches.Add(new ResolvedBranch(link, label, href));
        }

        _branches.Clear();
        _branches.AddRange(branches);

        _nextStage = await Flow.GetTransitionForNodeAsync(Node.Id, Node.Stage);

        _visited = await Visited.GetVisitedAsync();
    }

    // The body HTML is injected as a MarkupString, so any tables only exist in the DOM after render.
    // We give each one a transposed companion for the mobile layout; the module skips tables it has
    // already processed, so running on every render is safe and cheap.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _tableModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/table-mobile.js");
            await _tableModule.InvokeVoidAsync("enhance", _body);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_tableModule is not null)
        {
            try
            {
                await _tableModule.InvokeVoidAsync("dispose", _body);
                await _tableModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ResolvedBranch(BranchLink Link, string Label, string Href);
}
