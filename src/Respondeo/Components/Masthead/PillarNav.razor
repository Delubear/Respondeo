@* Top-tier "pillar switcher": the site's areas (Journey, Summa, Discover Catholicism).
   Sits above the per-pillar navigation (e.g. the journey stages, or the Discover sub-tabs).
   The active pillar is derived from the current route so it stays highlighted while browsing within a pillar. *@
@implements IDisposable
@inject NavigationManager Nav
@inject NavigationIntent NavIntent
@inject IBreadcrumbTrail Trail
@inject Respondeo.Services.FeatureFlags Features

<nav class="pillarnav" aria-label="Site areas">
    <ul class="pillarnav__list">
        @foreach (var pillar in SitePillars.Items.Where(IsEnabled))
        {
            var isActive = pillar.Id == _activeId;
            @if (pillar.Id == SitePillars.DiscoverId)
            {
                <li class="pillarnav__item pillarnav__item--menu">
                    <button type="button"
                            class="pillarnav__link pillarnav__toggle @(isActive ? "pillarnav__link--active" : "")"
                            aria-haspopup="true"
                            aria-expanded="@(_menuOpen ? "true" : "false")"
                            aria-controls="pillarnav-discover-menu"
                            data-short="@pillar.ShortLabelOrFull"
                            @onclick="ToggleMenu"
                            @onkeydown="OnMenuKey">
                        @pillar.Label
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="pillarnav__backdrop" @onclick="CloseMenu"></div>
                        <ul id="pillarnav-discover-menu" class="pillarnav__menu" @onkeydown="OnMenuKey">
                            @foreach (var tab in DiscoverNavigation.Items.Where(t => t.IsEnabled(Features)))
                            {
                                <li>
                                    <a class="pillarnav__menu-link" href="@tab.Href" @onclick="SelectMenuItem">
                                        @(tab.Exact ? "All of Discover" : tab.Label)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
            else
            {
                <li class="pillarnav__item">
                    <a class="pillarnav__link @(isActive ? "pillarnav__link--active" : "")"
                       href="@pillar.Href"
                       aria-current="@(isActive ? "page" : null)"
                       data-short="@pillar.ShortLabelOrFull"
                       @onclick="MarkTopLevel">
                        @pillar.Label
                    </a>
                </li>
            }
        }
    </ul>
</nav>

@code {
    private string _activeId = SitePillars.JourneyId;

    // The Journey pillar is the site's spine and always shown; the Summa pill and the merged Discover Catholicism pill are each gated behind deploy-time feature flags.
    // Discover is gated by its master DiscoverPillar switch and shows only when at least one of its sub-area features is also enabled,
    // so the pillar hides when the master switch is off or every sub-area is turned off.
    private bool IsEnabled(SitePillars.Pillar pillar) => pillar.Id switch
    {
        SitePillars.SummaId => Features.SummaPillar,
        SitePillars.BibleId => Features.BiblePillar,
        SitePillars.DiscoverId => Features.DiscoverPillar
            && (Features.MiraclesFeature || Features.SaintsFeature || Features.PrayerFeature || Features.DevotionsFeature
                || Features.ArticlesFeature || Features.LiturgyOfTheHoursFeature),
        _ => true,
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    // Switching pillars is top-level navigation, so reset to the top and start a fresh breadcrumb trail.
    private async Task MarkTopLevel()
    {
        NavIntent.ResetToTop = true;
        await Trail.ClearAsync();
    }

    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private async Task SelectMenuItem()
    {
        _menuOpen = false;
        await MarkTopLevel();
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menuOpen = false;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var previous = _activeId;
        var wasOpen = _menuOpen;
        _menuOpen = false;
        UpdateActive();
        if (_activeId != previous || wasOpen)
        {
            StateHasChanged();
        }
    }

    private void UpdateActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _activeId = SitePillars.ResolveActiveId(relative);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
