@* Puts the page into reader mode (the immersive view that hides the surrounding chrome so the pinned ReaderBar
   stands in for it) while Active, and restores the chrome when Active clears or the page goes away. *@
@implements IAsyncDisposable
@inject ImmersiveInterop Immersive

@code {
    /// <summary>Whether reader mode should be on; pages pass true once their item has loaded.</summary>
    [Parameter] public bool Active { get; set; }

    private bool _entered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Active == _entered)
        {
            return;
        }

        _entered = Active;
        await (Active ? Immersive.EnterAsync() : Immersive.LeaveAsync());
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Immersive.LeaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; nothing to restore.
        }
    }
}
