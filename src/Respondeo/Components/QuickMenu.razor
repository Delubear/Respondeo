@implements IDisposable
@inject NavigationManager Nav
@inject IPinService Pins
@inject IDevotionService DevotionService
@inject Respondeo.Services.FeatureFlags Features
@inject Respondeo.Services.OfflinePacks Packs
@inject ITextSizeService TextSizes

<button type="button" class="quick-menu__toggle" @onclick="Open"
		aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" aria-label="Open the quick menu">
	<span aria-hidden="true">&#9776;</span>
</button>

<Microsoft.AspNetCore.Components.Sections.SectionContent SectionName="quick-menu">
@if (_open)
{
	<div class="quick-menu__backdrop @(_closing ? "quick-menu__backdrop--closing" : null)" @onclick="Close"></div>
	<nav class="quick-menu @(_closing ? "quick-menu--closing" : null)" role="dialog"
		 @onkeydown="OnKeyDown" @ref="_panel" style="@PanelStyle"
		 @ontouchstart="OnTouchStart" @ontouchmove="OnTouchMove" @ontouchend="OnTouchEnd" @ontouchcancel="OnTouchEnd">
		<div class="quick-menu__header" @ontouchstart="() => _fromHeader = true">
			<h2 class="quick-menu__title">Quick menu</h2>
			<button type="button" class="quick-menu__close" @onclick="Close" aria-label="Close the quick menu">&times;</button>
		</div>

		@if (_managingOffline)
		{
			<section class="quick-menu__section">
				<h3 class="quick-menu__heading">Offline reading</h3>
				<OfflinePackControls ShowHeading="false" />
			</section>
			<div class="quick-menu__footer">
				<button type="button" class="quick-menu__customize" @onclick="() => _managingOffline = false">Done</button>
			</div>
		}
		else if (_customizing)
		{
			<section class="quick-menu__section">
				<h3 class="quick-menu__heading">Choose pages to pin</h3>
				<ul class="quick-menu__list">
					@foreach (var entry in _entries)
					{
						@RenderEntry(entry, true)
					}
				</ul>
			</section>
			<div class="quick-menu__footer">
				<button type="button" class="quick-menu__customize" @onclick="() => _customizing = false">Done</button>
			</div>
		}
		else
		{
			<section class="quick-menu__section quick-menu__section--pinned">
				<h3 class="quick-menu__heading">Pinned</h3>
				@if (_pinned.Count == 0)
				{
					<p class="quick-menu__empty">Nothing pinned yet. Tap the pencil icon to choose pages.</p>
				}
				else
				{
					<ul class="quick-menu__list" @onpointermove="OnDragMove" @onpointerup="EndDrag"
						@onpointercancel="EndDrag" @onpointerleave="EndDrag">
						@for (var i = 0; i < _pinned.Count; i++)
						{
							var entry = _pinned[i];
							var idx = i;
							<li class="quick-menu__item @(idx == _dragIndex ? "quick-menu__item--dragging" : null)"
								style="@ItemStyle(idx)" @key="entry.Href">
								@if (_reordering)
								{
									<div class="quick-menu__row quick-menu__row--draggable"
										 @onpointerdown="e => StartDrag(idx, e)" @onpointerdown:preventDefault>
										<span class="quick-menu__label">@entry.Label</span>
										<span class="quick-menu__handle" aria-hidden="true">&#x2807;</span>
									</div>
								}
								else
								{
									<a class="quick-menu__link" href="@entry.Href" @onclick="Close">@entry.Label</a>
								}
							</li>
						}
					</ul>
				}
				@if (_reordering)
				{
					<div class="quick-menu__footer">
						<button type="button" class="quick-menu__customize" @onclick="() => _reordering = false">Done</button>
					</div>
				}
				else
				{
					<div class="quick-menu__actions">
						<button type="button" class="quick-menu__icon-btn" aria-label="Customize" title="Customize"
							@onclick="() => _customizing = true">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
								stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 20h9" />
								<path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
							</svg>
						</button>
						@if (_pinned.Count > 1)
						{
							<button type="button" class="quick-menu__icon-btn" aria-label="Reorder" title="Reorder"
								@onclick="() => _reordering = true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
									stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 4v16M3 8l4-4 4 4" />
									<path d="M17 20V4M13 16l4 4 4-4" />
								</svg>
							</button>
						}
						@if (Packs.Supported)
						{
							<button type="button" class="quick-menu__icon-btn" aria-label="Offline reading" title="Offline reading"
								@onclick="() => _managingOffline = true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
									stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 3v12M7 10l5 5 5-5" />
									<path d="M5 21h14" />
								</svg>
							</button>
						}
					</div>
				}
			</section>
			<section class="quick-menu__section quick-menu__section--textsize">
				<h3 class="quick-menu__heading" id="quick-menu-textsize">Article text size</h3>
				<div class="quick-menu__textsize" role="group" aria-labelledby="quick-menu-textsize">
					@foreach (var size in Enum.GetValues<TextSize>())
					{
						var s = size;
						<button type="button" class="quick-menu__textsize-btn quick-menu__textsize-btn--@s.ToString().ToLowerInvariant()"
								aria-pressed="@(TextSizes.Current == s ? "true" : "false")" aria-label="@($"{s} text")" title="@s.ToString()"
								@onclick="() => TextSizes.SetAsync(s)">A</button>
					}
				</div>
			</section>
		}
	</nav>
}
</Microsoft.AspNetCore.Components.Sections.SectionContent>

@code {
	private bool _open;
	private bool _customizing;
	private bool _reordering;
	private bool _managingOffline;
	private ElementReference _panel;
	private bool _focusPanel;
	private IReadOnlyList<SiteMap.Entry> _entries = [];
	private List<SiteMap.Entry> _pinned = [];

	private RenderFragment RenderEntry(SiteMap.Entry entry, bool withChildren) =>
		@<li class="quick-menu__item">
			<div class="quick-menu__row">
				<button type="button" class="quick-menu__pin @(Pins.IsPinned(entry.Href) ? "quick-menu__pin--on" : null)"
						aria-pressed
						aria-label="@((Pins.IsPinned(entry.Href) ? "Unpin " : "Pin ") + entry.Label)"
						@onclick="() => Pins.TogglePinAsync(entry.Href)">
					<svg class="quick-menu__pin-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6z" /><path d="M12 14v7" /></svg>
				</button>
				<a class="quick-menu__link" href="@entry.Href" @onclick="Close">@entry.Label</a>
			</div>
			@if (withChildren && entry.Children is { Count: > 0 } children)
			{
				<ul class="quick-menu__list quick-menu__list--nested">
					@foreach (var child in children)
					{
						@RenderEntry(child, true)
					}
				</ul>
			}
		</li>;

	protected override async Task OnInitializedAsync()
	{
		_entries = SiteMap.Build(Features);
		Refresh();
		Pins.Changed += OnPinsChanged;
		Packs.Changed += OnPacksChanged;
		Nav.LocationChanged += OnLocationChanged;

		if (Features.DiscoverPillar && Features.DevotionsFeature)
		{
			var devotions = await DevotionService.GetIndexAsync();
			_entries = SiteMap.Build(Features,
				[.. devotions.OrderBy(d => d.SortValue, StringComparer.CurrentCultureIgnoreCase)
					.Select(d => new SiteMap.Entry(ContentRoutes.DevotionHref(d.Id), d.Title))]);
			Refresh();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await Pins.InitializeAsync();
			await TextSizes.InitializeAsync();
			await Packs.StartAsync();
		}

		if (_focusPanel && _open)
		{
			_focusPanel = false;
			try
			{
				await _panel.FocusAsync();
			}
			catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException)
			{
				// The drawer renders through a SectionOutlet, so its element may not be attached yet.
			}
		}
	}

	private void Refresh() =>
		_pinned = Pins.Pins.Select(h => SiteMap.Find(_entries, h)).OfType<SiteMap.Entry>().ToList();

	private void Open()
	{
		_open = true;
		_focusPanel = true;
	}

	private bool _closing;

	private async Task Close()
	{
		if (!_open || _closing)
		{
			return;
		}

		_closing = true;
		_tracking = false;
		StateHasChanged();
		await Task.Delay(200);
		_closing = false;
		_open = false;
		_customizing = false;
		_reordering = false;
		_managingOffline = false;
		_dragIndex = -1;
		_dragOffset = 0;
		_dragX = 0;
		_dragY = 0;
		_tracking = false;
	}

	private const double SwipeCloseThreshold = 80;
	private double _touchStartX;
	private double _touchStartY;
	private double _dragX;
	private bool _tracking;
	private bool _horizontal;
	private double _dragY;
	private bool _fromHeader;

	private string? PanelStyle => !_tracking ? null
		: _dragY > 0 ? $"transform: translateY({_dragY:0}px); transition: none;"
		: _dragX > 0 ? $"transform: translateX({_dragX:0}px); transition: none;"
		: null;

	private void OnTouchStart(TouchEventArgs e)
	{
		if (e.Touches.Length != 1)
		{
			return;
		}

		_touchStartX = e.Touches[0].ClientX;
		_touchStartY = e.Touches[0].ClientY;
		_dragX = 0;
		_horizontal = false;
		_tracking = true;
	}

	private void OnTouchMove(TouchEventArgs e)
	{
		if (_dragIndex >= 0 || !_tracking || e.Touches.Length != 1)
		{
			return;
		}

		var dx = e.Touches[0].ClientX - _touchStartX;
		var dy = e.Touches[0].ClientY - _touchStartY;
		if (!_horizontal)
		{
			if (Math.Abs(dy) > 10 && Math.Abs(dy) > Math.Abs(dx))
			{
				if (_fromHeader && dy > 0)
				{
					_dragY = dy;
					return;
				}

				if (_dragY <= 0)
				{
					_tracking = false;
				}

				return;
			}

			_horizontal = Math.Abs(dx) > 10;
		}

		if (_horizontal)
		{
			_dragX = Math.Max(0, dx);
		}
	}

	private async Task OnTouchEnd(TouchEventArgs e)
	{
		var shouldClose = _tracking && ((_horizontal && _dragX > SwipeCloseThreshold) || _dragY > SwipeCloseThreshold);
		_tracking = false;
		_dragX = 0;
		_dragY = 0;
		_fromHeader = false;
		if (shouldClose)
		{
			await Close();
		}
	}

	private int _dragIndex = -1;
	private double _dragStartY;
	private double _dragOffset;
	private const double RowHeight = 48;

	private string? ItemStyle(int idx)
	{
		if (_dragIndex < 0)
		{
			return null;
		}

		if (idx == _dragIndex)
		{
			return $"transform:translateY({_dragOffset}px)";
		}

		var target = Math.Clamp(_dragIndex + (int)Math.Round(_dragOffset / RowHeight), 0, _pinned.Count - 1);
		if (target > _dragIndex && idx > _dragIndex && idx <= target)
		{
			return $"transform:translateY(-{RowHeight}px)";
		}

		if (target < _dragIndex && idx < _dragIndex && idx >= target)
		{
			return $"transform:translateY({RowHeight}px)";
		}

		return null;
	}

	private void StartDrag(int idx, PointerEventArgs e)
	{
		_dragIndex = idx;
		_dragStartY = e.ClientY;
		_dragOffset = 0;
	}

	private void OnDragMove(PointerEventArgs e)
	{
		if (_dragIndex < 0)
		{
			return;
		}

		_dragOffset = Math.Clamp(e.ClientY - _dragStartY, -_dragIndex * RowHeight, (_pinned.Count - 1 - _dragIndex) * RowHeight);
	}

	private async Task EndDrag()
	{
		if (_dragIndex < 0)
		{
			return;
		}

		var steps = Math.Clamp((int)Math.Round(_dragOffset / RowHeight), -_dragIndex, _pinned.Count - 1 - _dragIndex);
		var href = _pinned[_dragIndex].Href;
		_dragIndex = -1;
		_dragOffset = 0;
		for (var s = 0; s < Math.Abs(steps); s++)
		{
			await Pins.MovePinAsync(href, Math.Sign(steps));
		}
	}

	private async Task OnKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Escape")
		{
			await Close();
		}
	}

	private void OnPinsChanged()
	{
		Refresh();
		InvokeAsync(StateHasChanged);
	}

	private void OnPacksChanged() => InvokeAsync(StateHasChanged);

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		if (_open)
		{
			_open = false;
			_closing = false;
			InvokeAsync(StateHasChanged);
		}
	}

	public void Dispose()
	{
		Pins.Changed -= OnPinsChanged;
		Packs.Changed -= OnPacksChanged;
		Nav.LocationChanged -= OnLocationChanged;
	}
}
