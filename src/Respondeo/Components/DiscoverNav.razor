@* Per-pillar sub-navigation for the Discover Catholicism pillar: peer tabs for its sub-areas (Miracles, Prayers, Devotions, Articles).
    Only renders while browsing within the Discover pillar.
    Each tab is gated by the same granular feature flags that gate the sub-areas, so a disabled area hides its tab. Delegates all shell/markup/behavior to <MastNav>. *@
@implements IDisposable
@inject NavigationManager Nav
@inject Respondeo.Services.FeatureFlags Features

@if (_isDiscover)
{
    <MastNav AriaLabel="Discover Catholicism" ListId="discovernav-list" Items="VisibleItems" />
}

@code {
    private bool _isDiscover;

    // Only the enabled tabs, mapped to MastNav items with the right active-match semantics.
    // The DiscoverPillar master switch supersedes the per-area flags, so nothing shows when it is off.
    private IReadOnlyList<MastNav.Item> VisibleItems =>
        Features.DiscoverPillar ? DiscoverNavigation.Items.Where(i => i.IsEnabled(Features))
                   .Select(i => new MastNav.Item(i.Href, i.Label, i.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix))
                   .ToList() : [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var wasDiscover = _isDiscover;
        UpdateActive();

        if (_isDiscover != wasDiscover)
        {
            StateHasChanged();
        }
    }

    private void UpdateActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _isDiscover = SitePillars.ResolveActiveId(relative) == SitePillars.DiscoverId;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
