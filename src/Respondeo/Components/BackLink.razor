@* Standardised "back to list" link used at the foot of detail pages (articles, prayers,
   miracles, devotions, summa). Renders an arrow plus label in muted ink, turning to the red
   accent with an underline on hover/focus so the affordance is consistent across the site. *@

<p class="back-link">
    <a href="@Href">&larr; @Label</a>
</p>

@code {
    /// <summary>Destination route for the back link (e.g. "discover/articles").</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;

    /// <summary>Visible label following the arrow (e.g. "Back to all articles").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
}
