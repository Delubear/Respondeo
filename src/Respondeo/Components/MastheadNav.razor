@* Persistent primary navigation, rendered from the central SiteNavigation.Items list.
   Collapses behind a toggle button on small screens. *@
@implements IDisposable
@inject NavigationManager Nav
@inject Respondeo.Services.NavigationIntent NavIntent
@inject Respondeo.Services.IBreadcrumbTrail Trail

@if (_isJourney)
{
    <nav class="mastnav" aria-label="Primary">
        <button type="button" class="mastnav__toggle" aria-expanded="@_open" aria-controls="mastnav-list"
                @onclick="Toggle">
            <span class="mastnav__toggle-icon" aria-hidden="true"></span>
            <span class="mastnav__toggle-label">Menu</span>
        </button>
        <ul id="mastnav-list" class="mastnav__list @(_open ? "mastnav__list--open" : "")">
            @foreach (var item in SiteNavigation.Items)
            {
                <li class="mastnav__item">
                    <NavLink class="mastnav__link" href="@item.Href"
                             Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             @onclick="MarkTopLevel">
                        @item.Label
                    </NavLink>
                </li>
            }
        </ul>
    </nav>
}

@code {
    private bool _open;
    private bool _isJourney = true;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    private void Toggle() => _open = !_open;

    // Masthead nav is top-level navigation, so the following route change should reset to the top
    // and start a fresh breadcrumb trail.
    private async Task MarkTopLevel()
    {
        NavIntent.ResetToTop = true;
        await Trail.ClearAsync();
    }

    // Collapse the menu after navigating so it never stays open over the new page.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var wasJourney = _isJourney;
        var wasOpen = _open;

        UpdateActive();
        _open = false;

        if (wasOpen || _isJourney != wasJourney)
        {
            StateHasChanged();
        }
    }

    // The journey stage tabs only belong to the Journey pillar; other pillars hide this sub-nav
    // (their own sub-navigation, when they have one, would render here instead).
    private void UpdateActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _isJourney = SitePillars.ResolveActiveId(relative) == SitePillars.JourneyId;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
