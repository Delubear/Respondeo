@* Journey-stage sub-navigation: renders the primary stage tabs from SiteNavigation, but only
   while the Journey pillar is active. Delegates all shell/markup/behavior to <MastNav>. *@
@implements IDisposable
@inject NavigationManager Nav

@if (_isJourney)
{
    <MastNav AriaLabel="Primary" ListId="mastnav-list" Items="_items" />
}

@code {
    private bool _isJourney = true;

    // The journey stages, mapped to MastNav items. The Home link matches exactly so it only
    // highlights on the home route; the rest match by prefix.
    private static readonly IReadOnlyList<MastNav.Item> _items =
        SiteNavigation.Items
            .Select(i => new MastNav.Item(i.Href, i.Label, i.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix))
            .ToList();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var wasJourney = _isJourney;
        UpdateActive();

        if (_isJourney != wasJourney)
        {
            StateHasChanged();
        }
    }

    // The journey stage tabs only belong to the Journey pillar; other pillars hide this sub-nav
    // (their own sub-navigation, when they have one, renders instead).
    private void UpdateActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _isJourney = SitePillars.ResolveActiveId(relative) == SitePillars.JourneyId;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
