@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Respondeo.Services.NavigationIntent NavIntent
@using Respondeo.Services

<div class="scroll-progress" style="width:@ProgressStyle"></div>

<button type="button" class="back-to-top @(_showBackToTop ? "is-visible" : string.Empty)" @onclick="ScrollToTopAsync" aria-label="Back to top" title="Back to top">
    ↑
</button>

@code {
    private double _progress;
    private bool _showBackToTop;
    private ScrollSubscription? _scroll;

    private string ProgressStyle => _progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scroll = new ScrollSubscription(JS);
            await _scroll.StartAsync(OnScroll);
        }
    }

    private void OnScroll(double progress, bool showButton)
    {
        _progress = progress;
        _showBackToTop = showButton;
        StateHasChanged();
    }

    private async Task ScrollToTopAsync()
    {
        if (_scroll is not null)
        {
            await _scroll.InvokeVoidAsync("scrollToTop");
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_scroll is null)
        {
            return;
        }

        // The masthead nav tabs and content cards can target the same route, so the destination URL alone cannot distinguish them.
        // The masthead nav flags its clicks as top-level, which resets to the very top.
        // Everything else — entry cards, node/article navigation — scrolls down to the content region so the reader lands on their breadcrumb trail.
        var resetToTop = NavIntent.ConsumeResetToTop();
        _ = _scroll.InvokeVoidAsync(resetToTop ? "jumpToTop" : "jumpToContent");
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;

        if (_scroll is not null)
        {
            await _scroll.DisposeAsync();
        }
    }
}
