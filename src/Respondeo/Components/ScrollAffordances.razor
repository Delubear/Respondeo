@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="scroll-progress" style="width:@ProgressStyle"></div>

<button type="button" class="back-to-top @(_showBackToTop ? "is-visible" : string.Empty)" @onclick="ScrollToTopAsync" aria-label="Back to top" title="Back to top">
    ↑
</button>

@code {
    private double _progress;
    private bool _showBackToTop;
    private ScrollSubscription? _scroll;

    private string ProgressStyle => _progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scroll = new ScrollSubscription(JS);
            await _scroll.StartAsync(OnScroll);
        }
    }

    private void OnScroll(double progress, bool showButton)
    {
        _progress = progress;
        _showBackToTop = showButton;
        StateHasChanged();
    }

    private async Task ScrollToTopAsync() => await JS.InvokeVoidAsync("respondeoScroll.top");

    public async ValueTask DisposeAsync()
    {
        if (_scroll is not null)
        {
            await _scroll.DisposeAsync();
        }
    }
}
