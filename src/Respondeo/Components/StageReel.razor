@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The Home "journey reel": a horizontal scroll-snap list of stage cards. Stage 1 sits
   at the LEFT and the journey walks rightward along the path. Owns its JS interop
   lifecycle (import / init / dispose) and the scroll-affordance controls. Callers pass
   in the ordered list of stages; data loading stays with the page. *@

<div class="reel-wrap">
    <div class="reel" role="list" tabindex="0" aria-label="The journey, stage by stage. Use the arrow keys to move between stages." @ref="_reel">
        @for (var i = 0; i < Stages.Count; i++)
        {
            var stage = Stages[i];
            <div class="reel__step" role="listitem">
                <StageCard Href="@stage.Slug"
                           Icon="@Emblems.ForStage(stage.Slug)"
                           Label="@stage.Node.Title"
                           Eyebrow="@($"Stage {i + 1} of {Stages.Count}")"
                           Prompt="@stage.Node.Summary" />
            </div>
        }
    </div>

    <button type="button" class="reel__hint reel__hint--prev" @onclick="ScrollPrevAsync" aria-label="Show the previous stage">
        <span class="reel__chevron"></span>
        <span class="reel__hint-label">Earlier steps</span>
    </button>
    <button type="button" class="reel__hint reel__hint--next" @onclick="ScrollNextAsync" aria-label="Show the next stage">
        <span class="reel__hint-label">Keep walking</span>
        <span class="reel__chevron"></span>
    </button>

    <div class="reel-dots" role="group" aria-label="Jump to a stage"></div>
</div>

@code {
    /// <summary>The ordered stages to render, one card per stage.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ReelStage> Stages { get; set; } = [];

    private ElementReference _reel;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The reel renders Stage 1 (the starting point) at the LEFT so the journey walks
        // rightward along the path. Start the reader there, and let the module apply an
        // IntersectionObserver fallback for the turning effect where scroll-driven CSS
        // animations aren't supported.
        if (Stages.Count > 0 && _module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reel.js");
            await _module.InvokeVoidAsync("init", _reel);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _reel);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone during teardown; nothing to clean up.
            }
        }
    }

    // Step back toward the starting point (earlier stages, to the left).
    private async Task ScrollPrevAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, -1);
        }
    }

    // Step forward along the path (later stages, to the right).
    private async Task ScrollNextAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollByStep", _reel, 1);
        }
    }

    /// <summary>A single stage in the reel: its slug (route) and its landing node.</summary>
    public sealed record ReelStage(string Slug, ContentNode Node);
}
