@* A single row within a <CredoList>: an emblem plate, a text column (title, optional
   summary, optional meta tag), and a trailing arrow. The whole row is one link. *@

<li class="credo-row">
    <a class="credo-row__link @(Accent ? "credo-row__link--accent" : null)" href="@Href">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="credo-row__emblem" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="presentation" focusable="false">
                    <path d="@Emblems.Path(Icon)" />
                </svg>
            </span>
        }
        <span class="credo-row__body">
            <span class="credo-row__title-line">
                <span class="credo-row__title">@Title</span>
                @if (!string.IsNullOrWhiteSpace(Meta))
                {
                    <span class="credo-row__meta">@Meta</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(Summary))
            {
                <span class="credo-row__summary">@Summary</span>
            }
        </span>
        <span class="credo-row__cta">
            @if (!string.IsNullOrWhiteSpace(Cta))
            {
                <span class="credo-row__cta-label">@Cta</span>
            }
            <span class="credo-row__arrow" aria-hidden="true">&rarr;</span>
        </span>
    </a>
</li>

@code {
    /// <summary>The destination URL for the row.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;

    /// <summary>The row's primary heading.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional one-line description shown beneath the title.</summary>
    [Parameter] public string? Summary { get; set; }

    /// <summary>Optional short tag (e.g. a category or kind) shown alongside the title.</summary>
    [Parameter] public string? Meta { get; set; }

    /// <summary>Optional call-to-action label shown before the arrow (e.g. "Pray").</summary>
    [Parameter] public string? Cta { get; set; }

    /// <summary>The emblem name resolved via <see cref="Emblems.Path"/>.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>When true, gives the row a subtle left accent border to set it apart (e.g. Inquiry articles among Credo ones).</summary>
    [Parameter] public bool Accent { get; set; }
}
