@* A premium browse list for the Discover section: a bordered, gilded column of tappable rows.
   Each row is a <DiscoverRow>. Prefer this over the generic card grid so the "living the faith"
   pages read like an ordered treasury rather than a wall of cards. *@

<ul class="discover-list">
    @ChildContent
</ul>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
