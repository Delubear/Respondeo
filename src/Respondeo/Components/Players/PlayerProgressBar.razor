@* The pinned bottom bar shared by the guided players (Liturgy of the Hours, devotions): the current step and
   count, a progress track, per-player tools beside the phone-only quick-menu button, and Leave / Back / Next. One
   component keeps both players' bars in sync. *@
<div class="playerbar" role="group" aria-label="Progress">
    <div class="playerbar__top">
        <span class="playerbar__label" title="@Label">
            <span class="playerbar__title">@Label</span>
            <span class="playerbar__count">&middot; @Math.Min(Completed, Total) of @Total</span>
        </span>
        <span class="playerbar__track" aria-hidden="true">
            <span class="playerbar__fill" style="width: @(100 * Math.Min(Completed, Total) / Math.Max(1, Total))%"></span>
        </span>
        <span class="playerbar__tools">
            @Tools
            <BarMenuButton />
        </span>
    </div>
    <div class="playerbar__row">
        <a class="playerbar__nav playerbar__leave" href="@LeaveHref">Leave</a>
        <span class="playerbar__nav-group">
            <button type="button" class="playerbar__nav" disabled="@(Completed <= 0)" @onclick="OnBack">Back</button>
            <button type="button" class="playerbar__nav" disabled="@(Completed >= Total)" @onclick="OnNext">Next</button>
        </span>
    </div>
</div>

@code {
    /// <summary>The current step's name, shown before the count; truncates to keep the bar to one top line.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>How many steps are done.</summary>
    [Parameter] public int Completed { get; set; }

    /// <summary>The total number of steps.</summary>
    [Parameter] public int Total { get; set; }

    /// <summary>Where Leave goes.</summary>
    [Parameter, EditorRequired] public string LeaveHref { get; set; } = string.Empty;

    [Parameter] public EventCallback OnBack { get; set; }

    [Parameter] public EventCallback OnNext { get; set; }

    /// <summary>Player-specific buttons shown before the theme toggle (e.g. the hour settings gear, the EN/LA toggle).</summary>
    [Parameter] public RenderFragment? Tools { get; set; }
}
