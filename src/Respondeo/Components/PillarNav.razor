@* Top-tier "pillar switcher": the site's areas (Journey, Summa, Discover Catholicism).
   Sits above the per-pillar navigation (e.g. the journey stages, or the Discover sub-tabs). The active
   pillar is derived from the current route so it stays highlighted while browsing within a pillar. *@
@implements IDisposable
@inject NavigationManager Nav
@inject Respondeo.Services.NavigationIntent NavIntent
@inject Respondeo.Services.IBreadcrumbTrail Trail
@inject Respondeo.Services.FeatureFlags Features

<nav class="pillarnav" aria-label="Site areas">
    <ul class="pillarnav__list">
        @foreach (var pillar in SitePillars.Items.Where(IsEnabled))
        {
            var isActive = pillar.Id == _activeId;
            <li class="pillarnav__item">
                <a class="pillarnav__link @(isActive ? "pillarnav__link--active" : "")"
                   href="@pillar.Href"
                   aria-current="@(isActive ? "page" : null)"
                   @onclick="MarkTopLevel">
                    @pillar.Label
                </a>
            </li>
        }
    </ul>
</nav>

@code {
    private string _activeId = SitePillars.JourneyId;

    // The Journey pillar is the site's spine and always shown; the Summa pill and the merged
    // Discover Catholicism pill are each gated behind deploy-time feature flags. Discover shows when
    // either of its sub-areas (Miracles or the prayers/devotions/articles trio) is enabled, so the whole pillar hides only
    // when both are turned off.
    private bool IsEnabled(SitePillars.Pillar pillar) => pillar.Id switch
    {
        SitePillars.SummaId => Features.SummaPillar,
        SitePillars.DiscoverId => Features.MiraclesPillar || Features.LivingFaithPillar,
        _ => true,
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    // Switching pillars is top-level navigation, so reset to the top and start a fresh breadcrumb trail.
    private async Task MarkTopLevel()
    {
        NavIntent.ResetToTop = true;
        await Trail.ClearAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var previous = _activeId;
        UpdateActive();
        if (_activeId != previous)
        {
            StateHasChanged();
        }
    }

    private void UpdateActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _activeId = SitePillars.ResolveActiveId(relative);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
