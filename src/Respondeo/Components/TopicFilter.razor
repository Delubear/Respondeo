@* Topic filter sidebar for the browse pages. Owns only selection UI; the parent owns the topic list and decides what to do with the selection (two-way bound via @bind-Selected).
   A group with no topics renders nothing, so facets with no content never appear. When Counts is supplied, each option shows how many results it would yield
   alongside the other active filters; zero-count options are dimmed and disabled (but stay in place so the rail never jumps), except selected ones, which stay clickable so they can be cleared. *@

@if (Topics.Count > 0)
{
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="topic-filter__header">
            <h2 class="filter-rail__title">@Title</h2>
            <button type="button" class="topic-filter__clear" @onclick="ClearTopics" hidden="@(Selected.Count == 0)">
                Clear filters
            </button>
        </div>
    }
    <div class="topic-filter">
        @foreach (var topic in Topics)
        {
            var count = Count(topic);
            var selected = IsSelected(topic);
            var unavailable = count == 0 && !selected;
            <label class="topic-filter__option @(unavailable ? "topic-filter__option--empty" : null)">
                <input type="checkbox" checked="@selected" disabled="@unavailable" @onchange="() => ToggleTopic(topic)" />
                <span class="topic-filter__label">@Label(topic)</span>
                @if (count is { } n)
                {
                    <span class="topic-filter__count" aria-label="@($"{n} {(n == 1 ? "result" : "results")}")">@n</span>
                }
            </label>
        }
    </div>
    @if (string.IsNullOrWhiteSpace(Title) && Selected.Count > 0)
    {
        <button type="button" class="topic-filter__clear" @onclick="ClearTopics">
            Clear filters
        </button>
    }
}

@code {
    /// <summary>All selectable topics, in display order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Topics { get; set; } = Array.Empty<string>();

    /// <summary>Optional heading shown above the options; when set, the clear action renders beside it.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The currently selected topics. Two-way bindable via <c>@bind-Selected</c>.</summary>
    [Parameter] public IReadOnlySet<string> Selected { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    /// <summary>Raised with a new selection set whenever the visitor toggles or clears topics.</summary>
    [Parameter] public EventCallback<IReadOnlySet<string>> SelectedChanged { get; set; }

    /// <summary>
    /// Optional map from a topic value to the text shown to the visitor. When null the value is shown as-is.
    /// Lets callers store neutral slugs in <see cref="Selected"/> while displaying friendly labels.
    /// </summary>
    [Parameter] public Func<string, string>? DisplayLabel { get; set; }

    /// <summary>
    /// Optional per-topic result counts (keyed by topic value), computed against the other active filters and the search.
    /// When null no counts are shown and every option stays enabled. A topic missing from the map counts as zero.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, int>? Counts { get; set; }

    private int? Count(string topic) => Counts is null ? null : Counts.GetValueOrDefault(topic);

    private bool IsSelected(string topic) => Selected.Contains(topic);

    private string Label(string topic) => DisplayLabel?.Invoke(topic) ?? topic;

    private Task ToggleTopic(string topic)
    {
        var next = new HashSet<string>(Selected, StringComparer.OrdinalIgnoreCase);
        if (!next.Remove(topic))
        {
            next.Add(topic);
        }

        return SelectedChanged.InvokeAsync(next);
    }

    private Task ClearTopics() => SelectedChanged.InvokeAsync(new HashSet<string>(StringComparer.OrdinalIgnoreCase));
}
