@* Topic filter sidebar for the articles index. Owns only selection UI; the parent owns the topic list and decides what to do with the selection (two-way bound via @bind-Selected). *@

@if (Topics.Count == 0)
{
    <p class="topic-filter__empty">No topics yet.</p>
}
else
{
    <div class="topic-filter">
        @foreach (var topic in Topics)
        {
            <label class="topic-filter__option">
                <input type="checkbox"
                       checked="@IsSelected(topic)"
                       @onchange="() => ToggleTopic(topic)" />
                <span>@Label(topic)</span>
            </label>
        }
    </div>
    @if (Selected.Count > 0)
    {
        <button type="button" class="topic-filter__clear" @onclick="ClearTopics">
            Clear filters
        </button>
    }
}

@code {
    /// <summary>All selectable topics, in display order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Topics { get; set; } = Array.Empty<string>();

    /// <summary>The currently selected topics. Two-way bindable via <c>@bind-Selected</c>.</summary>
    [Parameter] public IReadOnlySet<string> Selected { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    /// <summary>Raised with a new selection set whenever the visitor toggles or clears topics.</summary>
    [Parameter] public EventCallback<IReadOnlySet<string>> SelectedChanged { get; set; }

    /// <summary>
    /// Optional map from a topic value to the text shown to the visitor. When null the value is shown as-is.
    /// Lets callers store neutral slugs in <see cref="Selected"/> while displaying friendly labels.
    /// </summary>
    [Parameter] public Func<string, string>? DisplayLabel { get; set; }

    private bool IsSelected(string topic) => Selected.Contains(topic);

    private string Label(string topic) => DisplayLabel?.Invoke(topic) ?? topic;

    private Task ToggleTopic(string topic)
    {
        var next = new HashSet<string>(Selected, StringComparer.OrdinalIgnoreCase);
        if (!next.Remove(topic))
        {
            next.Add(topic);
        }

        return SelectedChanged.InvokeAsync(next);
    }

    private Task ClearTopics() => SelectedChanged.InvokeAsync(new HashSet<string>(StringComparer.OrdinalIgnoreCase));
}
