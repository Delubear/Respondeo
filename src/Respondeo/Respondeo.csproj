<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respondeo.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="Css" Pattern="*.css" Expression="#[.{fingerprint}]!" />
    <StaticWebAssetFingerprintPattern Include="Js" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!--
    Fingerprint the app stylesheet link in the published index.html.

    Background: the Blazor WASM SDK rewrites <script src> fingerprint placeholders (so
    js/site.js is fingerprinted automatically) but does NOT rewrite <link rel="stylesheet">
    hrefs in a standalone WASM app. The StaticWebAssetFingerprintPattern items above still make
    the SDK emit a content-hashed css/app.<hash>.css file and a matching endpoint whose "label"
    is the original "css/app.css". This target reads that generated endpoints manifest, finds the
    hashed route for css/app.css, and rewrites the published index.html to point at it. The result
    is fully automatic cache-busting: the URL changes only when the file's contents change.
  -->
  <Target Name="FingerprintStylesheets" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishedIndexHtml>$(PublishDir)wwwroot\index.html</_PublishedIndexHtml>
      <_EndpointsManifest>$(IntermediateOutputPath)staticwebassets.publish.endpoints.json</_EndpointsManifest>
    </PropertyGroup>

    <!-- Extract the fingerprinted route for css/app.css from the endpoints manifest.
         Matches "Route":"css/app.<hash>.css" entries and captures the file name. -->
    <ReadLinesFromFile File="$(_EndpointsManifest)">
      <Output TaskParameter="Lines" ItemName="_EndpointsLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_EndpointsText>@(_EndpointsLines, '')</_EndpointsText>
      <_HashedCssRoute>$([System.Text.RegularExpressions.Regex]::Match($(_EndpointsText), 'css/app\.[0-9a-z]+\.css').Value)</_HashedCssRoute>
    </PropertyGroup>

    <Warning Text="FingerprintStylesheets: could not find a fingerprinted css/app.css route; index.html left unchanged."
             Condition="'$(_HashedCssRoute)' == ''" />

    <WriteLinesToFile
      Condition="'$(_HashedCssRoute)' != '' and Exists('$(_PublishedIndexHtml)')"
      File="$(_PublishedIndexHtml)"
      Lines="$([System.IO.File]::ReadAllText($(_PublishedIndexHtml)).Replace('href=&quot;css/app.css&quot;', 'href=&quot;$(_HashedCssRoute)&quot;'))"
      Overwrite="true" />

    <Message Importance="high"
             Condition="'$(_HashedCssRoute)' != ''"
             Text="FingerprintStylesheets: rewrote app stylesheet link to $(_HashedCssRoute)." />

    <!--
      Rewriting index.html above changes its bytes AFTER the SDK generated
      service-worker-assets.js, whose integrity manifest still records the pre-rewrite hash of
      index.html. On install the published service worker fetches index.html with that recorded
      integrity, so the stale hash makes the browser block the response ("SRI's integrity checks
      failed"). Recompute the hash of the rewritten index.html and patch its entry in the manifest
      so the two stay consistent. SHA256 is not callable from an MSBuild property function, so this
      is done in the inline PatchServiceWorkerIndexHtmlHash task below.
    -->
    <PatchServiceWorkerIndexHtmlHash
      Condition="'$(_HashedCssRoute)' != '' and Exists('$(_PublishedIndexHtml)')"
      IndexHtmlPath="$(_PublishedIndexHtml)"
      ServiceWorkerAssetsPath="$(PublishDir)wwwroot\service-worker-assets.js" />
  </Target>

  <!--
    Inline task: recompute the SHA-256 integrity of the (rewritten) published index.html and update
    its entry in service-worker-assets.js so the PWA service worker's SRI check passes on install.
  -->
  <UsingTask TaskName="PatchServiceWorkerIndexHtmlHash" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <IndexHtmlPath ParameterType="System.String" Required="true" />
      <ServiceWorkerAssetsPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(ServiceWorkerAssetsPath))
        {
            Log.LogWarning("PatchServiceWorkerIndexHtmlHash: service-worker-assets.js not found; the PWA may fail SRI checks on install.");
            return true;
        }

        string newHash;
        using (var sha = System.Security.Cryptography.SHA256.Create())
        {
            newHash = "sha256-" + System.Convert.ToBase64String(sha.ComputeHash(System.IO.File.ReadAllBytes(IndexHtmlPath)));
        }

        var manifest = System.IO.File.ReadAllText(ServiceWorkerAssetsPath);
        var match = System.Text.RegularExpressions.Regex.Match(
            manifest,
            "\"hash\":\\s*\"(sha256-[^\"]+)\",\\s*\"url\":\\s*\"index\\.html\"");

        if (!match.Success)
        {
            Log.LogWarning("PatchServiceWorkerIndexHtmlHash: could not find the index.html entry in service-worker-assets.js; the PWA may fail SRI checks on install.");
            return true;
        }

        var oldHash = match.Groups[1].Value;
        if (oldHash == newHash)
        {
            return true;
        }

        System.IO.File.WriteAllText(ServiceWorkerAssetsPath, manifest.Replace(oldHash, newHash));
        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
            "PatchServiceWorkerIndexHtmlHash: updated index.html integrity in service-worker-assets.js to " + newHash + ".");
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Progressive Web App support. The SDK generates service-worker-assets.js (the integrity
    manifest of every published static asset) from the ServiceWorkerAssetsManifest hint, and
    swaps service-worker.js for service-worker.published.js at publish time via the ServiceWorker
    item. The published worker precaches that manifest so the app - including the bundled Summa
    corpus and Markdown content - runs fully offline once installed.
  -->
  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respondeo.Content.Markdown\Respondeo.Content.Markdown.csproj" />
    <ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
  </ItemGroup>

</Project>
