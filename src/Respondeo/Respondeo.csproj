<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respondeo.UnitTests" />
  </ItemGroup>

  <!--
    Emit content-hashed asset file names (css/app.<hash>.css, js/*.<hash>.js) at publish time.
    Combined with OverrideHtmlAssetPlaceholders, the SDK rewrites the #[.{fingerprint}]
    placeholders in index.html to the hashed names, so assets can be cached forever yet always
    refresh after a deploy (needed on GitHub Pages, where we cannot set cache headers).
  -->
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="Css" Pattern="*.css" Expression="#[.{fingerprint}]!" />
    <StaticWebAssetFingerprintPattern Include="Js" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!--
    Publish-time stylesheet fingerprinting + PWA SRI re-sync. Extracted to its own file to keep
    this project file readable; see build/FingerprintAppStylesheet.targets for the rationale.
  -->
  <Import Project="build\FingerprintAppStylesheet.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Progressive Web App support. The SDK generates service-worker-assets.js (the integrity
    manifest of every published static asset) from the ServiceWorkerAssetsManifest hint, and
    swaps service-worker.js for service-worker.published.js at publish time via the ServiceWorker
    item. The published worker precaches that manifest so the app - including the bundled Summa
    corpus and Markdown content - runs fully offline once installed.
  -->
  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respondeo.Content.Markdown\Respondeo.Content.Markdown.csproj" />
    <ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
  </ItemGroup>

</Project>
