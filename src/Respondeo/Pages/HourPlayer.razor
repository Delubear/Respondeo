@page "/discover/hours/{Slug}"
@using Respondeo.LiturgyOfTheHours
@inject ILiturgyOfTheHours Office
@inject HourPassageLoader PassageLoader
@inject NavigationInterop Navigation
@inject IHourPlayerSettingsService Settings
@inject OrbLauncher Launcher
@inject Func<DateOnly> Today
@implements IAsyncDisposable

<PageShell Title="@_office?.Title" FallbackTitle="Liturgy of the Hours" Description="Pray the Liturgy of the Hours step by step." Article="true" SeoReady="@(_office is not null)"
           StageHref="@ContentRoutes.Discover" StageLabel="Discover" Crumbs="_crumbs" />

@if (_office is null)
{
    <ItemNotFound Title="Hour not found" BackHref="@ContentRoutes.Hours" BackLabel="Return to the Liturgy of the Hours">
        There is no hour named &ldquo;<code>@Slug</code>&rdquo;.
    </ItemNotFound>
}
else
{
    <section class="reading-wide hourplayer fade-enter immersive-root" @key="Slug">
        <h1 class="hourplayer__title">@_office.Title</h1>
        <p class="hourplayer__meta">@_date.ToString("dddd, MMMM d, yyyy") &middot; Psalter Week @ToRoman(_office.PsalterWeek)</p>
        @if (!string.IsNullOrWhiteSpace(_office.Acknowledgment) && _office.Steps.Any(s => s.IsLicensedText))
        {
            <p class="hourplayer__ack" role="note">@_office.Acknowledgment</p>
        }
        <ConstructionNotice Area="the Liturgy of the Hours" />
        @if (_office.IsSampleContent)
        {
            <p class="hourplayer__sample" role="note">
                The hymns, antiphons, readings, responsories, intercessions, and prayers shown here are sample placeholder text, not the approved translation.
            </p>
        }
        <p class="hourplayer__hint">Select each step to mark it prayed, in order.</p>

        <p class="sr-only" role="status" aria-live="polite">@_announcement</p>

        <ol class="hourplayer__list">
            @for (var i = 0; i < _office.Steps.Count; i++)
            {
                var index = i;
                var step = _office.Steps[i];
                @if (PartLabel(step) is { } part && (index == 0 || PartLabel(_office.Steps[index - 1]) != part))
                {
                    <li class="hourplayer__step hourplayer__banner @(index < _completed ? "is-done" : null)">
                        <span class="hourplayer__marker" aria-hidden="true"></span>
                        <div class="hourplayer__body">
                            <div class="hourplayer__section">
                                <h2 class="hourplayer__section-title">@part</h2>
                                <button type="button" class="hourplayer__section-info" aria-haspopup
                                        aria-label="@($"About the {part}")" title="About this part" @onclick="() => ShowInfoAsync(part)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM11 11h2v6h-2z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </li>
                }
                <li class="hourplayer__step @StepStatus(index)"
                    id="@(index == _completed ? "hour-current-step" : null)" aria-current="@(index == _completed ? "step" : null)">
                    <span class="hourplayer__marker hourplayer__marker--@(step.Kind is OfficeStepKind.Psalm or OfficeStepKind.Canticle or OfficeStepKind.GospelCanticle ? "large" : "small")" aria-hidden="true"></span>
                    <div class="hourplayer__body">
                        <button type="button" class="hourplayer__head" aria-expanded="@Expanded(index)" @onclick="() => HeadClick(index)">
                            <span class="hourplayer__step-title hourplayer__step-title--rubric">@step.Title</span>
                            @if (step.Kind == OfficeStepKind.Reading && step.Reference?.Citation is { } cite && cite != step.Title)
                            {
                                <span class="hourplayer__ref">@cite</span>
                            }
                            @if (step.Reference?.DouayCitation is { } douay)
                            {
                                <span class="hourplayer__ref" title="Vulgate (Douay-Rheims) numbering">(Vulgate: @douay)</span>
                            }
                        </button>
                        @if (HasText(index, step))
                        {
                            <button type="button" class="hourplayer__toggle" aria-expanded="@Expanded(index)"
                                    aria-label="@($"{(_open.Contains(index) ? "Hide" : "Show")} the words of {step.Title}")"
                                    title="@(_open.Contains(index) ? "Hide the text" : "Show the text")"
                                    @onclick="() => ToggleOpen(index)">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M6 9l6 6 6-6" />
                                </svg>
                            </button>
                        }
                        @if (_open.Contains(index))
                        {
                            <div class="hourplayer__content">
                                @if (step.IntroText is not null && Settings.Current.InvitatoryMode == InvitatoryMode.None)
                                {
                                    <p class="hourplayer__explain" role="note">The Invitatory was already prayed at an earlier Hour today, so this Hour opens with the usual introduction.</p>
                                    <p class="hourplayer__text">@RenderText(step.IntroText)</p>
                                }
                                else
                                {
                                    @if (step.Explanation is not null)
                                    {
                                        <p class="hourplayer__explain" role="note">@step.Explanation</p>
                                    }
                                    @if (step.Antiphon is not null)
                                    {
                                        <p class="hourplayer__antiphon"><span class="hourplayer__rubric">Ant.</span> @RenderText(step.Antiphon)</p>
                                    }
                                    @if (step.Text is not null)
                                    {
                                        <p class="hourplayer__text">@RenderText(step.Text)</p>
                                    }
                                    else if (_passages.TryGetValue(index, out var passage))
                                    {
                                        <p class="hourplayer__text">@RenderText(passage)</p>
                                        <p class="hourplayer__translation">Douay-Rheims translation</p>
                                    }
                                    else if (step.UseOfficialText)
                                    {
                                        <p class="hourplayer__official">Read today's text from an official source below.</p>
                                    }
                                    @if (step.Antiphon is not null && step.Kind is (OfficeStepKind.Psalm or OfficeStepKind.Canticle or OfficeStepKind.GospelCanticle))
                                    {
                                        <p class="hourplayer__antiphon"><span class="hourplayer__rubric">Ant.</span> @RenderText(step.Antiphon)</p>
                                    }
                                    @if (step.Options is { Count: > 0 } options)
                                    {
                                        var visible = VisibleOptions(index, options);
                                        var stepIndex = index;
                                        <div class="hourplayer__options">
                                            @if (visible.Count > 1)
                                            {
                                                var chosen = ChosenOption(stepIndex, visible);
                                                <div class="hourplayer__picker" role="group" aria-label="@($"Choose the {step.Title} psalm")">
                                                    @foreach (var optionIndex in visible)
                                                    {
                                                        var oi = optionIndex;
                                                        <button type="button" class="hourplayer__picker-btn"
                                                                aria-pressed="@(oi == chosen ? "true" : "false")"
                                                                @onclick="() => _chosenOptions[stepIndex] = oi">@options[oi].Title</button>
                                                    }
                                                </div>
                                                <HourOption Option="options[chosen]" RenderText="@(t => RenderText(t))"
                                                            Stanzas="@_optionStanzas.GetValueOrDefault((stepIndex, chosen))"
                                                            Passage="@_optionPassages.GetValueOrDefault((stepIndex, chosen))" />
                                            }
                                            else if (visible.Count == 1)
                                            {
                                                <HourOption Option="options[visible[0]]" RenderText="@(t => RenderText(t))"
                                                            Stanzas="@_optionStanzas.GetValueOrDefault((stepIndex, visible[0]))"
                                                            Passage="@_optionPassages.GetValueOrDefault((stepIndex, visible[0]))" />
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>

        @if (_completed >= _office.Steps.Count)
        {
            <div class="hourplayer__done">
                <p class="eyebrow">Thanks be to God</p>
                <p>You have prayed @_office.Title.</p>
            </div>
        }

        <h2 class="hourplayer__sources-title">Official texts</h2>
        <ul class="hourplayer__sources">
            @foreach (var source in _office.OfficialSources)
            {
                <li><a href="@source.Url" target="_blank" rel="noopener">@source.Name</a></li>
            }
        </ul>

        @if (!string.IsNullOrWhiteSpace(_office.Acknowledgment) && _office.Steps.Any(s => s.IsLicensedText))
        {
            <p class="hourplayer__ack hourplayer__ack--end" role="note">@_office.Acknowledgment</p>
        }

        <DevotionPrayerDialog @ref="_infoDialog" Title="@_infoTitle" ExplanationHtml="@_infoHtml" />
    </section>

    @* Kept outside the fade-enter section: its entry transform would otherwise anchor the fixed bar to the section until the animation ends.  *@
    <PlayerProgressBar Label="@CurrentPart()" Completed="_completed" Total="_office.Steps.Count"
                       LeaveHref="@ContentRoutes.Hours" OnBack="Back" OnNext="Next">
        <Tools>
            <button type="button" class="hourplayer__settings" aria-label="Hour settings" title="Hour settings"
                    @onclick="() => Launcher.Request(OrbLauncher.HourSettings)">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19.14 12.94a7.07 7.07 0 0 0 0-1.88l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.61-.22l-2.39.96a7 7 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 2h-3.84a.5.5 0 0 0-.49.42l-.36 2.54a7 7 0 0 0-1.63.94l-2.39-.96a.5.5 0 0 0-.61.22L2.66 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .61.22l2.39-.96c.5.39 1.05.71 1.63.94l.36 2.54a.5.5 0 0 0 .49.42h3.84a.5.5 0 0 0 .49-.42l.36-2.54a7 7 0 0 0 1.63-.94l2.39.96a.5.5 0 0 0 .61-.22l1.92-3.32a.5.5 0 0 0-.12-.64zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" />
                </svg>
            </button>
        </Tools>
    </PlayerProgressBar>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("hours", "Liturgy of the Hours", Href: ContentRoutes.Hours)];

    private Office? _office;
    private DateOnly _date;
    private int _completed;
    private readonly HashSet<int> _open = [];
    private string? _announcement;


    private IReadOnlyDictionary<int, string> _passages = HourPassages.Empty.Passages;
    private IReadOnlyDictionary<(int Step, int Option), string> _optionPassages = HourPassages.Empty.OptionPassages;
    private IReadOnlyDictionary<(int Step, int Option), List<string>> _optionStanzas = HourPassages.Empty.OptionStanzas;

    protected override async Task OnParametersSetAsync()
    {
        _date = Today();
        Hour? hour = Slug.ToLowerInvariant() switch
        {
            "morning" => Hour.MorningPrayer,
            "evening" => Hour.EveningPrayer,
            "night" => Hour.NightPrayer,
            _ => null,
        };
        _office = hour is { } h ? Office.Compose(_date, h) : null;
        _completed = 0;
        _open.Clear();
        _open.Add(0);
        _randomPicks.Clear();
        _chosenOptions.Clear();
        await Settings.LoadAsync();
        await AdvanceInvitatoryCycleAsync();
        _passages = HourPassages.Empty.Passages;
        _optionPassages = HourPassages.Empty.OptionPassages;
        _optionStanzas = HourPassages.Empty.OptionStanzas;

        if (_office is null)
        {
            return;
        }

        var loaded = await PassageLoader.LoadAsync(_office);
        _passages = loaded.Passages;
        _optionPassages = loaded.OptionPassages;
        _optionStanzas = loaded.OptionStanzas;

        if (Settings.Current.ExpandAll)
        {
            for (var i = 0; i < _office.Steps.Count; i++)
            {
                if (HasText(i, _office.Steps[i]))
                {
                    _open.Add(i);
                }
            }
        }
    }

    private readonly Dictionary<int, int> _randomPicks = [];

    // The reader's current pick per step when several options are offered (Show all).
    private readonly Dictionary<int, int> _chosenOptions = [];

    private int ChosenOption(int stepIndex, IReadOnlyList<int> visible) =>
        _chosenOptions.TryGetValue(stepIndex, out var pick) && visible.Contains(pick) ? pick : visible[0];

    protected override void OnInitialized() => Settings.Changed += OnSettingsChanged;

    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    // Advances the daily invitatory cycle once per calendar day so the day's psalm stays the same on every visit.
    private async Task AdvanceInvitatoryCycleAsync()
    {
        var current = Settings.Current;
        var count = _office?.Steps.FirstOrDefault(s => s.Options is { Count: > 0 })?.Options!.Count ?? 0;
        if (current.InvitatoryMode != InvitatoryMode.Cycle || count == 0)
        {
            return;
        }

        var (index, date) = InvitatorySelector.AdvanceCycle(current.InvitatoryCycleIndex, current.InvitatoryCycleDate, Today(), count);
        if (index != current.InvitatoryCycleIndex || date != current.InvitatoryCycleDate)
        {
            await Settings.UpdateAsync(s => s with { InvitatoryCycleIndex = index, InvitatoryCycleDate = date });
        }
    }

    private IReadOnlyList<int> VisibleOptions(int stepIndex, IReadOnlyList<OfficeStep> options)
    {
        var current = Settings.Current;
        if (current.InvitatoryMode == InvitatoryMode.Random)
        {
            if (!_randomPicks.TryGetValue(stepIndex, out var pick) || pick >= options.Count)
            {
                pick = InvitatorySelector.Select(options, InvitatoryMode.Random, null, 0, Random.Shared)[0];
                _randomPicks[stepIndex] = pick;
            }

            return [pick];
        }

        return InvitatorySelector.Select(options, current.InvitatoryMode, current.InvitatoryPsalm, current.InvitatoryCycleIndex, Random.Shared);
    }

    private void Toggle(int index)
    {
        _completed = index < _completed ? index : index + 1;
        _open.Add(_completed);
        _announcement = _completed >= _office!.Steps.Count
            ? "All steps prayed."
            : $"{_completed} of {_office.Steps.Count} steps prayed.";
    }

    private DevotionPrayerDialog? _infoDialog;
    private string? _infoTitle;
    private string? _infoHtml;

    private async Task ShowInfoAsync(string part)
    {
        _infoTitle = part;
        _infoHtml = "<p>" + System.Net.WebUtility.HtmlEncode(PartInfo(part)) + "</p>";
        StateHasChanged();
        await Task.Yield();
        if (_infoDialog is not null)
        {
            await _infoDialog.ShowAsync();
        }
    }

    private void HeadClick(int index)
    {
        if (index == _completed)
        {
            Toggle(index);
        }
        else
        {
            _completed = index;
            _open.Add(index);
            _announcement = $"{_completed} of {_office!.Steps.Count} steps prayed.";
        }
    }

    private void ToggleOpen(int index)
    {
        if (!_open.Remove(index))
        {
            _open.Add(index);
        }
    }

    private static string PartInfo(string part) => part switch
    {
        "Introduction" => "The Hour opens by asking God's help and, at the first Hour of the day, with the Invitatory calling us to praise.",
        "Hymn" => "A hymn sets the tone of the Hour and the season.",
        "Psalmody" => "The heart of the Hour: psalms and canticles prayed with their antiphons, each ending with the Glory Be.",
        "Word of God" => "A short reading from Scripture, followed by a responsory that lets the word sink in.",
        "Gospel Canticle" => "A canticle from the Gospel of Luke, the high point of Morning, Evening, or Night Prayer.",
        "Prayers" => "Intercessions, the Our Father, and the concluding prayer gather up the needs of the Church and the world.",
        "Conclusion" => "The Hour closes with a blessing or, at night, an antiphon to the Blessed Virgin Mary.",
        _ => "",
    };

    private void Back()
    {
        if (_completed > 0)
        {
            Toggle(_completed - 1);
            _scroll = true;
        }
    }

    private void Next()
    {
        if (_completed < _office!.Steps.Count)
        {
            Toggle(_completed);
            _scroll = true;
        }
    }

    private bool _scroll;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scroll)
        {
            _scroll = false;
            // Lands on the part banner when the current step opens a new part, and corrects once layout settles.
            await Navigation.ScrollToStepStartAsync("hour-current-step");
        }
    }

    private string CurrentPart() =>
        _completed < _office!.Steps.Count ? PartLabel(_office.Steps[_completed]) ?? _office.Steps[_completed].Title : "Complete";

    private bool HasText(int index, OfficeStep step) =>
        step.Text is not null || step.Explanation is not null || step.Options is not null || step.Antiphon is not null
        || _passages.ContainsKey(index) || step.UseOfficialText;

    private static string? PartLabel(OfficeStep step) => step.Kind switch
    {
        OfficeStepKind.Hymn => "Hymn",
        OfficeStepKind.Psalm or OfficeStepKind.Canticle => "Psalmody",
        OfficeStepKind.Reading or OfficeStepKind.Responsory => "Word of God",
        OfficeStepKind.GospelCanticle => "Gospel Canticle",
        OfficeStepKind.Intercessions or OfficeStepKind.LordsPrayer or OfficeStepKind.Prayer => "Prayers",
        OfficeStepKind.Conclusion or OfficeStepKind.MarianAntiphon => "Conclusion",
        _ => "Introduction",
    };

    private string StepStatus(int index) =>
        index < _completed ? "is-done"
        : index == _completed ? "is-current"
        : index == _completed + 1 ? "is-next"
        : "is-upcoming";

    private bool IsMarkVisible(BreviarySymbol kind) => kind switch
    {
        BreviarySymbol.Versicle or BreviarySymbol.Response => Settings.Current.ShowVersicleResponseMarks,
        BreviarySymbol.Mediant or BreviarySymbol.Flexa => Settings.Current.ShowPsalmPauseMarks,
        BreviarySymbol.Cross => Settings.Current.ShowCrossMarks,
        _ => true,
    };

    private RenderFragment RenderText(string text) => builder =>
    {
        BreviarySymbol? skippedKind = null;
        foreach (var segment in BreviaryText.Tokenize(text))
        {
            if (segment.Kind != BreviarySymbol.Text && !IsMarkVisible(segment.Kind))
            {
                skippedKind = segment.Kind;
                continue;
            }

            var skipped = skippedKind;
            skippedKind = null;
            switch (segment.Kind)
            {
                case BreviarySymbol.Text:
                    builder.AddContent(0, skipped switch
                    {
                        BreviarySymbol.Versicle or BreviarySymbol.Response => segment.Text.TrimStart('.', ' '),
                        not null => segment.Text.TrimStart(' '),
                        _ => segment.Text,
                    });
                    break;
                case BreviarySymbol.Versicle or BreviarySymbol.Response:
                    builder.OpenElement(1, "span");
                    builder.AddAttribute(2, "class", "hourplayer__rubric");
                    builder.AddContent(4, segment.Text);
                    builder.CloseElement();
                    break;
                default:
                    builder.OpenElement(5, "span");
                    builder.AddAttribute(6, "class", $"hourplayer__sym hourplayer__sym--{segment.Kind.ToString().ToLowerInvariant()}");
                    builder.AddContent(8, segment.Text);
                    builder.CloseElement();
                    break;
            }
        }
    };

    private static string ToRoman(int n) => n switch { 1 => "I", 2 => "II", 3 => "III", _ => "IV" };

    public ValueTask DisposeAsync()
    {
        Settings.Changed -= OnSettingsChanged;
        return ValueTask.CompletedTask;
    }
    private string Expanded(int i) => _open.Contains(i) ? "true" : "false";
}
