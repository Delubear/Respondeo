@page "/discover/miracles/{Id}"
@inject IMiracleService Miracles
@inject IBreadcrumbTrail Trail

<PageTitle>@(_miracle is null ? "Miracle \u2014 Respondeo" : $"{_miracle.Title} \u2014 Respondeo")</PageTitle>

@if (_miracle is not null)
{
    <SeoHead Title="@_miracle.Title" Description="@_miracle.Summary" Article="true" />
}

<Breadcrumb CurrentTitle="@(_miracle?.Title ?? "Miracle")" StageHref="discover/miracles" StageLabel="Miracles" />

@if (_loading)
{
    <Loading>Opening the account&hellip;</Loading>
}
else if (_miracle is null)
{
    <ItemNotFound Title="Miracle not found" BackHref="discover/miracles" BackLabel="Return to the catalog">
        There is no miracle with the id &ldquo;<code>@Id</code>&rdquo;.
    </ItemNotFound>
}
else
{
    <article class="content-article">
        <PillarHeader Eyebrow="@string.Join(" · ", _miracle.Types.Select(_facets.Category))" Title="@_miracle.Title" LedeText="@_miracle.Summary" />

        @if (_miracle.IsUnvetted)
        {
            <ConstructionNotice>
                <strong>Unvetted content.</strong>
                <span>This account is a work in progress and has not yet been reviewed; it may contain errors.</span>
            </ConstructionNotice>
        }

        <FactPanel Class="miracle__facts">
            <Fact Label="Church's judgment">@_facets.Approval(_miracle.Approval)</Fact>
            @if (!string.IsNullOrWhiteSpace(_miracle.Country))
            {
                <Fact Label="Place">@_miracle.Country</Fact>
            }
            @if (_century is not null)
            {
                <Fact Label="When">@_century</Fact>
            }
            @if (!string.IsNullOrWhiteSpace(_miracle.FeastDay))
            {
                <Fact Label="Feast day">@_miracle.FeastDay</Fact>
            }
        </FactPanel>

        <div class="content-body">
            @((MarkupString)_miracle.BodyHtml)
        </div>

        <TagList Tags="_miracle.Tags" />
        <SourcesList Sources="_miracle.Sources" />
        <BackLink Href="discover/miracles" Label="Back to all miracles" />
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MiracleRecord? _miracle;
    private bool _loading = true;
    private string? _century;
    private MiracleFacetCatalog _facets = MiracleFacetCatalog.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _facets = await Miracles.GetFacetsAsync();
        _miracle = await Miracles.GetByIdAsync(Id);
        _century = MiracleFacets.CenturyLabel(_miracle?.Year);
        _loading = false;
    }
}
