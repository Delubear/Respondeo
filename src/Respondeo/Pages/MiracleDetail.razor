@page "/discover/miracles/{Id}"
@inject IMiracleService Miracles
@inherits LoadableComponentBase<MiracleRecord>

<DetailPage Loading="IsLoading" Id="@Id" Noun="Miracle" Title="@_miracle?.Title" Summary="@_miracle?.Summary"
            Eyebrow="@(_miracle is null ? null : string.Join(" \u00B7 ", _miracle.Types.Select(_facets.Category)))"
            LoadingText="Opening the account…" StageHref="discover/miracles" StageLabel="Miracles"
            ListHref="discover/miracles" BackLabel="Back to all miracles" NotFoundBackLabel="Return to the catalog"
            IsUnvetted="@(_miracle?.IsUnvetted ?? false)" UnvettedNoun="account" BodyHtml="@_miracle?.BodyHtml"
            Tags="@(_miracle?.Tags ?? [])" Sources="@(_miracle?.Sources ?? [])" TagsBeforeSources="true">
    <Facts>
        @if (_miracle is { } m)
        {
            <FactPanel Class="miracle__facts">
                <Fact Label="Church's judgment">@_facets.Approval(m.Approval)</Fact>
                @if (!string.IsNullOrWhiteSpace(m.Country))
                {
                    <Fact Label="Place">@m.Country</Fact>
                }
                @if (_century is not null)
                {
                    <Fact Label="When">@_century</Fact>
                }
                @if (!string.IsNullOrWhiteSpace(m.FeastDay))
                {
                    <Fact Label="Feast day">@m.FeastDay</Fact>
                }
            </FactPanel>
        }
    </Facts>
</DetailPage>

@if (!IsLoading && _miracle is not null)
{
    <ReaderMode Active="true" />
    <ReaderBar LeaveHref="discover/miracles" LeaveLabel="Miracles" AriaLabel="Miracle tools" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MiracleRecord? _miracle => Value;
    private string? _century;
    private MiracleFacetCatalog _facets = MiracleFacetCatalog.Empty;

    protected override async Task<MiracleRecord?> LoadAsync(CancellationToken cancellationToken)
    {
        _facets = await Miracles.GetFacetsAsync();
        var miracle = await Miracles.GetByIdAsync(Id);
        _century = MiracleFacets.CenturyLabel(miracle?.Year);
        return miracle;
    }
}
