@page "/discover"
@inject IDiscoverOverview Overview
@inject IBreadcrumbTrail Trail

<PageTitle>Discover Catholicism &mdash; Respondeo</PageTitle>

<SeoHead Title="Discover Catholicism"
         Description="Explore the riches of the Catholic faith: recognized miracles, the lives of the saints, a treasury of prayers, interactive devotions, and articles on the Church's teaching and practice." />

<section class="pillar browse">
    <PillarHeader Eyebrow="Discover Catholicism" Title="Explore the Faith">
        <Lede>
            The inquiry has an end, but the faith has none. Explore the riches of the Catholic life
            &mdash; the miracles God has worked, the saints who witness to him, the prayers of the
            Church, interactive devotions, and articles that dig beneath the practice.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="Discover Catholicism" />

    <CardGrid SingleColumn="true">
        <Card Href="discover/miracles"
              Title="Miracles"
              Pill="Signs and wonders"
              Summary="A growing catalog of reported and recognized miracles &mdash; Eucharistic miracles, Marian apparitions, and healings, with the Church's judgment on each."
              Cta="Explore &rarr;"
              Level="2" />
        <Card Href="discover/saints"
              Title="Saints"
              Pill="Cloud of witnesses"
              Summary="A growing gallery of the saints &mdash; their lives, patronages, and example, from the Fathers of the Church to the holy men and women of our own day."
              Cta="Meet them &rarr;"
              Level="2" />
        <Card Href="discover/prayers"
              Title="Prayers"
              Pill="Treasury"
              Summary="A treasury of the Church's prayers &mdash; the Our Father, the Hail Mary, the Creed, and more, with the Latin alongside."
              Cta="Pray &rarr;"
              Level="2" />
        <Card Href="discover/devotions"
              Title="Devotions"
              Pill="Interactive"
              Summary="Pray the Rosary and the chaplets step by step with an interactive guide that carries you bead by bead."
              Cta="Begin &rarr;"
              Level="2" />
        <Card Href="discover/articles"
              Title="Articles"
              Pill="Learning"
              Summary="Dig deeper into Confession, the Eucharist, the sacraments, and the Church's teaching &mdash; the why beneath the practice."
              Cta="Read &rarr;"
              Level="2" />
    </CardGrid>
</section>

<LiturgicalOrb />

@code {
    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        // Warm the indexes so the section pages load instantly once chosen.
        await Overview.WarmAsync();
    }
}
