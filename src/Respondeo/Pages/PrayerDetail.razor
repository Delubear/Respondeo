@page "/discover/prayers/{Id}"
@inject IPrayerService Prayers
@inject IPrayerLanguageService PrayerLanguage
@inherits LoadableComponentBase<Prayer>

<DetailPage Loading="IsLoading" Id="@Id" Noun="Prayer" Title="@_prayer?.Title" Summary="@_prayer?.Summary"
            LoadingText="Opening the prayer…" StageHref="discover" StageLabel="Discover" Crumbs="_crumbs"
            ListHref="discover/prayers" BackLabel="Back to all prayers" NotFoundBackLabel="Return to all prayers"
            Tags="@(_prayer?.Tags ?? [])">
    <Body>
        <div class="prayer__text" lang="@(ShowingLatin ? "la" : null)">
            @((MarkupString)(ShowingLatin ? _prayer!.LatinHtml! : _prayer!.Html))
        </div>

        @if (!string.IsNullOrWhiteSpace(_prayer.Attribution))
        {
            <p class="prayer__attribution">@_prayer.Attribution</p>
        }
    </Body>
</DetailPage>

@if (!IsLoading && _prayer is not null)
{
    <ReaderMode Active="true" />
    <ReaderBar LeaveHref="discover/prayers"
               GuideOrb="@OrbLauncher.Prayers" GuideLabel="Guide to prayers"
               LatinAvailable="HasLatin" ShowLatin="_showLatin" OnLanguageChange="SetLatin" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("prayers", "Prayers", Href: "discover/prayers")];

    private Prayer? _prayer => Value;
    private bool _showLatin;

    private bool HasLatin => !string.IsNullOrWhiteSpace(_prayer?.LatinHtml);

    private bool ShowingLatin => _showLatin && HasLatin;

    protected override async Task<Prayer?> LoadAsync(CancellationToken cancellationToken)
    {
        var prayer = await Prayers.GetPrayerAsync(Id);
        await PrayerLanguage.InitializeAsync();
        _showLatin = PrayerLanguage.ShowLatin;
        return prayer;
    }

    private async Task SetLatin(bool latin)
    {
        _showLatin = latin;
        await PrayerLanguage.SetAsync(latin);
    }
}
