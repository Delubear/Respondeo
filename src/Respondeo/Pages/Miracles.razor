@page "/discover/miracles"
@inject IMiracleService MiracleService
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse

<PageTitle>Catholic Miracles &mdash; Respondeo</PageTitle>

<SeoHead Title="Catholic Miracles"
         Description="A growing catalog of reported and recognized Catholic miracles — Eucharistic miracles, Marian apparitions, and healings — with the Church's judgment on each." />

<section class="pillar browse">
    <PillarHeader Eyebrow="Signs and wonders" Title="Catholic Miracles">
        <Lede>
            A growing catalog of reported and recognized miracles &mdash; Eucharistic miracles, Marian
            apparitions, healings, and more. Each entry explains what is claimed and how the Church regards it.
        </Lede>
    </PillarHeader>

    @if (_all is null)
    {
        <Loading>Gathering the miracles&hellip;</Loading>
    }
    else
    {
        <SearchBox Id="miracles-search"
                           Label="Search miracles"
                           Placeholder="e.g. Lanciano, healing, Italy..."
                           Value="@_browse.Query"
                           ValueChanged="OnSearchChanged" />

        <div class="filter-layout">
            <aside class="filter-rail">
                <TopicFilter Title="Kind"
                             Topics="_types"
                             Selected="_selectedTypes"
                             SelectedChanged="OnTypesChanged"
                             DisplayLabel="_facets.Category" />

                <TopicFilter Title="Church&rsquo;s judgment"
                             Topics="_approvals"
                             Selected="_selectedApprovals"
                             SelectedChanged="OnApprovalsChanged"
                             DisplayLabel="_facets.Approval" />

                <TopicFilter Title="Region"
                             Topics="_regions"
                             Selected="_selectedRegions"
                             SelectedChanged="OnRegionsChanged"
                             DisplayLabel="_facets.Region" />

                <ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <div class="filter-results">
                <div class="toolbar">
                    <p class="results-count">@Filtered.Count of @_all.Count miracles</p>
                    <SortSelect T="MiracleIndexEntry" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="empty-state">No miracles match the current filters.</p>
                }
                else
                {
                    <CardGrid SingleColumn="true">
                        @foreach (var m in Filtered)
                        {
                            <Card Href="@($"discover/miracles/{m.Id}")"
                                  Title="@m.Title"
                                  Pills="@MiraclePills(m)"
                                  Summary="@CardSummary(m)"
                                  Cta="Read &rarr;"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<MiracleIndexEntry>? _all;
    private IReadOnlyList<string> _types = [];
    private IReadOnlyList<string> _approvals = [];
    private IReadOnlyList<string> _regions = [];
    private MiracleFacetCatalog _facets = MiracleFacetCatalog.Empty;
    private string _sortKey = _sortOptions[0].Key;
    private BrowseSection _browse = default!;
    private IReadOnlySet<string> _selectedTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedApprovals = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedRegions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    // Each sort option carries its own ordering, so the modes are declared once here and the
    // dropdown, current selection, and Filtered logic all stay in sync. Adding a mode is one line.
    private static readonly SortOption<MiracleIndexEntry>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("year-asc", "Year (oldest first)", rows => rows.OrderBy(m => m.Year ?? int.MaxValue).ThenBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("year-desc", "Year (newest first)", rows => rows.OrderByDescending(m => m.Year ?? int.MinValue).ThenBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _browse = Browse.Section("discover/miracles");
        _selectedTypes = new HashSet<string>(_browse.GetFilter("type"), StringComparer.OrdinalIgnoreCase);
        _selectedApprovals = new HashSet<string>(_browse.GetFilter("approval"), StringComparer.OrdinalIgnoreCase);
        _selectedRegions = new HashSet<string>(_browse.GetFilter("region"), StringComparer.OrdinalIgnoreCase);

        _facets = await MiracleService.GetFacetsAsync();
        var index = await MiracleService.GetIndexAsync();
        _all = index.Entries;

        // Only surface facet options that actually occur in the catalog, in a stable display order.
        _types = _all.SelectMany(m => m.Types).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Category, StringComparer.CurrentCultureIgnoreCase).ToList();
        _approvals = _all.Select(m => m.Approval).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Approval, StringComparer.CurrentCultureIgnoreCase).ToList();
        _regions = _all.Select(m => m.Region).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Region, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private void OnSearchChanged(string value) => _browse.Query = value;

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnTypesChanged(IReadOnlySet<string> selected)
    {
        _selectedTypes = selected;
        _browse.SetFilter("type", selected);
    }

    private void OnApprovalsChanged(IReadOnlySet<string> selected)
    {
        _selectedApprovals = selected;
        _browse.SetFilter("approval", selected);
    }

    private void OnRegionsChanged(IReadOnlySet<string> selected)
    {
        _selectedRegions = selected;
        _browse.SetFilter("region", selected);
    }

    private void ClearFilters()
    {
        _selectedTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedApprovals = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedRegions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _browse.Clear();
    }

    // A miracle matches when it satisfies every active facet group (intersection across groups, union
    // within a group) and its title/summary/country/tags contain the search query.
    private IReadOnlyList<MiracleIndexEntry> Filtered
    {
        get
        {
            if (_all is null)
            {
                return Array.Empty<MiracleIndexEntry>();
            }

            var query = _browse.Query?.Trim() ?? string.Empty;

            var results = _all.Where(m =>
                (_selectedTypes.Count == 0 || m.Types.Any(_selectedTypes.Contains))
                && (_selectedApprovals.Count == 0 || _selectedApprovals.Contains(m.Approval))
                && (_selectedRegions.Count == 0 || _selectedRegions.Contains(m.Region))
                && Matches(m, query));

            var sort = _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];
            var ordered = sort.Apply(results);

            return ordered.ToList();
        }
    }

    private bool Matches(MiracleIndexEntry m, string query)
    {
        if (query.Length == 0)
        {
            return true;
        }

        return m.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || m.Summary.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (m.Country?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || m.Tags.Any(t => t.Contains(query, StringComparison.OrdinalIgnoreCase))
            || m.Types.Select(_facets.Category).Any(k => k.Contains(query, StringComparison.OrdinalIgnoreCase))
            || _facets.Region(m.Region).Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string CardSummary(MiracleIndexEntry m)
    {
        var facets = new List<string> { _facets.Approval(m.Approval) };
        var century = MiracleFacets.CenturyLabel(m.Year);
        if (century is not null)
        {
            facets.Add(century);
        }

        if (!string.IsNullOrWhiteSpace(m.Country))
        {
            facets.Add(m.Country!);
        }

        return $"{m.Summary}  \u2014  {string.Join(" \u00b7 ", facets)}";
    }

    // One pill per kind, mirroring the category/kind pill on the Discover lists.
    private IReadOnlyList<string> MiraclePills(MiracleIndexEntry m) =>
        [.. m.Types.Select(_facets.Category).Where(k => !string.IsNullOrWhiteSpace(k))];
}
