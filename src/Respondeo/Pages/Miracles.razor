@page "/discover/miracles"
@inject IMiracleService MiracleService
@inject MiracleBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageShell Title="Catholic Miracles"
         Description="A growing catalog of reported and recognized Catholic miracles — Eucharistic miracles, Marian apparitions, and healings — with the Church's judgment on each." />

<section class="pillar browse" data-browse-scroll="miracles">
    <PillarHeader Eyebrow="Signs and wonders" Title="Catholic Miracles">
        <Lede>
            A growing catalog of reported and recognized miracles &mdash; Eucharistic miracles, Marian
            apparitions, healings, and more. Each entry explains what is claimed and how the Church regards it.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the miracles catalog" />

    @if (_all is null)
    {
        <Loading>Gathering the miracles&hellip;</Loading>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="miracles-search" Label="Search miracles" Placeholder="e.g. Lanciano, healing, Italy..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
                @foreach (var (facet, title) in _rail)
                {
                    <TopicFilter Title="@title" Topics="Options(facet)" Selected="Selected(facet.Key)" SelectedChanged="set => OnFacetChanged(facet.Key, set)" DisplayLabel="MiracleBrowse.Label(_facets, facet.Key)" Counts="Counts(facet)" />
                }
                <ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
            </Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_all.Count" Noun="miracles" EmptyMessage="No miracles match the current filters.">
                <Sort>
                    <SortSelect T="MiracleIndexEntry" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var m in Filtered)
                    {
                        <Card Href="@ContentRoutes.MiracleHref(m.Id)" Title="@m.Title" Pills="@Browser.Pills(m, _facets)" Summary="@Browser.CardSummary(m, _facets)" Cta="Read &rarr;" Level="2" Status="@(m.IsUnvetted ? CardStatus.InProgress : CardStatus.None)" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
    // Optional shareable-link filters, e.g. discover/miracles?type=eucharistic or ?region=europe,asia&q=blood. Read once on load; the URL is never updated.
    [SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string[]? LinkTypes { get; set; }
    [SupplyParameterFromQuery(Name = "approval")] public string[]? LinkApprovals { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string[]? LinkRegions { get; set; }

    private IReadOnlyList<MiracleIndexEntry>? _all;
    private Dictionary<string, IReadOnlyList<string>> _options = new();
    private readonly Dictionary<string, IReadOnlySet<string>> _selected = new();
    private MiracleFacetCatalog _facets = MiracleFacetCatalog.Empty;
    private string _sortKey = _sortOptions[0].Key;
    private BrowseSection _browse = default!;

    // The rail, in display order. Each facet's key is also its shareable-link query name (see the Link* parameters above).
    private static readonly (Facet<MiracleIndexEntry> Facet, string Title)[] _rail =
    [
        (MiracleBrowse.TypeFacet, "Kind"),
        (MiracleBrowse.ApprovalFacet, "Church's judgment"),
        (MiracleBrowse.RegionFacet, "Region"),
    ];

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync. Adding a mode is one line.
    private static readonly SortOption<MiracleIndexEntry>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("year-asc", "Year (oldest first)", rows => rows.OrderBy(m => m.Year ?? int.MaxValue).ThenBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("year-desc", "Year (newest first)", rows => rows.OrderByDescending(m => m.Year ?? int.MinValue).ThenBy(m => m.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _browse = Browse.Section("discover/miracles", () => BrowseJs.ClearAsync("miracles"));
        _browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?>
        {
            [MiracleBrowse.TypeFacet.Key] = LinkTypes,
            [MiracleBrowse.ApprovalFacet.Key] = LinkApprovals,
            [MiracleBrowse.RegionFacet.Key] = LinkRegions,
        });
        foreach (var facet in MiracleBrowse.AllFacets)
        {
            _selected[facet.Key] = new HashSet<string>(_browse.GetFilter(facet.Key), StringComparer.OrdinalIgnoreCase);
        }

        var facetsTask = MiracleService.GetFacetsAsync();
        var indexTask = MiracleService.GetIndexAsync();
        await Task.WhenAll(facetsTask, indexTask);
        _facets = await facetsTask;
        var index = await indexTask;
        _all = index.Entries;

        // Only surface facet options that actually occur in the catalog, in a stable display order.
        _options = MiracleBrowse.AllFacets.ToDictionary(f => f.Key, f => Browser.Options(_all, _facets, f));
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("miracles");
        }
    }

    private void OnSearchChanged(string value) => _browse.Query = value;

    private void OnSortChanged(string value) => _sortKey = value;

    private static readonly IReadOnlySet<string> None = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> Options(Facet<MiracleIndexEntry> facet) => _options.GetValueOrDefault(facet.Key) ?? [];

    private IReadOnlySet<string> Selected(string key) => _selected.GetValueOrDefault(key) ?? None;

    private void OnFacetChanged(string key, IReadOnlySet<string> selected)
    {
        _selected[key] = selected;
        _browse.SetFilter(key, selected);
    }

    private void ClearFilters()
    {
        _selected.Clear();
        _browse.Clear();
    }

    private SortOption<MiracleIndexEntry> CurrentSort => _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];

    // A miracle matches when it satisfies every active facet group (intersection across groups, union within a group) and its title/summary/country/tags contain the search query.
    private IReadOnlyList<MiracleIndexEntry> Filtered => _all is null ? [] : Browser.Filter(_all, _facets, _browse.Query, Selected, CurrentSort);

    // Counts for one facet apply every OTHER active filter and the search, so each option shows what picking it would add.
    private IReadOnlyDictionary<string, int> Counts(Facet<MiracleIndexEntry> facet) =>
        FacetFilter.Counts(Browser.Filter(_all ?? [], _facets, _browse.Query, Selected, _sortOptions[0], exceptKey: facet.Key), facet);
}
