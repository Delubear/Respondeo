@page "/discover/miracles"
@inject IMiracleService MiracleService
@inject IBreadcrumbTrail Trail
@inject MiracleBrowseState Browse

<PageTitle>Catholic Miracles &mdash; Respondeo</PageTitle>

<SeoHead Title="Catholic Miracles"
         Description="A growing catalog of reported and recognized Catholic miracles — Eucharistic miracles, Marian apparitions, and healings — with the Church's judgment on each." />

<section class="discover">
    <header class="pillar__header">
        <p class="pillar__eyebrow">Signs and wonders</p>
        <h1 class="pillar__title">Catholic Miracles</h1>
        <p class="pillar__lede">
            A growing catalog of reported and recognized miracles &mdash; Eucharistic miracles, Marian
            apparitions, healings, and more. Filter by kind, by the Church&rsquo;s judgment, or by place,
            and search by name. Each entry explains what is claimed and how the Church regards it.
        </p>
    </header>

    @if (_all is null)
    {
        <Loading>Gathering the miracles&hellip;</Loading>
    }
    else
    {
        <div class="discover__search">
            <label class="discover__search-label" for="miracles-search">Search miracles</label>
            <input id="miracles-search"
                   class="discover__search-input"
                   type="search"
                   placeholder="e.g. Lanciano, healing, Italy..."
                   value="@Browse.Query"
                   @oninput="OnSearchInput" />
        </div>

        <div class="discover__layout">
            <aside class="discover__sidebar">
                <h2 class="discover__sidebar-title">Kind</h2>
                <TopicFilter Topics="_types"
                             Selected="Browse.Types"
                             SelectedChanged="OnTypesChanged"
                             DisplayLabel="_facets.Category" />

                <h2 class="discover__sidebar-title">Church&rsquo;s judgment</h2>
                <TopicFilter Topics="_approvals"
                             Selected="Browse.Approvals"
                             SelectedChanged="OnApprovalsChanged"
                             DisplayLabel="_facets.Approval" />

                <h2 class="discover__sidebar-title">Region</h2>
                <TopicFilter Topics="_regions"
                             Selected="Browse.Regions"
                             SelectedChanged="OnRegionsChanged"
                             DisplayLabel="_facets.Region" />

                <ClearFiltersButton Active="Browse.HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <div class="discover__results">
                <div class="discover__toolbar">
                    <p class="discover__count">@Filtered.Count of @_all.Count miracles</p>
                    <label class="discover__sort">
                        <span>Sort</span>
                        <select value="@_sort" @onchange="OnSortChanged">
                            <option value="@nameof(MiracleSort.TitleAsc)">Title (A&ndash;Z)</option>
                            <option value="@nameof(MiracleSort.YearAsc)">Year (oldest first)</option>
                            <option value="@nameof(MiracleSort.YearDesc)">Year (newest first)</option>
                        </select>
                    </label>
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="discover__empty">No miracles match the current filters.</p>
                }
                else
                {
                    <CardGrid SingleColumn="true">
                        @foreach (var m in Filtered)
                        {
                            <Card Href="@($"discover/miracles/{m.Id}")"
                                  Title="@m.Title"
                                  Pills="@MiraclePills(m)"
                                  Summary="@CardSummary(m)"
                                  Cta="Read &rarr;"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<MiracleIndexEntry>? _all;
    private IReadOnlyList<string> _types = [];
    private IReadOnlyList<string> _approvals = [];
    private IReadOnlyList<string> _regions = [];
    private MiracleFacetCatalog _facets = MiracleFacetCatalog.Empty;
    private MiracleSort _sort = MiracleSort.TitleAsc;

    private enum MiracleSort { TitleAsc, YearAsc, YearDesc }

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();

        _facets = await MiracleService.GetFacetsAsync();
        var index = await MiracleService.GetIndexAsync();
        _all = index.Entries;

        // Only surface facet options that actually occur in the catalog, in a stable display order.
        _types = _all.SelectMany(m => m.Types).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Category, StringComparer.CurrentCultureIgnoreCase).ToList();
        _approvals = _all.Select(m => m.Approval).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Approval, StringComparer.CurrentCultureIgnoreCase).ToList();
        _regions = _all.Select(m => m.Region).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(_facets.Region, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private void OnSearchInput(ChangeEventArgs e) => Browse.Query = e.Value?.ToString() ?? string.Empty;

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<MiracleSort>(e.Value?.ToString(), out var sort))
        {
            _sort = sort;
        }
    }

    private void OnTypesChanged(IReadOnlySet<string> selected) => Replace(Browse.Types, selected);

    private void OnApprovalsChanged(IReadOnlySet<string> selected) => Replace(Browse.Approvals, selected);

    private void OnRegionsChanged(IReadOnlySet<string> selected) => Replace(Browse.Regions, selected);

    private static void Replace(HashSet<string> target, IReadOnlySet<string> selected)
    {
        target.Clear();
        foreach (var value in selected)
        {
            target.Add(value);
        }
    }

    private void ClearFilters() => Browse.Clear();

    // A miracle matches when it satisfies every active facet group (intersection across groups, union
    // within a group) and its title/summary/country/tags contain the search query.
    private IReadOnlyList<MiracleIndexEntry> Filtered
    {
        get
        {
            if (_all is null)
            {
                return Array.Empty<MiracleIndexEntry>();
            }

            var query = Browse.Query?.Trim() ?? string.Empty;

            var results = _all.Where(m =>
                (Browse.Types.Count == 0 || m.Types.Any(Browse.Types.Contains))
                && (Browse.Approvals.Count == 0 || Browse.Approvals.Contains(m.Approval))
                && (Browse.Regions.Count == 0 || Browse.Regions.Contains(m.Region))
                && Matches(m, query));

            results = _sort switch
            {
                MiracleSort.YearAsc => results.OrderBy(m => m.Year ?? int.MaxValue).ThenBy(m => m.Title, StringComparer.CurrentCultureIgnoreCase),
                MiracleSort.YearDesc => results.OrderByDescending(m => m.Year ?? int.MinValue).ThenBy(m => m.Title, StringComparer.CurrentCultureIgnoreCase),
                _ => results.OrderBy(m => m.Title, StringComparer.CurrentCultureIgnoreCase),
            };

            return results.ToList();
        }
    }

    private static bool Matches(MiracleIndexEntry m, string query)
    {
        if (query.Length == 0)
        {
            return true;
        }

        return m.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || m.Summary.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (m.Country?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || m.Tags.Any(t => t.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private string CardSummary(MiracleIndexEntry m)
    {
        var facets = new List<string> { _facets.Approval(m.Approval) };
        var century = MiracleFacets.CenturyLabel(m.Year);
        if (century is not null)
        {
            facets.Add(century);
        }

        if (!string.IsNullOrWhiteSpace(m.Country))
        {
            facets.Add(m.Country!);
        }

        return $"{m.Summary}  \u2014  {string.Join(" \u00b7 ", facets)}";
    }

    // One pill per kind, mirroring the category/kind pill on the Discover lists.
    private IReadOnlyList<string> MiraclePills(MiracleIndexEntry m) =>
        [.. m.Types.Select(_facets.Category).Where(k => !string.IsNullOrWhiteSpace(k))];
}
