@page "/credo"
@inject ICredoService CredoService
@inject IBreadcrumbTrail Trail

<PageTitle>Credo &mdash; Living the Faith &mdash; Respondeo</PageTitle>

<SeoHead Title="Credo — Living the Faith"
         Description="Now that you believe, live it: prayers, an interactive Rosary and chaplets, and deeper dives into Confession, the Eucharist, and the Catholic life." />

<section class="credo">
    <header class="credo__header">
        <p class="credo__eyebrow">Credo &mdash; I believe</p>
        <h1 class="credo__title">Living the Faith</h1>
        <p class="credo__lede">
            The inquiry has an end, but the faith has none. Having come home, the life of faith is now
            something you <em>do</em> &mdash; prayed, practised, and deepened day by day. Begin here.
        </p>
    </header>

    <CredoList>
        <CredoRow Href="credo/prayers"
                  Title="Prayers"
                  Meta="Treasury"
                  Summary="A treasury of the Church's prayers &mdash; the Our Father, the Hail Mary, the Creed, and more, with the Latin alongside."
                  Cta="Pray" />
        <CredoRow Href="credo/devotions"
                  Title="Devotions"
                  Meta="Interactive"
                  Summary="Pray the Rosary and the chaplets step by step with an interactive guide that carries you bead by bead."
                  Cta="Begin" />
        <CredoRow Href="credo/articles"
                  Title="Articles"
                  Meta="Deeper"
                  Summary="Dig deeper into Confession, the Eucharist, and the Church's teaching &mdash; the why beneath the practice."
                  Cta="Explore" />
    </CredoList>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        // Warm the index so the section pages load instantly once chosen.
        await CredoService.GetIndexAsync();
    }
}
