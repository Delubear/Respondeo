@page "/discover/articles"
@inject IArticleService ArticleService
@inject IContentService Content
@inject IBreadcrumbTrail Trail
@inject DiscoverBrowseState BrowseState
@inject IJSRuntime JS

<PageTitle>Articles &mdash; Discover &mdash; Respondeo</PageTitle>

<SeoHead Title="Living the Faith — Articles"
         Description="Deeper dives into the Catholic life — Confession, the Eucharist, and the Church's teaching — the why beneath the practice." />

<section class="discover" data-discover-browse="articles">
    <header class="pillar__header">
        <p class="pillar__eyebrow">Beneath the practice</p>
        <h1 class="pillar__title">Articles</h1>
        <p class="pillar__lede">
            Once you are living the faith, questions deepen rather than disappear. These articles dig
            into the practices and teachings of the Church &mdash; the reasons beneath the rhythm.
        </p>
    </header>

    @if (_articles is null)
    {
        <Loading>Gathering the articles&hellip;</Loading>
    }
    else if (_articles.Count == 0)
    {
        <p class="discover__empty">No articles are available yet.</p>
    }
    else
    {
        <SearchBox Id="article-search"
                           Label="Search articles"
                           Placeholder="e.g. Confession, Eucharist, prayer..."
                           Value="@_query"
                           ValueChanged="OnSearchChanged" />

        <div class="discover__layout">
            <aside class="discover__sidebar">
                <h2 class="discover__sidebar-title">Source</h2>
                <div class="source-filter" role="radiogroup" aria-label="Article source">
                    @foreach (var option in SourceOptions)
                    {
                        <button type="button"
                                class="source-filter__option @(option.Value == _source ? "source-filter__option--active" : null)"
                                role="radio"
                                aria-checked="@(option.Value == _source)"
                                @onclick="() => OnSourceChanged(option.Value)">
                            @option.Label
                        </button>
                    }
                </div>
                @if (_tags.Count > 0)
                {
                    <h2 class="discover__sidebar-title">Tags</h2>
                    <TopicFilter Topics="_tags" Selected="_selectedTags" SelectedChanged="OnTagsChanged" DisplayLabel="TagLabel.Format" />
                }
                <ClearFiltersButton Active="HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <div class="discover__results">
                <div class="discover__toolbar">
                    <p class="discover__count">@Filtered.Count of @(_articles?.Count ?? 0) articles</p>
                    <label class="discover__sort">
                        <span>Sort</span>
                        <select value="@_sort" @onchange="OnSortChanged">
                            <option value="@nameof(ArticleSort.TitleAsc)">Title (A&ndash;Z)</option>
                            <option value="@nameof(ArticleSort.TitleDesc)">Title (Z&ndash;A)</option>
                        </select>
                    </label>
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="discover__empty">No articles match your search.</p>
                }
                else
                {
                    <CardGrid SingleColumn="true">
                        @foreach (var a in Filtered)
                        {
                            <Card Href="@a.Href"
                                  Title="@a.Title"
                                  Pill="@a.Pill"
                                  Summary="@a.Summary"
                                  Cta="Read &rarr;"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    // A unified row shape so Discover articles and Inquiry nodes can share one searchable, filterable list.
    // Pill is a precomputed display-only kicker (the article's topic for Discover rows, the stage name for
    // Inquiry rows); IsInquiry drives both the Source filter and the subtle row accent.
    private sealed record ArticleRow(string Id, string Title, string Summary, bool IsInquiry, string? Pill, IReadOnlyList<string> Tags, string Href);

    // The Source facet values persisted in browse state.
    private const string SourceAll = "all";
    private const string SourceDiscover = "discover";
    private const string SourceInquiry = "inquiry";

    private static readonly (string Value, string Label)[] SourceOptions =
    [
        (SourceAll, "All"),
        (SourceDiscover, "From Discover"),
        (SourceInquiry, "From Inquiry"),
    ];

    private IReadOnlyList<ArticleRow>? _articles;
    private string _query = string.Empty;

    private string _source = SourceAll;

    private ArticleSort _sort = ArticleSort.TitleAsc;

    private enum ArticleSort { TitleAsc, TitleDesc }

    private IReadOnlySet<string> _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    // Tags on offer follow the chosen Source, so selecting "Inquiry" never lists Discover-only tags
    // (and vice versa) that could never match anything in view.
    private IReadOnlyList<string> _tags =>
        SourceScoped(_articles ?? [])
            .SelectMany(a => a.Tags)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _query = BrowseState.GetQuery("articles");
        _source = BrowseState.GetFilter("articles.source").FirstOrDefault() ?? SourceAll;
        _selectedTags = new HashSet<string>(BrowseState.GetFilter("articles.tag"), StringComparer.OrdinalIgnoreCase);

        var articles = await ArticleService.GetIndexAsync();
        var discoverRows = articles.Select(a =>
            new ArticleRow(a.Id, a.Title, a.Summary, false, FormatPill(a.Topic), a.Tags, $"discover/articles/{a.Id}"));

        // Pull the standalone Inquiry articles (any node not folded into another node's Sections as inline content).
        var nodes = await Content.GetAllAsync();
        var sectionIds = nodes.SelectMany(n => n.Sections).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var inquiryRows = nodes
            .Where(n => !sectionIds.Contains(n.Id))
            .Select(n =>
            {
                var stage = StageLabel(n.Stage);
                // Surface the Inquiry stage as a selectable tag (in addition to the node's own tags).
                var tags = string.IsNullOrWhiteSpace(stage)
                    ? n.Tags
                    : new[] { stage! }.Concat(n.Tags).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                return new ArticleRow(n.Id, n.Title, n.Summary, true, stage, tags, ContentRoutes.NodeHref(n));
            });

        _articles = discoverRows.Concat(inquiryRows)
            .OrderBy(a => a.Title, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("respondeoDiscoverBrowse.restoreScroll", "articles");
        }
    }

    private void OnSearchChanged(string value)
    {
        _query = value;
        BrowseState.SetQuery("articles", _query);
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ArticleSort>(e.Value?.ToString(), out var sort))
        {
            _sort = sort;
        }
    }

    private void OnSourceChanged(string source)
    {
        _source = source;
        BrowseState.SetFilter("articles.source", source == SourceAll ? [] : new HashSet<string> { source });

        // Drop any selected tags that the new source no longer offers so the filter can't hide the whole list.
        var available = _tags.ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (_selectedTags.Any(t => !available.Contains(t)))
        {
            OnTagsChanged(new HashSet<string>(_selectedTags.Where(available.Contains), StringComparer.OrdinalIgnoreCase));
        }
    }

    // Narrows the article set to the chosen Source axis (all / discover-only / inquiry-only).
    private IEnumerable<ArticleRow> SourceScoped(IEnumerable<ArticleRow> rows) => _source switch
    {
        SourceDiscover => rows.Where(a => !a.IsInquiry),
        SourceInquiry => rows.Where(a => a.IsInquiry),
        _ => rows,
    };

    private void OnTagsChanged(IReadOnlySet<string> selected)
    {
        _selectedTags = selected;
        BrowseState.SetFilter("articles.tag", selected);
    }

    private bool HasActiveFilters => _source != SourceAll || _selectedTags.Count > 0;

    private void ClearFilters()
    {
        _source = SourceAll;
        _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        BrowseState.SetFilter("articles.source", new HashSet<string>(StringComparer.OrdinalIgnoreCase));
        BrowseState.SetFilter("articles.tag", _selectedTags);
    }

    // Display-only pill for a Discover article: capitalizes the topic slug, or shows nothing for the
    // neutral "general"/blank bucket so unlabelled articles simply carry no pill.
    private static string? FormatPill(string topic) =>
        string.IsNullOrWhiteSpace(topic) || topic == "general"
            ? null
            : char.ToUpperInvariant(topic[0]) + topic[1..];

    // Display-only pill for an Inquiry article: the stage's friendly name (e.g. "Why God?"), or nothing
    // when the node has no known stage.
    private static string? StageLabel(string? stage) =>
        string.IsNullOrEmpty(stage)
            ? null
            : SiteNavigation.Items.FirstOrDefault(i => string.Equals(i.Href, stage, StringComparison.OrdinalIgnoreCase))?.Label;

    private IReadOnlyList<ArticleRow> Filtered
    {
        get
        {
            if (_articles is null)
            {
                return [];
            }

            IEnumerable<ArticleRow> results = SourceScoped(_articles);

            // Tags: OR within the facet (match any selected tag), AND with the other facets.
            if (_selectedTags.Count > 0)
            {
                results = results.Where(a => a.Tags.Any(t => _selectedTags.Contains(t)));
            }

            if (!string.IsNullOrWhiteSpace(_query))
            {
                var q = _query.Trim();
                results = results.Where(a =>
                    a.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || a.Summary.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || a.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))
                    || (a.Pill?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            results = _sort == ArticleSort.TitleDesc
                ? results.OrderByDescending(a => a.Title, StringComparer.CurrentCultureIgnoreCase)
                : results.OrderBy(a => a.Title, StringComparer.CurrentCultureIgnoreCase);

            return [.. results];
        }
    }
}
