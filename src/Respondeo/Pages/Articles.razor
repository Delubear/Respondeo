@page "/discover/articles"
@inject IArticleService ArticleService
@inject ArticleBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageTitle>Articles &mdash; Discover &mdash; Respondeo</PageTitle>
<SeoHead Title="Living the Faith — Articles" Description="Deeper dives into the Catholic life — Confession, the Eucharist, and the Church's teaching — the why beneath the practice." />

<section class="pillar browse" data-browse-scroll="articles">
    <PillarHeader Eyebrow="Beneath the practice" Title="Articles">
        <Lede>
            Once you are living the faith, questions deepen rather than disappear. These articles dig into the practices and teachings of the Church &mdash; the reasons beneath the rhythm.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the articles library" />

    @if (_articles is null)
    {
        <Loading>Gathering the articles&hellip;</Loading>
    }
    else if (_articles.Count == 0)
    {
        <p class="empty-state">No articles are available yet.</p>
    }
    else
    {
        <SearchBox Id="article-search" Label="Search articles" Placeholder="e.g. Confession, Eucharist, prayer..." Value="@_query" ValueChanged="OnSearchChanged" />

        <div class="filter-layout">
            <aside class="filter-rail">
                @if (_tags.Count > 0)
                {
                    <TopicFilter Title="Tags" Topics="_tags" Selected="_selectedTags" SelectedChanged="OnTagsChanged" DisplayLabel="TagLabel.Format" />
                }
                <ClearFiltersButton Active="HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <FilterResults FilteredCount="Filtered.Count" TotalCount="_articles?.Count ?? 0" Noun="articles" EmptyMessage="No articles match your search.">
                <Sort>
                    <SortSelect T="ArticleRow" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var a in Filtered)
                    {
                        <Card Href="@a.Href" Title="@a.Title" Pill="@a.Pill" Summary="@a.Summary" Cta="Read &rarr;" Level="2" />
                    }
                </ChildContent>
            </FilterResults>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ArticleRow>? _articles;
    private string _query = string.Empty;

    private string _sortKey = _sortOptions[0].Key;

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
    private static readonly SortOption<ArticleRow>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    private IReadOnlySet<string> _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private BrowseSection _browse = default!;

    private IReadOnlyList<string> _tags => Browser.Tags(_articles ?? []);

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _browse = Browse.Section("discover/articles", () => BrowseJs.ClearAsync("articles"));
        _query = _browse.Query;
        _selectedTags = new HashSet<string>(_browse.GetFilter("tag"), StringComparer.OrdinalIgnoreCase);

        var articles = await ArticleService.GetIndexAsync();
        _articles = Browser.BuildRows(articles);
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("articles");
        }
    }

    private void OnSearchChanged(string value)
    {
        _query = value;
        _browse.Query = _query;
    }

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnTagsChanged(IReadOnlySet<string> selected)
    {
        _selectedTags = selected;
        _browse.SetFilter("tag", selected);
    }

    private bool HasActiveFilters => _selectedTags.Count > 0;

    private void ClearFilters()
    {
        _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _browse.SetFilter("tag", _selectedTags);
    }

    private IReadOnlyList<ArticleRow> Filtered =>
        _articles is null ? [] : Browser.Filter(_articles, _query, _selectedTags, _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0]);
}
