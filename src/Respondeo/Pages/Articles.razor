@page "/discover/articles"
@inject IArticleService ArticleService
@inject IBreadcrumbTrail Trail
@inject DiscoverBrowseState BrowseState
@inject IJSRuntime JS

<PageTitle>Articles &mdash; Discover &mdash; Respondeo</PageTitle>

<SeoHead Title="Living the Faith — Articles"
         Description="Deeper dives into the Catholic life — Confession, the Eucharist, and the Church's teaching — the why beneath the practice." />

<section class="pillar browse" data-discover-browse="articles">
    <PillarHeader Eyebrow="Beneath the practice" Title="Articles">
        <Lede>
            Once you are living the faith, questions deepen rather than disappear. These articles dig
            into the practices and teachings of the Church &mdash; the reasons beneath the rhythm.
        </Lede>
    </PillarHeader>

    @if (_articles is null)
    {
        <Loading>Gathering the articles&hellip;</Loading>
    }
    else if (_articles.Count == 0)
    {
        <p class="empty-state">No articles are available yet.</p>
    }
    else
    {
        <SearchBox Id="article-search"
                           Label="Search articles"
                           Placeholder="e.g. Confession, Eucharist, prayer..."
                           Value="@_query"
                           ValueChanged="OnSearchChanged" />

        <div class="filter-layout">
            <aside class="filter-rail">
                @if (_tags.Count > 0)
                {
                    <h2 class="filter-rail__title">Tags</h2>
                    <TopicFilter Topics="_tags" Selected="_selectedTags" SelectedChanged="OnTagsChanged" DisplayLabel="TagLabel.Format" />
                }
                <ClearFiltersButton Active="HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <div class="filter-results">
                <div class="toolbar">
                    <p class="results-count">@Filtered.Count of @(_articles?.Count ?? 0) articles</p>
                    <SortSelect T="ArticleRow" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="empty-state">No articles match your search.</p>
                }
                else
                {
                    <CardGrid SingleColumn="true">
                        @foreach (var a in Filtered)
                        {
                            <Card Href="@a.Href"
                                  Title="@a.Title"
                                  Pill="@a.Pill"
                                  Summary="@a.Summary"
                                  Cta="Read &rarr;"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    // A searchable, filterable row for a Discover article. Pill is a precomputed display-only kicker (the article's topic).
    private sealed record ArticleRow(string Id, string Title, string SortValue, string Summary, string? Pill, IReadOnlyList<string> Tags, string Href);

    private IReadOnlyList<ArticleRow>? _articles;
    private string _query = string.Empty;

    private string _sortKey = _sortOptions[0].Key;

    // Each sort option carries its own ordering, so the modes are declared once here and the
    // dropdown, current selection, and Filtered logic all stay in sync.
    private static readonly SortOption<ArticleRow>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    private IReadOnlySet<string> _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> _tags =>
        (_articles ?? [])
            .SelectMany(a => a.Tags)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _query = BrowseState.GetQuery("articles");
        _selectedTags = new HashSet<string>(BrowseState.GetFilter("articles.tag"), StringComparer.OrdinalIgnoreCase);

        var articles = await ArticleService.GetIndexAsync();
        _articles = articles
            .Select(a => new ArticleRow(a.Id, a.Title, a.SortValue, a.Summary, FormatPill(a.Topic), a.Tags, $"discover/articles/{a.Id}"))
            .OrderBy(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("respondeoDiscoverBrowse.restoreScroll", "articles");
        }
    }

    private void OnSearchChanged(string value)
    {
        _query = value;
        BrowseState.SetQuery("articles", _query);
    }

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnTagsChanged(IReadOnlySet<string> selected)
    {
        _selectedTags = selected;
        BrowseState.SetFilter("articles.tag", selected);
    }

    private bool HasActiveFilters => _selectedTags.Count > 0;

    private void ClearFilters()
    {
        _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        BrowseState.SetFilter("articles.tag", _selectedTags);
    }

    // Display-only pill for a Discover article: capitalizes the topic slug, or shows nothing for the
    // neutral "general"/blank bucket so unlabelled articles simply carry no pill.
    private static string? FormatPill(string topic) =>
        string.IsNullOrWhiteSpace(topic) || topic == "general"
            ? null
            : char.ToUpperInvariant(topic[0]) + topic[1..];

    private IReadOnlyList<ArticleRow> Filtered
    {
        get
        {
            if (_articles is null)
            {
                return [];
            }

            IEnumerable<ArticleRow> results = _articles;

            // Tags: OR within the facet (match any selected tag), AND with the other facets.
            if (_selectedTags.Count > 0)
            {
                results = results.Where(a => a.Tags.Any(t => _selectedTags.Contains(t)));
            }

            if (!string.IsNullOrWhiteSpace(_query))
            {
                var q = _query.Trim();
                results = results.Where(a =>
                    a.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || a.Summary.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || a.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))
                    || (a.Pill?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            var sort = _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];
            results = sort.Apply(results);

            return [.. results];
        }
    }
}
