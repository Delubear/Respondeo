@page "/discover/articles"
@inject IArticleService ArticleService
@inject ArticleBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageShell TabTitle="Articles" Title='@SiteMeta.JoinTitle("Living the Faith", "Articles")' Description="Deeper dives into the Catholic life — Confession, the Eucharist, and the Church's teaching — the why beneath the practice." />

<section class="pillar browse" data-browse-scroll="articles">
    <PillarHeader Eyebrow="Beneath the practice" Title="Articles">
        <Lede>
            Once you are living the faith, questions deepen rather than disappear. These articles dig into the practices and teachings of the Church &mdash; the reasons beneath the rhythm.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the articles library" />

    @if (_articles is null)
    {
        <Loading>Gathering the articles&hellip;</Loading>
    }
    else if (_articles.Count == 0)
    {
        <p class="empty-state">No articles are available yet.</p>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="article-search" Label="Search articles" Placeholder="e.g. Confession, Eucharist, prayer..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
				@foreach (var (facet, title) in _rail)
				{
					@if (Options(facet).Count > 0)
					{
						<TopicFilter Title="@title" Topics="Options(facet)" Selected="Selected(facet.Key)" SelectedChanged="set => OnFacetChanged(facet.Key, set)" DisplayLabel="ArticleBrowse.Label(facet.Key)" Counts="Counts(facet)" />
					}
				}
				<ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
</Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_articles?.Count ?? 0" Noun="articles" EmptyMessage="No articles match your search.">
                <Sort>
                    <SortSelect T="ArticleRow" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var a in Filtered)
                    {
                        <Card Href="@a.Href" Title="@a.Title" Pills="@(new[] { a.Pill })" Summary="@a.Summary" Cta="Read &rarr;" Level="2" Status="@(a.IsUnvetted ? CardStatus.InProgress : CardStatus.None)" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
	// Optional shareable-link filters, e.g. discover/articles?tag=confession&q=sin. Read once on load; the URL is never updated.
	[SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
	[SupplyParameterFromQuery(Name = "tag")] public string[]? LinkTags { get; set; }

	private IReadOnlyList<ArticleRow>? _articles;
	private Dictionary<string, IReadOnlyList<string>> _options = new();
	private readonly Dictionary<string, IReadOnlySet<string>> _selected = new();
	private string _sortKey = _sortOptions[0].Key;
	private BrowseSection _browse = default!;

	// The rail, in display order. Each facet's key is also its shareable-link query name (see the Link* parameters above).
	private static readonly (Facet<ArticleRow> Facet, string Title)[] _rail = [ (ArticleBrowse.TagFacet, "Tags"), ];

	// Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
	private static readonly SortOption<ArticleRow>[] _sortOptions =
	[
		new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
		new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(a => a.SortValue, StringComparer.CurrentCultureIgnoreCase)),
	];

	protected override async Task OnInitializedAsync()
	{
		await Trail.ClearAsync();
		_browse = Browse.Section("discover/articles", () => BrowseJs.ClearAsync("articles"));
		_browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?> { [ArticleBrowse.TagFacet.Key] = LinkTags });
		foreach (var facet in ArticleBrowse.AllFacets)
		{
			_selected[facet.Key] = new HashSet<string>(_browse.GetFilter(facet.Key), StringComparer.OrdinalIgnoreCase);
		}

		var articles = await ArticleService.GetIndexAsync();
		_articles = Browser.BuildRows(articles);
		_options = ArticleBrowse.AllFacets.ToDictionary(f => f.Key, f => Browser.Options(_articles, f));
	}

	// After the list first renders, ask JS to restore the remembered scroll position.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowseJs.RestoreScrollAsync("articles");
		}
	}

	private void OnSearchChanged(string value) => _browse.Query = value;

	private void OnSortChanged(string value) => _sortKey = value;

	private static readonly IReadOnlySet<string> None = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

	private IReadOnlyList<string> Options(Facet<ArticleRow> facet) => _options.GetValueOrDefault(facet.Key) ?? [];

	private IReadOnlySet<string> Selected(string key) => _selected.GetValueOrDefault(key) ?? None;

	private void OnFacetChanged(string key, IReadOnlySet<string> selected)
	{
		_selected[key] = selected;
		_browse.SetFilter(key, selected);
	}

	private void ClearFilters()
	{
		_selected.Clear();
		_browse.Clear();
	}

	private SortOption<ArticleRow> CurrentSort => _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];

	private IReadOnlyList<ArticleRow> Filtered => _articles is null ? [] : Browser.Filter(_articles, _browse.Query, Selected, CurrentSort);

	// Each facet's counts apply the search and every other facet, but not its own selection.
	private IReadOnlyDictionary<string, int> Counts(Facet<ArticleRow> facet) =>
		FacetFilter.Counts(Browser.Filter(_articles ?? [], _browse.Query, Selected, _sortOptions[0], exceptKey: facet.Key), facet);
}
