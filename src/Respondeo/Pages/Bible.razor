@page "/bible"
@inject IBreadcrumbTrail Trail
@inject NavigationManager Nav
@inject IBibleTranslationService Translations
@inject BrowseState Browse
@inject IBibleText BibleText
@inject BrowseStateInterop BrowseJs

<PageShell Title="Holy Bible" Description="Read the Douay-Rheims Bible online &#x2014; all 73 books of the Catholic canon, Old and New Testament." />

<section class="pillar">
    <PillarHeader Eyebrow="@_translation.ShortName()" Title="Holy Bible">
        <Lede>
            The complete Catholic Bible, all 73 books of the Old and New Testament, in the Douay-Rheims
            or the Catholic Public Domain Version.
        </Lede>
    </PillarHeader>

    <BibleTranslationToggle Value="_translation" ValueChanged="OnTranslationChangedAsync" />

    <SearchBox Id="bible-search" Label="Find a book or passage" Placeholder="e.g. Genesis, John 3:16, Ps 22..." Value="@_query" ValueChanged="OnSearchChanged" OnSubmit="OnSearchSubmitted" />
    <OfflinePackNotice Pack="@OfflinePacks.Bible" Label="Bible" />

    @if (IsSearching)
    {
        var reference = BibleReferenceParser.Parse(_query, _translation, _abbreviations);
        @if (reference is not null)
        {
            <a class="bible__match-link bible__reference-card" href="@reference.Href">
                <span class="bible__match-ref">Go to passage</span>
                <span class="bible__match-title">@reference.Label &rarr;</span>
            </a>
        }
        <BibleBookMatches Books="Matches()" Translation="_translation" Query="@_query" HasReference="reference is not null" />
    }
    else
    {
        <div class="bible__browse" data-browse-scroll="bible">
            @foreach (var (testament, title) in Parts)
            {
                var books = _translation.Books().Where(b => b.Testament == testament).ToList();
                if (books.Count == 0) continue;
                <BibleTestamentSection Testament="testament" Title="@title" Books="books" Translation="_translation" Open="IsPartOpen(testament)" />
            }
        </div>
    }

    <OfflinePackControls Only="@(new[] { OfflinePacks.Bible })" />
    <p class="bible__attribution">
        Text: Douay-Rheims Bible, Challoner revision (public domain); Catholic Public Domain Version, Ronald L. Conte Jr.
        (public domain, unofficial).
    </p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tr")] public string? TranslationCode { get; set; }

    private BibleTranslation _translation;

    private IReadOnlyDictionary<string, IReadOnlyList<string>>? _abbreviations;

    private async Task OnTranslationChangedAsync(BibleTranslation translation)
    {
        await Translations.SetAsync(translation);
        _translation = translation;
        _abbreviations = await BibleText.GetAbbreviationsAsync(translation);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tr", translation.Code()), replace: true);
    }

    private static readonly (BibleTestament Testament, string Title)[] Parts =
    [
        (BibleTestament.Old, "Old Testament"),
        (BibleTestament.New, "New Testament"),
        (BibleTestament.Appendix, "Appendix"),
    ];

    // The search text lives in the scoped browse state so it survives drilling into a book and pressing Back; this property is just a convenient proxy.
    private string _query
    {
        get => _browse.Query;
        set => _browse.Query = value;
    }

    private BrowseSection _browse = default!;

    // Snapshot of which parts were open when this page mounted, or null to use the defaults; never changes afterward.
    private HashSet<string>? _openOnMount;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_query);

    private bool IsPartOpen(BibleTestament testament) => _openOnMount?.Contains(testament.ToString()) ?? testament != BibleTestament.Appendix;

    protected override async Task OnInitializedAsync()
    {
        _browse = Browse.Section("bible", () => BrowseJs.ClearAsync("bible"));
        _browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?>());
        if (await BrowseJs.GetOpenAsync("bible") is { Length: > 0 } open)
        {
            _openOnMount = new HashSet<string>(open, StringComparer.Ordinal);
        }

        await Translations.InitializeAsync();
        if (BibleTranslations.Parse(TranslationCode) is { } requested && requested != Translations.Current)
        {
            await Translations.SetAsync(requested);
        }

        _translation = Translations.Current;
        _abbreviations = await BibleText.GetAbbreviationsAsync(_translation);
        await Trail.ClearAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("bible");
        }
    }

    private void OnSearchChanged(string value) => _query = value ?? "";

    private void OnSearchSubmitted(string value)
    {
        _query = value ?? "";
        if (BibleReferenceParser.Parse(_query, _translation, _abbreviations) is { } reference)
        {
            Nav.NavigateTo(reference.Href);
        }
        else if (Matches() is [var only])
        {
            Nav.NavigateTo(_translation.ChapterHref(only, 1));
        }
    }

    private List<BibleBook> Matches()
    {
        var q = _query.Trim();
        return _translation.Books().Where(b =>
            b.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (b.ModernName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
            b.Slug.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }
}
