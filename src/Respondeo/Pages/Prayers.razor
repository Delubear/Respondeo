@page "/discover/prayers"
@inject IPrayerService PrayerService
@inject PrayerBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageTitle>Prayers &mdash; Discover &mdash; Respondeo</PageTitle>

<SeoHead Title="Catholic Prayers"
         Description="A treasury of the Church's traditional prayers — the Our Father, Hail Mary, Glory Be, Apostles' Creed, and more, with the Latin alongside." />

<section class="pillar browse" data-browse-scroll="prayers">
    <PillarHeader Eyebrow="Words for God" Title="Prayers">
        <Lede>
            The Church's own words, learned by heart and prayed across the centuries.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the prayer treasury" />

    @if (_prayers is null)
    {
        <Loading>Gathering the prayers&hellip;</Loading>
    }
    else
    {
        <SearchBox Id="prayer-search" Label="Search prayers" Placeholder="e.g. Hail Mary, Creed, mercy..." Value="@_query" ValueChanged="OnSearchChanged" />

        <div class="filter-layout">
            <aside class="filter-rail">
                @if (_categories.Count > 0)
                {
                    <TopicFilter Title="Category" Topics="_categoryLabels" Selected="_selectedCategories" SelectedChanged="OnCategoriesChanged" />
                }
                @if (_tags.Count > 0)
                {
                    <TopicFilter Title="Tags" Topics="_tags" Selected="_selectedTags" SelectedChanged="OnTagsChanged" DisplayLabel="TagLabel.Format" />
                }
                <ClearFiltersButton Active="HasActiveFilters" OnClear="ClearFilters" />
            </aside>

            <FilterResults FilteredCount="Filtered.Count" TotalCount="_prayers?.Count ?? 0" Noun="prayers" EmptyMessage="No prayers match your search.">
                <Sort>
                    <SortSelect T="PrayerSummary" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var p in Filtered)
                    {
                        <Card Href="@ContentRoutes.PrayerHref(p.Id)" Title="@p.Title" Subtitle="@p.LatinTitle" Pill="@Browser.FormatCategory(p.Category)" Summary="@p.Summary" Cta="Pray &rarr;" Level="2" />
                    }
                </ChildContent>
            </FilterResults>
        </div>
    }
</section>

@code {
    private IReadOnlyList<PrayerSummary>? _prayers;
    private string _query = string.Empty;

    private string _sortKey = _sortOptions[0].Key;

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
    private static readonly SortOption<PrayerSummary>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(p => p.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(p => p.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    // Facet option lists derived from the loaded index (only values that actually occur).
    private IReadOnlyList<string> _categories = [];
    private IReadOnlyList<string> _categoryLabels = [];
    private IReadOnlyList<string> _tags = [];

    private IReadOnlySet<string> _selectedCategories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private BrowseSection _browse = default!;

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _browse = Browse.Section("discover/prayers", () => BrowseJs.ClearAsync("prayers"));
        _query = _browse.Query;
        _selectedCategories = new HashSet<string>(_browse.GetFilter("category"), StringComparer.OrdinalIgnoreCase);
        _selectedTags = new HashSet<string>(_browse.GetFilter("tags"), StringComparer.OrdinalIgnoreCase);

        var prayers = await PrayerService.GetIndexAsync();
        _prayers = prayers;

        _categories = Browser.Categories(_prayers);
        _categoryLabels = Browser.CategoryLabels(_categories);
        _tags = Browser.Tags(_prayers);
    }

    // After the list first renders, ask JS to restore the remembered scroll position (the helper polls across frames until the async content is tall enough to honor the target).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("prayers");
        }
    }

    private void OnSearchChanged(string value)
    {
        _query = value;
        _browse.Query = _query;
    }

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnCategoriesChanged(IReadOnlySet<string> selected)
    {
        _selectedCategories = selected;
        _browse.SetFilter("category", selected);
    }

    private void OnTagsChanged(IReadOnlySet<string> selected)
    {
        _selectedTags = selected;
        _browse.SetFilter("tags", selected);
    }

    private bool HasActiveFilters => _selectedCategories.Count > 0 || _selectedTags.Count > 0;

    private void ClearFilters()
    {
        _selectedCategories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _browse.SetFilter("category", _selectedCategories);
        _browse.SetFilter("tags", _selectedTags);
    }

    private IReadOnlyList<PrayerSummary> Filtered =>
        _prayers is null
            ? []
            : Browser.Filter(
                _prayers,
                _query,
                _selectedCategories,
                _selectedTags,
                _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0]);
}
