@page "/discover/prayers"
@inject IPrayerService PrayerService
@inject PrayerBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageShell Title="Catholic Prayers" TabTitle="Prayers"
         Description="A treasury of the Church's traditional prayers — the Our Father, Hail Mary, Glory Be, Apostles' Creed, and more, with the Latin alongside." />

<section class="pillar browse" data-browse-scroll="prayers">
    <PillarHeader Eyebrow="Words for God" Title="Prayers">
        <Lede>
            The Church's own words, learned by heart and prayed across the centuries.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the prayer treasury" />

    @if (_prayers is null)
    {
        <Loading>Gathering the prayers&hellip;</Loading>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="prayer-search" Label="Search prayers" Placeholder="e.g. Hail Mary, Creed, mercy..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
				@foreach (var (facet, title) in _rail)
				{
					@if (Options(facet).Count > 0)
					{
						<TopicFilter Title="@title" Topics="Options(facet)" Selected="Selected(facet.Key)" SelectedChanged="set => OnFacetChanged(facet.Key, set)" DisplayLabel="Browser.Label(facet.Key)" Counts="Counts(facet)" />
					}
				}
				<ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
</Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_prayers?.Count ?? 0" Noun="prayers" EmptyMessage="No prayers match your search.">
                <Sort>
                    <SortSelect T="PrayerSummary" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var p in Filtered)
                    {
                        <Card Href="@ContentRoutes.PrayerHref(p.Id)" Title="@p.Title" Subtitle="@p.LatinTitle" Pills="@(new[] { Browser.PrimaryPrayedAt(p) })" Summary="@p.Summary" Cta="Pray &rarr;" Level="2" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
	// Optional shareable-link filters, e.g. discover/prayers?prayedAt=rosary&tag=mercy. Read once on load; the URL is never updated.
	[SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
	[SupplyParameterFromQuery(Name = "prayedAt")] public string[]? LinkPrayedAt { get; set; }
	[SupplyParameterFromQuery(Name = "tag")] public string[]? LinkTags { get; set; }

	private IReadOnlyList<PrayerSummary>? _prayers;
	private Dictionary<string, IReadOnlyList<string>> _options = new();
	private readonly Dictionary<string, IReadOnlySet<string>> _selected = new();
	private string _sortKey = _sortOptions[0].Key;
	private BrowseSection _browse = default!;

	// The rail, in display order. Each facet's key is also its remembered-state key.
	private static readonly (Facet<PrayerSummary> Facet, string Title)[] _rail = 
	[
		(PrayerBrowse.PrayedAtFacet, "Prayed at"),
		(PrayerBrowse.TagFacet, "Tags"),
	];

	// Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
	private static readonly SortOption<PrayerSummary>[] _sortOptions =
	[
		new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(p => p.SortValue, StringComparer.CurrentCultureIgnoreCase)),
		new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(p => p.SortValue, StringComparer.CurrentCultureIgnoreCase)),
	];

	protected override async Task OnInitializedAsync()
	{
		await Trail.ClearAsync();
		_browse = Browse.Section("discover/prayers", () => BrowseJs.ClearAsync("prayers"));
		_browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?>
		{
			[PrayerBrowse.PrayedAtFacet.Key] = LinkPrayedAt,
			[PrayerBrowse.TagFacet.Key] = LinkTags,
		});
		foreach (var facet in PrayerBrowse.AllFacets)
		{
			_selected[facet.Key] = new HashSet<string>(_browse.GetFilter(facet.Key), StringComparer.OrdinalIgnoreCase);
		}

		Browser.Facets = await PrayerService.GetFacetsAsync() ?? PrayerFacetCatalog.Empty;
		_prayers = await PrayerService.GetIndexAsync();
		_options = PrayerBrowse.AllFacets.ToDictionary(f => f.Key, f => Browser.Options(_prayers, f));
	}

	// After the list first renders, ask JS to restore the remembered scroll position (the helper polls across frames until the async content is tall enough to honor the target).
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowseJs.RestoreScrollAsync("prayers");
		}
	}

	private void OnSearchChanged(string value) => _browse.Query = value;

	private void OnSortChanged(string value) => _sortKey = value;

	private static readonly IReadOnlySet<string> None = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

	private IReadOnlyList<string> Options(Facet<PrayerSummary> facet) => _options.GetValueOrDefault(facet.Key) ?? [];

	private IReadOnlySet<string> Selected(string key) => _selected.GetValueOrDefault(key) ?? None;

	private void OnFacetChanged(string key, IReadOnlySet<string> selected)
	{
		_selected[key] = selected;
		_browse.SetFilter(key, selected);
	}

	private void ClearFilters()
	{
		_selected.Clear();
		_browse.Clear();
	}

	private SortOption<PrayerSummary> CurrentSort => _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];

	private IReadOnlyList<PrayerSummary> Filtered => _prayers is null ? [] : Browser.Filter(_prayers, _browse.Query, Selected, CurrentSort);

	// Each facet's counts apply the search and every other facet, but not its own selection.
	private IReadOnlyDictionary<string, int> Counts(Facet<PrayerSummary> facet) =>
		FacetFilter.Counts(Browser.Filter(_prayers ?? [], _browse.Query, Selected, _sortOptions[0], exceptKey: facet.Key), facet);
}
