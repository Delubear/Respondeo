@page "/discover/devotions/{Id}"
@implements IAsyncDisposable
@inject IDevotionService Devotions
@inject IPrayerService Prayers
@inject IBreadcrumbTrail Trail
@inject IJSRuntime JS

<PageTitle>@(_devotion is null ? "Devotion" : $"{_devotion.Title} \u2014 Respondeo")</PageTitle>

@if (_devotion is not null)
{
    <SeoHead Title="@_devotion.Title" Description="@_devotion.Summary" Article="true" />
}

<Breadcrumb CurrentTitle="@(_devotion?.Title ?? "Devotion")"
            StageHref="discover"
            StageLabel="Discover"
            Crumbs="_crumbs" />

@if (_loading)
{
    <Loading>Preparing the devotion&hellip;</Loading>
}
else if (_devotion is null)
{
    <section class="devotion">
        <h1 class="pillar__title">Devotion not found</h1>
        <p class="devotion__missing">
            There is no devotion with the id &ldquo;<code>@Id</code>&rdquo;. <a href="discover/devotions">Return to all devotions</a>.
        </p>
    </section>
}
else if (_beads is null)
{
    @* Intro + mystery-set chooser, shown before the reader begins. *@
    <section class="devotion devotion--intro">
        <header class="pillar__header">
            <h1 class="pillar__title">@_devotion.Title</h1>
            @if (!string.IsNullOrWhiteSpace(_devotion.Summary))
            {
                <p class="pillar__lede">@_devotion.Summary</p>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(_devotion.IntroHtml))
        {
            <div class="devotion__intro-body">
                @((MarkupString)_devotion.IntroHtml)
            </div>
        }

        @if (_devotion.MysterySets.Count > 1)
        {
            <div class="devotion__sets">
                <h2 class="devotion__sets-title">Choose today's mysteries</h2>
                <div class="devotion__set-options">
                    @foreach (var set in _devotion.MysterySets)
                    {
                        <button class="devotion__set @(set.Id == _selectedSetId ? "devotion__set--active" : "")"
                                @onclick="() => SelectSet(set.Id)">
                            <span class="devotion__set-name">@set.Name</span>
                            @if (!string.IsNullOrWhiteSpace(set.When))
                            {
                                <span class="devotion__set-when">@set.When</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        <button class="devotion__begin" @onclick="Begin">Begin praying &rarr;</button>
    </section>
}
else
{
    <section class="devotion devotion--praying">
        <p class="devotion__hint">Tap a step to mark it prayed &mdash; in order. Open the book to read its words.</p>

        <ol class="devotion__list">
            @for (var i = 0; i < _beads.Count; i++)
            {
                var step = _beads[i];
                var itemDone = IsItemDone(i);
                var itemCurrent = step.IsPrayer && step.PrayerOrdinal == _completedCount;
                <li class="devotion__step @(itemDone ? "is-done" : null) @(itemCurrent ? "is-current" : null)">
                    <span class="devotion__marker devotion__marker--@(step.BeadType ?? "none")" aria-hidden="true">
                        @if (step.BeadType == "cross")
                        {
                            <svg class="devotion__cross" viewBox="0 0 24 24">
                                <path d="M10.5 2h3v5h5v3h-5v12h-3V10h-5V7h5z" />
                            </svg>
                        }
                        else if (step.BeadType == "medal")
                        {
                            <svg class="devotion__medal" viewBox="0 0 24 24">
                                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zm-.9 2.6v2.4H8.7v1.8h2.4v4.6h1.8v-4.6h2.4V9.5h-2.4V7.1z" />
                            </svg>
                        }
                        else if (step.BeadType == "between")
                        {
                            <span class="devotion__pip"></span>
                            <span class="devotion__pip"></span>
                            <span class="devotion__pip"></span>
                        }
                    </span>

                    <div class="devotion__step-body">
                        @if (step.MysteryTitle is not null)
                        {
                            <div class="devotion__mystery">
                                @if (!string.IsNullOrWhiteSpace(step.Heading))
                                {
                                    <p class="devotion__eyebrow">@step.Heading</p>
                                }
                                <h2 class="devotion__mystery-title">@step.MysteryTitle</h2>
                                @if (!string.IsNullOrWhiteSpace(step.MysteryReflectionHtml))
                                {
                                    <div class="devotion__reflection">
                                        @((MarkupString)step.MysteryReflectionHtml)
                                    </div>
                                }
                            </div>
                        }
                        else if (step.IsPrayer)
                        {
                            var done = step.PrayerOrdinal < _completedCount;
                            var current = step.PrayerOrdinal == _completedCount;
                            var clickable = current || step.PrayerOrdinal == _completedCount - 1;
                            <div class="devotion__prayer-row @(done ? "is-done" : null) @(current ? "is-current" : null) @(!done && !current ? "is-upcoming" : null)">
                                <button type="button"
                                        class="devotion__prayer-main"
                                        @onclick="() => ToggleComplete(step.PrayerOrdinal)"
                                        disabled="@(!clickable)"
                                        aria-pressed="@done">
                                    <span class="devotion__prayer-name">
                                        @if (!string.IsNullOrWhiteSpace(step.Heading) && step.Heading != step.PrayerTitle)
                                        {
                                            <span class="devotion__prayer-lead">@step.Heading</span>
                                        }
                                        @step.PrayerTitle
                                    </span>
                                </button>
                                <button type="button"
                                        class="devotion__prayer-book"
                                        @onclick="() => OpenPrayer(step)"
                                        aria-label="@($"Read the words of {step.PrayerTitle}")"
                                        title="Read the prayer">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 6.5C10.6 5.4 8.6 4.75 6.25 4.75c-1 0-1.95.12-2.75.32v12.6c.8-.2 1.75-.32 2.75-.32 2.35 0 4.35.65 5.75 1.75 1.4-1.1 3.4-1.75 5.75-1.75 1 0 1.95.12 2.75.32V5.07c-.8-.2-1.75-.32-2.75-.32C15.4 4.75 13.4 5.4 12 6.5zm0 0v11.5" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>

        <p class="devotion__exit">
            <a href="discover/devotions">Leave the devotion</a>
        </p>
    </section>

    <dialog @ref="_prayerDialog" class="devotion-dialog" aria-labelledby="devotion-dialog-title">
        <div class="devotion-dialog__panel">
            <header class="devotion-dialog__head">
                <h2 id="devotion-dialog-title" class="devotion-dialog__title">@_openPrayerTitle</h2>
                <button type="button" class="devotion-dialog__close" aria-label="Close" @onclick="ClosePrayer">&times;</button>
            </header>
            <div class="devotion-dialog__body">
                @if (!string.IsNullOrWhiteSpace(_openPrayerHtml))
                {
                    @((MarkupString)_openPrayerHtml)
                }
            </div>
        </div>
    </dialog>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs =
        [new("devotions", "Devotions", Href: "discover/devotions")];

    private Devotion? _devotion;
    private bool _loading = true;
    private string? _selectedSetId;

    private readonly Dictionary<string, Prayer> _prayers = new(StringComparer.OrdinalIgnoreCase);

    private List<Bead>? _beads;
    private int _prayerCount;
    private int _completedCount;

    private ElementReference _prayerDialog;
    private string? _openPrayerTitle;
    private string? _openPrayerHtml;

    // A single row in the devotion: either a mystery announcement (with its reflection) or a prayer
    // the reader taps to mark prayed. Repeated prayers each get their own row (their own bead).
    private sealed class Bead
    {
        public string? Heading { get; init; }
        public string? MysteryTitle { get; init; }
        public string? MysteryReflectionHtml { get; init; }
        public string? PrayerTitle { get; init; }
        public string? PrayerHtml { get; init; }
        public string? BeadType { get; init; }

        // Index of this row among prayer rows (for in-order completion); -1 for mystery announcements.
        public int PrayerOrdinal { get; set; } = -1;

        public bool IsPrayer => PrayerHtml is not null;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _beads = null;
        _completedCount = 0;
        _prayerCount = 0;
        _devotion = await Devotions.GetDevotionAsync(Id);

        if (_devotion is not null)
        {
            _selectedSetId = _devotion.MysterySets.FirstOrDefault()?.Id;
            await LoadPrayersAsync(_devotion);
        }

        _loading = false;
    }

    // Fetch every distinct prayer referenced anywhere in the sequence once, so the player can render
    // each bead's text without further round trips.
    private async Task LoadPrayersAsync(Devotion devotion)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Collect(IEnumerable<DevotionStep> steps)
        {
            foreach (var step in steps)
            {
                if (!string.IsNullOrWhiteSpace(step.PrayerId))
                {
                    ids.Add(step.PrayerId);
                }

                Collect(step.PerMystery);
            }
        }

        Collect(devotion.Sequence);

        foreach (var id in ids)
        {
            var prayer = await Prayers.GetPrayerAsync(id);
            if (prayer is not null)
            {
                _prayers[id] = prayer;
            }
        }
    }

    private void SelectSet(string setId) => _selectedSetId = setId;

    private void Begin()
    {
        _beads = BuildBeads(_devotion!, _selectedSetId);

        // Number the prayer rows so completion can advance through them strictly in order.
        var ordinal = 0;
        foreach (var bead in _beads)
        {
            if (bead.IsPrayer)
            {
                bead.PrayerOrdinal = ordinal++;
            }
        }

        _prayerCount = ordinal;
        _completedCount = 0;
    }

    // Marks the next prayer complete, or unmarks the most recently completed one. Completion can only
    // move forward one step at a time, so nothing can be marked out of order.
    private void ToggleComplete(int ordinal)
    {
        if (ordinal == _completedCount)
        {
            _completedCount++;
        }
        else if (ordinal == _completedCount - 1)
        {
            _completedCount--;
        }
    }

    // A row is "done" once completion has passed it. A mystery announcement is treated as done once
    // the pointer reaches the first prayer of the decade it introduces.
    private bool IsItemDone(int index)
    {
        var beads = _beads!;
        if (beads[index].IsPrayer)
        {
            return beads[index].PrayerOrdinal < _completedCount;
        }

        for (var j = index + 1; j < beads.Count; j++)
        {
            if (beads[j].IsPrayer)
            {
                return beads[j].PrayerOrdinal < _completedCount;
            }
        }

        return _completedCount >= _prayerCount;
    }

    private async Task OpenPrayer(Bead bead)
    {
        _openPrayerTitle = bead.PrayerTitle;
        _openPrayerHtml = bead.PrayerHtml;
        await JS.InvokeVoidAsync("respondeoDialog.show", _prayerDialog);
    }

    private async Task ClosePrayer() => await JS.InvokeVoidAsync("respondeoDialog.close", _prayerDialog);

    // Expands the data-driven sequence into the flat list of rows. A "mysteries" step iterates the
    // chosen set, emitting an announcement row for each mystery followed by its per-mystery prayers.
    private List<Bead> BuildBeads(Devotion devotion, string? selectedSetId)
    {
        var beads = new List<Bead>();
        var set = devotion.MysterySets.FirstOrDefault(s => s.Id == selectedSetId)
                  ?? devotion.MysterySets.FirstOrDefault();

        foreach (var step in devotion.Sequence)
        {
            if (step.Kind == "mysteries" && set is not null)
            {
                foreach (var mystery in set.Mysteries)
                {
                    beads.Add(new Bead
                    {
                        Heading = step.Title,
                        MysteryTitle = mystery.Title,
                        MysteryReflectionHtml = mystery.ReflectionHtml,
                    });

                    foreach (var sub in step.PerMystery)
                    {
                        AddPrayerRow(beads, sub, null);
                    }
                }
            }
            else
            {
                AddPrayerRow(beads, step, step.Title);
            }
        }

        return beads;
    }

    // Adds one row per repetition, so each repeated prayer (e.g. every Hail Mary of a decade) is its
    // own bead on the thread and its own step to mark complete.
    private void AddPrayerRow(List<Bead> beads, DevotionStep step, string? heading)
    {
        if (string.IsNullOrWhiteSpace(step.PrayerId) || !_prayers.TryGetValue(step.PrayerId, out var prayer))
        {
            return;
        }

        var count = Math.Max(1, step.Repeat);
        for (var i = 0; i < count; i++)
        {
            beads.Add(new Bead
            {
                // Only label the first of a repeated group so the heading is not shouted many times.
                Heading = i == 0 ? (heading ?? step.Title) : null,
                PrayerTitle = prayer.Title,
                PrayerHtml = prayer.Html,
                BeadType = step.Bead,
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("respondeoDialog.close", _prayerDialog);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone during teardown; nothing to close.
        }
    }
}
