@page "/discover/devotions/{Id}"
@implements IAsyncDisposable
@inject IDevotionService Devotions
@inject IPrayerService Prayers
@inject IBreadcrumbTrail Trail
@inject IDevotionProgressService Progress
@inject IPrayerLanguageService PrayerLanguage
@inject NavigationInterop Navigation
@inject ImmersiveInterop Immersive

<PageTitle>@(_devotion is null ? "Devotion" : $"{_devotion.Title} \u2014 Respondeo")</PageTitle>

@if (_devotion is not null)
{
    <SeoHead Title="@_devotion.Title" Description="@_devotion.Summary" Article="true" />
}

<Breadcrumb CurrentTitle="@(_devotion?.Title ?? "Devotion")" StageHref="discover" StageLabel="Discover" Crumbs="_crumbs" />

@if (_loading)
{
    <Loading>Preparing the devotion&hellip;</Loading>
}
else if (_devotion is null)
{
    <section class="content-article">
        <h1 class="pillar__title">Devotion not found</h1>
        <p class="empty-state">
            There is no devotion with the id &ldquo;<code>@Id</code>&rdquo;. <a href="discover/devotions">Return to all devotions</a>.
        </p>
    </section>
}
else if (!_started)
{
    @* Intro + mystery-set chooser, shown before the reader begins. *@
    <DevotionIntro Devotion="_devotion" SavedProgress="_savedProgress" ResumeTotal="_session?.CountPrayers(_savedProgress?.SetId) ?? 0" OnResume="Resume" OnBegin="BeginFromIntro" />
}
else
{
    <section class="reading-wide devotion--praying">
        <p class="devotion__hint">Select each step to mark it done, in order. Open the book to read its text.</p>

        @if (_devotion.LatinAvailable)
        {
            <div class="devotion__lang devotion__lang--inline">
                <DevotionLanguageToggle ShowLatin="_showLatin" OnChange="SetLatin" />
            </div>
        }

        @* Announces progress to screen readers as each step is prayed, without moving focus. *@
        <p class="sr-only" role="status" aria-live="polite">@_announcement</p>

        <DevotionStepList Session="_session" ShowLatin="_showLatin" OnToggle="ToggleComplete" OnOpenPrayer="OpenPrayer" OnOpenInfo="OpenInfo" />

        <div class="devotion__exit">
            <a href="discover/devotions">Leave the devotion</a>
            @* Only reachable in immersive mode, where the masthead (and its theme toggle) is hidden; kept beside the exit link so it stays out of the prayer flow. Hidden by CSS elsewhere. *@
            <span class="devotion__exit-theme">
                @if (_devotion.LatinAvailable)
                {
                    <DevotionLanguageToggle ShowLatin="_showLatin" OnChange="SetLatin" Mini="true" />
                }
                <ThemeToggle />
            </span>
        </div>
    </section>

    <DevotionPrayerDialog @ref="_prayerDialog" Title="@_openPrayerTitle" ExplanationHtml="@_openExplanationHtml" PrayerHtml="@_openPrayerHtml" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("devotions", "Devotions", Href: "discover/devotions")];

    private Devotion? _devotion;
    private bool _loading = true;
    private string? _selectedSetId;

    private readonly Dictionary<string, Prayer> _prayers = new(StringComparer.OrdinalIgnoreCase);

    // The live praying session: the expanded thread and in-order completion state. Null until the devotion has loaded; _started switches the intro / set chooser for the praying view.
    private DevotionSession? _session;
    private bool _started;

    // Set when a step is marked prayed so the next render moves keyboard focus onto the new current step (see ToggleComplete / OnAfterRenderAsync). Cleared once the focus has been handed over.
    private bool _focusCurrentStep;

    // Set when resuming an in-progress devotion mid-thread so the next render scrolls the current step into view (the thread can be long, and the reader should land on their spot, not the top).
    private bool _scrollToCurrentStep;

    // Polite live-region text announcing progress to screen readers as steps are prayed. Non-visual users otherwise get no feedback that a step was marked, or that the devotion is complete.
    private string? _announcement;

    // Saved progress for this devotion (from a previous, un-finished visit), if any. Drives the Resume / Start over choice on the intro screen.
    private DevotionProgress? _savedProgress;

    private DevotionPrayerDialog? _prayerDialog;
    private string? _openPrayerTitle;
    private string? _openPrayerHtml;
    private string? _openExplanationHtml;

    // When true, the thread shows each prayer's Latin name (and the book opens its Latin text). Only offered when the devotion declares LatinAvailable.
    private bool _showLatin;

    private async Task SetLatin(bool latin)
    {
        _showLatin = latin;
        await PrayerLanguage.SetAsync(latin);
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _session = null;
        _started = false;
        _savedProgress = null;
        _devotion = await Devotions.GetDevotionAsync(Id);

        // Restore the reader's remembered Latin/vernacular preference before the thread renders.
        await PrayerLanguage.InitializeAsync();
        _showLatin = PrayerLanguage.ShowLatin;

        // Reset chrome in case we arrived here directly from another devotion's praying view.
        await LeaveImmersiveAsync();

        if (_devotion is not null)
        {
            // A devotion that does not offer Latin must never render it, even if the reader's global preference
            // (remembered from, say, the Rosary) is Latin: otherwise individual prayers that happen to have a Latin translation would show in Latin with no way to switch back.
            if (!_devotion.LatinAvailable)
            {
                _showLatin = false;
            }

            _selectedSetId = _devotion.MysterySets.FirstOrDefault()?.Id;
            await LoadPrayersAsync(_devotion);

            // The session owns the thread and completion rules; create it once the prayers are loaded so the intro screen can already count a set's prayers for the resume banner.
            _session = new DevotionSession(_devotion, _prayers);

            // Surface any un-finished progress so the intro screen can offer Resume / Start over.
            _savedProgress = await Progress.LoadAsync(Id);
        }

        _loading = false;
    }

    // After marking a step prayed, hand keyboard focus to the new current step so pressing Space or Enter walks forward through the thread instead of toggling the just-prayed step off again.
    // When the last step is prayed there is no current step, so focus falls to the "Leave the devotion" link.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToCurrentStep)
        {
            _scrollToCurrentStep = false;

            try
            {
                await Navigation.CentreInParentAsync("devotion-current-step");
            }
            catch (JSDisconnectedException)
            {
                // Circuit going away during teardown; nothing to scroll.
            }
        }

        if (!_focusCurrentStep)
        {
            return;
        }

        _focusCurrentStep = false;

        try
        {
            await Navigation.FocusAsync("devotion-current-step");
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; nothing to focus.
        }
    }

    // Fetch every distinct prayer referenced anywhere in the sequence once, so the player can render each bead's text without further round trips.
    private async Task LoadPrayersAsync(Devotion devotion)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Collect(IEnumerable<DevotionStep> steps)
        {
            foreach (var step in steps)
            {
                if (!string.IsNullOrWhiteSpace(step.PrayerId))
                {
                    ids.Add(step.PrayerId);
                }

                Collect(step.PerMystery);
            }
        }

        Collect(devotion.Sequence);

        foreach (var id in ids)
        {
            var prayer = await Prayers.GetPrayerAsync(id);
            if (prayer is not null)
            {
                _prayers[id] = prayer;
            }
        }
    }

    // Begins from the intro screen: a non-null setId selects that mystery set first (multi-set devotions), while null keeps the default single set.
    private async Task BeginFromIntro(string? setId)
    {
        if (setId is not null)
        {
            _selectedSetId = setId;
        }

        await Begin();
    }

    // Starts (or resumes) praying the currently selected set. A non-zero startCompleted restores an earlier place in the thread; the value is clamped so a saved count can never exceed the rows.
    private async Task Begin(int startCompleted = 0)
    {
        _session!.Start(_selectedSetId, startCompleted);
        _started = true;

        // Resuming mid-thread: scroll the current step into view on the next render so the reader lands on their place rather than the top of a long devotion.
        if (_session.CompletedCount > 0 && !_session.IsComplete)
        {
            _scrollToCurrentStep = true;
        }

        await SaveProgressAsync();
        await EnterImmersiveAsync();
    }

    // Resumes the saved slot: reselect the stored set, rebuild the thread and restore the pointer.
    private async Task Resume()
    {
        if (_savedProgress is null)
        {
            await Begin();
            return;
        }

        _selectedSetId = _savedProgress.SetId ?? _selectedSetId;
        await Begin(_savedProgress.CompletedCount);
    }

    private async Task SaveProgressAsync() => await Progress.SaveAsync(new DevotionProgress(Id, _selectedSetId, _session!.CompletedCount));

    private async Task EnterImmersiveAsync()
    {
        try
        {
            await Immersive.EnterAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; nothing to toggle.
        }
    }

    private async Task LeaveImmersiveAsync()
    {
        try
        {
            await Immersive.LeaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; the class resets on next load anyway.
        }
    }

    // Marks the next prayer complete, or unmarks the most recently completed one. Completion can only move forward one step at a time, so nothing can be marked out of order.
    // Each change is persisted so leaving mid-devotion can be resumed; finishing the devotion clears the saved slot.
    private async Task ToggleComplete(int ordinal)
    {
        var result = _session!.Toggle(ordinal);

        switch (result)
        {
            case DevotionToggleResult.NoChange:
                return;

            case DevotionToggleResult.Advanced:
                // Keyboard focus is still on the step just prayed. Move it forward to the new current step after this render so Space/Enter advances the thread rather than un-marking it.
                _focusCurrentStep = true;
                _announcement = _session.DescribeCurrentStep();
                await SaveProgressAsync();
                break;

            case DevotionToggleResult.SteppedBack:
                _announcement = _session.DescribeCurrentStep();
                await SaveProgressAsync();
                break;

            case DevotionToggleResult.Completed:
                // The devotion is finished; nothing left to resume.
                _focusCurrentStep = true;
                _announcement = "Devotion complete.";
                await Progress.ClearAsync(Id);
                break;
        }
    }

    private async Task OpenPrayer(DevotionBead bead)
    {
        var useLatin = _showLatin && !string.IsNullOrWhiteSpace(bead.PrayerLatinHtml);
        _openPrayerTitle = useLatin && !string.IsNullOrWhiteSpace(bead.PrayerLatinTitle) ? bead.PrayerLatinTitle : bead.PrayerTitle;
        _openPrayerHtml = useLatin ? bead.PrayerLatinHtml : bead.PrayerHtml;
        _openExplanationHtml = bead.ExplanationHtml;
        if (_prayerDialog is not null)
        {
            await _prayerDialog.ShowAsync();
        }

        // Reading the words of the current step counts as praying it: mark it complete so opening the book keeps the thread moving without a separate tap on the step itself.
        if (bead.IsPrayer && bead.PrayerOrdinal == _session!.CompletedCount)
        {
            await ToggleComplete(bead.PrayerOrdinal);
        }
    }

    // Opens the info dialog for a section banner: an explanation only, with no words to pray and no completion side effect (a section is not a step the reader marks).
    private async Task OpenInfo(DevotionBead bead)
    {
        _openPrayerTitle = bead.Heading;
        _openPrayerHtml = null;
        _openExplanationHtml = bead.ExplanationHtml;
        if (_prayerDialog is not null)
        {
            await _prayerDialog.ShowAsync();
        }
    }

    private async Task ClosePrayer()
    {
        if (_prayerDialog is not null)
        {
            await _prayerDialog.CloseAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_prayerDialog is not null)
            {
                await _prayerDialog.CloseAsync();
            }

            await Immersive.LeaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone during teardown; nothing to close.
        }
    }
}
