@page "/discover/devotions/{Id}"
@implements IAsyncDisposable
@inject IDevotionService Devotions
@inject IPrayerService Prayers
@inject IBreadcrumbTrail Trail
@inject IDevotionProgressService Progress
@inject IPrayerLanguageService PrayerLanguage
@inject NavigationInterop Navigation
@inject ImmersiveInterop Immersive

<PageTitle>@(_devotion is null ? "Devotion" : $"{_devotion.Title} \u2014 Respondeo")</PageTitle>

@if (_devotion is not null)
{
    <SeoHead Title="@_devotion.Title" Description="@_devotion.Summary" Article="true" />
}

<Breadcrumb CurrentTitle="@(_devotion?.Title ?? "Devotion")"
            StageHref="discover"
            StageLabel="Discover"
            Crumbs="_crumbs" />

@if (_loading)
{
    <Loading>Preparing the devotion&hellip;</Loading>
}
else if (_devotion is null)
{
    <section class="content-article">
        <h1 class="pillar__title">Devotion not found</h1>
        <p class="empty-state">
            There is no devotion with the id &ldquo;<code>@Id</code>&rdquo;. <a href="discover/devotions">Return to all devotions</a>.
        </p>
    </section>
}
else if (!_started)
{
    @* Intro + mystery-set chooser, shown before the reader begins. *@
    <section class="content-article">
        <PillarHeader Title="@_devotion.Title" LedeText="@_devotion.Summary" />

        @if (_devotion.Draft)
        {
            @* This devotion is still being authored and vetted; warn the reader before they rely on it. *@
            <div class="devotion__draft-notice" role="note">
                <p class="devotion__draft-title">In progress &mdash; not yet vetted</p>
                <p>
                    This walkthrough is still being written and reviewed for accuracy. Texts and
                    explanations may be incomplete or change, so please don&rsquo;t rely on it as a
                    definitive guide just yet.
                </p>
            </div>
        }

        @if (_savedProgress is { CompletedCount: > 0 })
        {
            @* A previous visit was left un-finished; offer to pick up where they left off. Beginning
               any set below already starts fresh, so a single Resume action is all that's needed. *@
            <div class="devotion__resume" role="status">
                <Card Title="Resume where you left off"
                      Pill="In progress"
                      Summary="@ResumeText"
                      Cta="Resume &rarr;"
                      Level="2"
                      OnClick="Resume" />
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_devotion.IntroHtml))
        {
            <div class="devotion__intro-body">
                @((MarkupString)_devotion.IntroHtml)
            </div>
        }

        @if (_devotion.MysterySets.Count > 0)
        {
            <div class="devotion__sets">
                @if (_devotion.MysterySets.Count > 1)
                {
                    <h2 class="devotion__sets-title">Choose today's mysteries</h2>
                }
                <div class="devotion__set-options">
                    @foreach (var set in _devotion.MysterySets)
                    {
                        <Card Title="@set.Name"
                              Pill="@set.When"
                              Summary="@set.Summary"
                              Cta="Begin praying &rarr;"
                              Level="3"
                              OnClick="() => SelectAndBegin(set.Id)" />
                    }
                </div>
            </div>
        }
        else
        {
            <div class="devotion__set-options">
                <Card Title="Begin"
                      Summary="@_devotion.Summary"
                      Cta="Begin praying &rarr;"
                      Level="3"
                      OnClick="() => Begin()" />
            </div>
        }

        <BackLink Href="discover/devotions" Label="Back to all devotions" />
    </section>
}
else
{
    <section class="reading-wide devotion--praying">
        <p class="devotion__hint">Select each step to mark it prayed, in order. Open the book to read a prayer's words.</p>

        @if (_devotion.LatinAvailable)
        {
            <div class="devotion__lang devotion__lang--inline">
                @LanguageToggle
            </div>
        }

        @* Announces progress to screen readers as each step is prayed, without moving focus. *@
        <p class="sr-only" role="status" aria-live="polite">@_announcement</p>

        <ol class="devotion__list">
            @for (var i = 0; i < _session.Beads.Count; i++)
            {
                var step = _session.Beads[i];
                var itemDone = _session.IsItemDone(i);
                var itemCurrent = step.IsPrayer && step.PrayerOrdinal == _session.CompletedCount;
                <li class="devotion__step @(itemDone ? "is-done" : null) @(itemCurrent ? "is-current" : null)">
                    <span class="devotion__marker devotion__marker--@(step.BeadType ?? "none")" aria-hidden="true">
                        @if (step.BeadType == "cross")
                        {
                            <svg class="devotion__cross" viewBox="0 0 24 24">
                                <path d="M10.5 2h3v5h5v3h-5v12h-3V10h-5V7h5z" />
                            </svg>
                        }
                        else if (step.BeadType == "medal")
                        {
                            <svg class="devotion__medal" viewBox="0 0 24 24">
                                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15zm-.9 2.6v2.4H8.7v1.8h2.4v4.6h1.8v-4.6h2.4V9.5h-2.4V7.1z" />
                            </svg>
                        }
                        else if (step.BeadType == "between")
                        {
                            <span class="devotion__pip"></span>
                            <span class="devotion__pip"></span>
                            <span class="devotion__pip"></span>
                        }
                    </span>

                    <div class="devotion__step-body">
                        @if (step.IsSection)
                        {
                            <div class="devotion__section">
                                <h2 class="devotion__section-title">@step.Heading</h2>
                                @if (!string.IsNullOrWhiteSpace(step.ExplanationHtml))
                                {
                                    <button type="button"
                                            class="devotion__section-info"
                                            @onclick="() => OpenInfo(step)"
                                            aria-label="@($"About {step.Heading}")"
                                            title="About this part">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM11 11h2v6h-2z" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        }
                        else if (step.MysteryTitle is not null)
                        {
                            <div class="devotion__mystery">
                                @if (!string.IsNullOrWhiteSpace(step.Heading))
                                {
                                    <p class="eyebrow">@step.Heading</p>
                                }
                                <h2 class="devotion__mystery-title">@step.MysteryTitle</h2>
                                @if (!string.IsNullOrWhiteSpace(step.MysteryReflectionHtml))
                                {
                                    <div class="devotion__reflection">
                                        @((MarkupString)step.MysteryReflectionHtml)
                                    </div>
                                }
                            </div>
                        }
                        else if (step.IsPrayer)
                        {
                            var done = step.PrayerOrdinal < _session.CompletedCount;
                            var current = step.PrayerOrdinal == _session.CompletedCount;
                            var clickable = current || step.PrayerOrdinal == _session.CompletedCount - 1;
                            <div class="devotion__prayer-row @(done ? "is-done" : null) @(current ? "is-current" : null) @(!done && !current ? "is-upcoming" : null)">
                                <button type="button"
                                        id="@(current ? "devotion-current-step" : null)"
                                        class="devotion__prayer-main"
                                        @onclick="() => ToggleComplete(step.PrayerOrdinal)"
                                        disabled="@(!clickable)"
                                        aria-current="@(current ? "step" : null)"
                                        aria-label="@_session.PrayerStepLabel(step, done, current, PrayerName(step), PrayerNote(step))"
                                        aria-pressed="@done">
                                    <span class="devotion__prayer-name">
                                        @if (!string.IsNullOrWhiteSpace(step.Role))
                                        {
                                            <span class="devotion__role devotion__role--@step.Role" aria-hidden="true">@RoleLabel(step.Role)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(step.Heading) && step.Heading != step.PrayerTitle)
                                        {
                                            <span class="devotion__prayer-lead">@step.Heading</span>
                                        }
                                        @PrayerName(step)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(PrayerNote(step)))
                                    {
                                        <span class="devotion__prayer-note">@PrayerNote(step)</span>
                                    }
                                </button>
                                <button type="button"
                                        class="devotion__prayer-book"
                                        @onclick="() => OpenPrayer(step)"
                                        aria-label="@($"Read the words of {PrayerName(step)}")"
                                        title="Read the prayer">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 6.5C10.6 5.4 8.6 4.75 6.25 4.75c-1 0-1.95.12-2.75.32v12.6c.8-.2 1.75-.32 2.75-.32 2.35 0 4.35.65 5.75 1.75 1.4-1.1 3.4-1.75 5.75-1.75 1 0 1.95.12 2.75.32V5.07c-.8-.2-1.75-.32-2.75-.32C15.4 4.75 13.4 5.4 12 6.5zm0 0v11.5" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>

        <div class="devotion__exit">
            <a href="discover/devotions">Leave the devotion</a>
            @* Only reachable in immersive mode, where the masthead (and its theme toggle) is hidden;
               kept beside the exit link so it stays out of the prayer flow. Hidden by CSS elsewhere. *@
            <span class="devotion__exit-theme">
                @if (_devotion.LatinAvailable)
                {
                    <button type="button"
                            class="devotion__lang-mini @(_showLatin ? "is-latin" : null)"
                            role="switch"
                            aria-checked="@(_showLatin ? "true" : "false")"
                            aria-label="@(_showLatin ? "Showing Latin prayer names. Switch to English." : "Showing English prayer names. Switch to Latin.")"
                            title="@(_showLatin ? "Latin" : "English")"
                            @onclick="() => SetLatin(!_showLatin)">
                        <span class="devotion__lang-mini-text" aria-hidden="true">@(_showLatin ? "LA" : "EN")</span>
                    </button>
                }
                <ThemeToggle />
            </span>
        </div>
    </section>

    <Dialog @ref="_prayerDialog" Title="@_openPrayerTitle" Class="dialog--roomy" MaxWidth="38rem">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_openExplanationHtml))
            {
                <div class="devotion__explanation">
                    @((MarkupString)_openExplanationHtml)
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_openPrayerHtml))
            {
                @if (!string.IsNullOrWhiteSpace(_openExplanationHtml))
                {
                    <p class="devotion__explanation-words-label eyebrow">The words</p>
                }
                @((MarkupString)_openPrayerHtml)
            }
        </ChildContent>
        <Footer>
            @* A footer Close button so long prayers can be dismissed without scrolling back up to the X. *@
            <button type="button" class="btn" @onclick="ClosePrayer">Close</button>
        </Footer>
    </Dialog>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("devotions", "Devotions", Href: "discover/devotions")];

    private Devotion? _devotion;
    private bool _loading = true;
    private string? _selectedSetId;

    private readonly Dictionary<string, Prayer> _prayers = new(StringComparer.OrdinalIgnoreCase);

    // The live praying session: the expanded thread and in-order completion state. Null until the
    // devotion has loaded; _started switches the intro / set chooser for the praying view.
    private DevotionSession? _session;
    private bool _started;

    // Set when a step is marked prayed so the next render moves keyboard focus onto the new current
    // step (see ToggleComplete / OnAfterRenderAsync). Cleared once the focus has been handed over.
    private bool _focusCurrentStep;

    // Set when resuming an in-progress devotion mid-thread so the next render scrolls the current step
    // into view (the thread can be long, and the reader should land on their spot, not the top).
    private bool _scrollToCurrentStep;

    // Polite live-region text announcing progress to screen readers as steps are prayed. Non-visual
    // users otherwise get no feedback that a step was marked, or that the devotion is complete.
    private string? _announcement;

    // Saved progress for this devotion (from a previous, un-finished visit), if any. Drives the
    // Resume / Start over choice on the intro screen.
    private DevotionProgress? _savedProgress;

    // Summary line for the resume card, naming the saved mystery set (when there is one) and how far
    // along the reader was (e.g. "The Sorrowful Mysteries — 12 of 59 prayers complete."). The card's
    // title and "In progress" pill carry the rest of the meaning, so this stays purely descriptive.
    private string ResumeText
    {
        get
        {
            var saved = _savedProgress;
            if (saved is null || _devotion is null)
            {
                return "Pick up where you left off.";
            }

            var setName = _devotion.MysterySets.FirstOrDefault(s => s.Id == saved.SetId)?.Name;

            var total = _session?.CountPrayers(saved.SetId) ?? 0;
            var done = Math.Clamp(saved.CompletedCount, 0, total);

            // Set names already read as full titles ("The Sorrowful Mysteries").
            var progress = total > 0 ? $"{done} of {total} prayers complete." : "in progress.";

            return string.IsNullOrWhiteSpace(setName) ? $"You've prayed {progress}" : $"{setName} \u2014 {progress}";
        }
    }

    private Dialog? _prayerDialog;
    private string? _openPrayerTitle;
    private string? _openPrayerHtml;
    private string? _openExplanationHtml;

    // When true, the thread shows each prayer's Latin name (and the book opens its Latin text).
    // Only offered when the devotion declares LatinAvailable.
    private bool _showLatin;

    // The prayer's name in the active language: the Latin name when the Latin view is on and one
    // exists, otherwise the vernacular title.
    private string? PrayerName(DevotionBead step) =>
        _showLatin && !string.IsNullOrWhiteSpace(step.PrayerLatinTitle) ? step.PrayerLatinTitle : step.PrayerTitle;

    // The step's rubric in the active language: the Latin note when the Latin view is on and one
    // exists, otherwise the vernacular note.
    private string? PrayerNote(DevotionBead step) =>
        _showLatin && !string.IsNullOrWhiteSpace(step.NoteLatin) ? step.NoteLatin : step.Note;

    // A short "who says this" badge for liturgical steps: the versicle/response marks for priest and
    // people, or a readable word for the rest.
    private static string RoleLabel(string? role) => role switch
    {
        "priest" => "\u2123",   // ℣ — versicle
        "people" => "\u211F",   // ℟ — response
        "all" => "All",
        "reader" => "Reader",
        _ => string.Empty,
    };

    private async Task SetLatin(bool latin)
    {
        _showLatin = latin;
        await PrayerLanguage.SetAsync(latin);
    }

    // The English / Latin language picker, shared between the desktop (above the list) and mobile
    // (beside the theme toggle in the immersive exit row) placements so the two stay in sync.
    private RenderFragment LanguageToggle => __builder =>
    {
        <div class="devotion__lang-group" role="group" aria-label="Prayer language">
            <button type="button"
                    class="devotion__lang-btn @(!_showLatin ? "is-active" : null)"
                    @onclick="() => SetLatin(false)"
                    aria-pressed="@(!_showLatin)">
                English
            </button>
            <button type="button"
                    class="devotion__lang-btn @(_showLatin ? "is-active" : null)"
                    @onclick="() => SetLatin(true)"
                    aria-pressed="@_showLatin">
                Latin
            </button>
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _session = null;
        _started = false;
        _savedProgress = null;
        _devotion = await Devotions.GetDevotionAsync(Id);

        // Restore the reader's remembered Latin/vernacular preference before the thread renders.
        await PrayerLanguage.InitializeAsync();
        _showLatin = PrayerLanguage.ShowLatin;

        // Reset chrome in case we arrived here directly from another devotion's praying view.
        await LeaveImmersiveAsync();

        if (_devotion is not null)
        {
            // A devotion that does not offer Latin must never render it, even if the reader's global
            // preference (remembered from, say, the Rosary) is Latin: otherwise individual prayers
            // that happen to have a Latin translation would show in Latin with no way to switch back.
            if (!_devotion.LatinAvailable)
            {
                _showLatin = false;
            }

            _selectedSetId = _devotion.MysterySets.FirstOrDefault()?.Id;
            await LoadPrayersAsync(_devotion);

            // The session owns the thread and completion rules; create it once the prayers are loaded
            // so the intro screen can already count a set's prayers for the resume banner.
            _session = new DevotionSession(_devotion, _prayers);

            // Surface any un-finished progress so the intro screen can offer Resume / Start over.
            _savedProgress = await Progress.LoadAsync(Id);
        }

        _loading = false;
    }

    // After marking a step prayed, hand keyboard focus to the new current step so pressing Space or
    // Enter walks forward through the thread instead of toggling the just-prayed step off again. When
    // the last step is prayed there is no current step, so focus falls to the "Leave the devotion" link.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToCurrentStep)
        {
            _scrollToCurrentStep = false;

            try
            {
                await Navigation.CentreInParentAsync("devotion-current-step");
            }
            catch (JSDisconnectedException)
            {
                // Circuit going away during teardown; nothing to scroll.
            }
        }

        if (!_focusCurrentStep)
        {
            return;
        }

        _focusCurrentStep = false;

        try
        {
            await Navigation.FocusAsync("devotion-current-step");
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; nothing to focus.
        }
    }

    // Fetch every distinct prayer referenced anywhere in the sequence once, so the player can render
    // each bead's text without further round trips.
    private async Task LoadPrayersAsync(Devotion devotion)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Collect(IEnumerable<DevotionStep> steps)
        {
            foreach (var step in steps)
            {
                if (!string.IsNullOrWhiteSpace(step.PrayerId))
                {
                    ids.Add(step.PrayerId);
                }

                Collect(step.PerMystery);
            }
        }

        Collect(devotion.Sequence);

        foreach (var id in ids)
        {
            var prayer = await Prayers.GetPrayerAsync(id);
            if (prayer is not null)
            {
                _prayers[id] = prayer;
            }
        }
    }

    private async Task SelectAndBegin(string setId)
    {
        _selectedSetId = setId;
        await Begin();
    }

    // Starts (or resumes) praying the currently selected set. A non-zero startCompleted restores an
    // earlier place in the thread; the value is clamped so a saved count can never exceed the rows.
    private async Task Begin(int startCompleted = 0)
    {
        _session!.Start(_selectedSetId, startCompleted);
        _started = true;

        // Resuming mid-thread: scroll the current step into view on the next render so the reader
        // lands on their place rather than the top of a long devotion.
        if (_session.CompletedCount > 0 && !_session.IsComplete)
        {
            _scrollToCurrentStep = true;
        }

        // Persist the starting point so an immediate exit still leaves something to resume.
        await SaveProgressAsync();

        // Enter immersive mode so the layout can hand the praying view the full screen on mobile.
        await EnterImmersiveAsync();
    }

    // Resumes the saved slot: reselect the stored set, rebuild the thread and restore the pointer.
    private async Task Resume()
    {
        if (_savedProgress is null)
        {
            await Begin();
            return;
        }

        _selectedSetId = _savedProgress.SetId ?? _selectedSetId;
        await Begin(_savedProgress.CompletedCount);
    }

    private async Task SaveProgressAsync() => await Progress.SaveAsync(new DevotionProgress(Id, _selectedSetId, _session!.CompletedCount));

    private async Task EnterImmersiveAsync()
    {
        try
        {
            await Immersive.EnterAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; nothing to toggle.
        }
    }

    private async Task LeaveImmersiveAsync()
    {
        try
        {
            await Immersive.LeaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit going away during teardown; the class resets on next load anyway.
        }
    }

    // Marks the next prayer complete, or unmarks the most recently completed one. Completion can only
    // move forward one step at a time, so nothing can be marked out of order. Each change is persisted
    // so leaving mid-devotion can be resumed; finishing the devotion clears the saved slot.
    private async Task ToggleComplete(int ordinal)
    {
        var result = _session!.Toggle(ordinal);

        switch (result)
        {
            case DevotionToggleResult.NoChange:
                return;

            case DevotionToggleResult.Advanced:
                // Keyboard focus is still on the step just prayed. Move it forward to the new current
                // step after this render so Space/Enter advances the thread rather than un-marking it.
                _focusCurrentStep = true;
                _announcement = _session.DescribeCurrentStep();
                await SaveProgressAsync();
                break;

            case DevotionToggleResult.SteppedBack:
                _announcement = _session.DescribeCurrentStep();
                await SaveProgressAsync();
                break;

            case DevotionToggleResult.Completed:
                // The devotion is finished; nothing left to resume.
                _focusCurrentStep = true;
                _announcement = "Devotion complete.";
                await Progress.ClearAsync(Id);
                break;
        }
    }

    private async Task OpenPrayer(DevotionBead bead)
    {
        var useLatin = _showLatin && !string.IsNullOrWhiteSpace(bead.PrayerLatinHtml);
        _openPrayerTitle = useLatin && !string.IsNullOrWhiteSpace(bead.PrayerLatinTitle) ? bead.PrayerLatinTitle : bead.PrayerTitle;
        _openPrayerHtml = useLatin ? bead.PrayerLatinHtml : bead.PrayerHtml;
        _openExplanationHtml = bead.ExplanationHtml;
        if (_prayerDialog is not null)
        {
            await _prayerDialog.Show();
        }

        // Reading the words of the current step counts as praying it: mark it complete so opening the
        // book keeps the thread moving without a separate tap on the step itself.
        if (bead.IsPrayer && bead.PrayerOrdinal == _session!.CompletedCount)
        {
            await ToggleComplete(bead.PrayerOrdinal);
        }
    }

    // Opens the info dialog for a section banner: an explanation only, with no words to pray and no
    // completion side effect (a section is not a step the reader marks).
    private async Task OpenInfo(DevotionBead bead)
    {
        _openPrayerTitle = bead.Heading;
        _openPrayerHtml = null;
        _openExplanationHtml = bead.ExplanationHtml;
        if (_prayerDialog is not null)
        {
            await _prayerDialog.Show();
        }
    }

    private async Task ClosePrayer()
    {
        if (_prayerDialog is not null)
        {
            await _prayerDialog.Close();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_prayerDialog is not null)
            {
                await _prayerDialog.Close();
            }

            await Immersive.LeaveAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone during teardown; nothing to close.
        }
    }
}
