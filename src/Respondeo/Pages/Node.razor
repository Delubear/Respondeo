@page "/{Stage}/{Id}"
@inject IContentService Content
@inject NavigationManager Nav
@inject IBreadcrumbTrail Trail
@inject IVisitedNodes Visited

@if (_node is not null)
{
    <PageTitle>@_node.Title &mdash; Respondeo</PageTitle>
    <SeoHead Title="@_node.Title" Description="@_node.Summary" Article="true" />
}

<Breadcrumb Crumbs="_breadcrumb.Ancestors" CurrentTitle="@_breadcrumb.CurrentTitle" StageHref="@_breadcrumb.RootHref" StageLabel="@_breadcrumb.RootLabel" />

@if (_loading)
{
    <Loading>Loading&hellip;</Loading>
}
else if (_node is null)
{
    <section class="content-article">
        <h1 class="pillar__title">This path hasn't been written yet</h1>
        <p class="empty-state">There is no content node with the id "<code>@Id</code>". <a href="">Return to the start</a>.</p>
    </section>
}
else
{
    <NodeArticle Node="_node" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    // Captured from the "/{Stage}/{Id}" route. Not used for lookup (the id is the key); it is present so the stage-scoped URL resolves to this page and so a mismatched stage can be redirected to the node's canonical URL.
    [Parameter] public string? Stage { get; set; }

    private InquiryNode? _node;
    private bool _loading = true;
    private BreadcrumbContext _breadcrumb = BreadcrumbContext.ForCurrent(null);

    protected override async Task OnParametersSetAsync()
    {
        // Resolve everything into locals before touching the fields the UI binds to.
        // Content is typically cached, so swapping atomically at the end keeps the current node on screen during the load instead of blanking to the spinner,
        // which removes the flash/flicker when moving between nodes.
        var node = await Content.GetByIdAsync(Id);

        // Keep URLs canonical: the stage segment is cosmetic, so a mismatched (or missing) stage in the URL would show the wrong breadcrumb root.
        // When the URL's stage doesn't match the node's real stage, redirect to the node's canonical URL,
        // preserving any query string (e.g. ?section=...) so deep links keep working across the redirect.
        if (node is not null && !string.Equals(Stage ?? string.Empty, node.Stage ?? string.Empty, StringComparison.OrdinalIgnoreCase))
        {
            var query = new Uri(Nav.Uri).Query;
            Nav.NavigateTo(ContentRoutes.NodeHref(node) + query, replace: true);
            return;
        }

        IReadOnlyList<Breadcrumb.Crumb> crumbs = Array.Empty<Breadcrumb.Crumb>();

        if (node is not null)
        {
            await Visited.MarkVisitedAsync(Id);
            crumbs = await BuildBreadcrumbAsync(Id, node.Stage);
        }

        _node = node;

        // When the node belongs to a stage, root the breadcrumb at that stage's landing page instead of Home so it reflects the section.
        string? stageHref = null;
        string? stageLabel = null;
        if (node?.Stage is { Length: > 0 } stage)
        {
            stageHref = stage;
            stageLabel = SiteNavigation.Items.FirstOrDefault(i => string.Equals(i.Href, stage, StringComparison.OrdinalIgnoreCase))?.Label ?? node.Stage;
        }

        _breadcrumb = new BreadcrumbContext(node?.Title, crumbs, stageHref, stageLabel);
        _loading = false;
    }

    private async Task<IReadOnlyList<Breadcrumb.Crumb>> BuildBreadcrumbAsync(string id, string? stage)
    {
        // The trail resets per stage, so every node it returns belongs to the current stage.
        var trail = await Trail.VisitAsync(id, stage);

        // The trail includes the current node as its last element; the rest are ancestors.
        var crumbs = new List<Breadcrumb.Crumb>(trail.Count);
        for (var i = 0; i < trail.Count - 1; i++)
        {
            var ancestor = await Content.GetByIdAsync(trail[i]);
            crumbs.Add(new Breadcrumb.Crumb(trail[i], ancestor?.Title ?? trail[i], ancestor?.Stage));
        }

        return crumbs;
    }
}
