@page "/summa/{Id}"
@implements IDisposable
@inject ISummaService Summa
@inject ISummaPartCatalog Parts
@inject ISummaReferenceRenderer References
@inject IBreadcrumbTrail Trail
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_question is null ? "Summa Theologiae" : $"{_question.Title} — Summa Theologiae")</PageTitle>

@if (_question is not null)
{
    <SeoHead Title="@_question.Title" Description="@SeoDescription" Article="true" />
}

<Breadcrumb CurrentTitle="@(_question?.Title ?? "Question")"
            StageHref="summa"
            StageLabel="Summa Theologiae"
            Crumbs="_crumbs"
            BackHref="@_backHref"
            BackLabel="@_backLabel" />

@if (_loading)
{
    <Loading>Turning to the question&hellip;</Loading>
}
else if (_question is null)
{
    <section class="summa-question">
        <h1 class="summa-question__title">Question not found</h1>
        <p class="summa-question__missing">
            That question is not part of the Summa. <a href="summa">Return to the Summa</a>.
        </p>
    </section>
}
else
{
    <article class="summa-question">
        <header class="summa-question__header">
            <p class="summa-question__eyebrow">@PartTitle@(string.IsNullOrWhiteSpace(_treatise) ? null : $" · {_treatise}") @(_question.IsPrologue ? $"· {_question.Title}" : $"· Question {_question.Number}")</p>
            <h1 class="summa-question__title">@_question.Title</h1>
        </header>

        <SummaGuide />

        @if (!string.IsNullOrWhiteSpace(_question.PrologueHtml))
        {
            <div class="summa-question__prologue">
                @((MarkupString)References.Expand(_question.PrologueHtml))
            </div>
        }

        @if (!_question.IsPrologue)
        {
        <nav class="summa-question__toc" aria-label="Articles in this question">
            <ol class="summa-question__toc-list">
                @foreach (var article in _question.Articles)
                {
                    <li class="summa-question__toc-item">
                        <a href="@($"summa/{Id}#article-{article.Number}")"
                           @onclick="() => OpenArticleAsync(article.Number)"
                           @onclick:preventDefault="true">
                            Article @article.Number. @article.Title
                        </a>
                    </li>
                }
            </ol>
        </nav>

        @foreach (var article in _question.Articles)
        {
            <details class="summa-article"
                     id="@($"article-{article.Number}")"
                     open="@_openArticles.Contains(article.Number)">
                <summary class="summa-article__summary"
                         @onclick="() => ToggleArticle(article.Number)"
                         @onclick:preventDefault="true">
                    <span class="summa-article__label">
                        <span class="summa-article__number">Article @article.Number</span>
                        <span class="summa-article__title">@article.Title</span>
                    </span>
                    <span class="summa-article__marker" aria-hidden="true">@(_openArticles.Contains(article.Number) ? "\u2212" : "+")</span>
                </summary>
                <div class="summa-article__body">
                    @if (!string.IsNullOrEmpty(article.PreambleHtml))
                    {
                        @((MarkupString)References.Expand(article.PreambleHtml, article.Number))
                    }
                    @foreach (var objection in article.Objections)
                    {
                        @((MarkupString)References.Expand(objection.Html, article.Number))
                    }
                    @if (!string.IsNullOrEmpty(article.SedContraHtml))
                    {
                        @((MarkupString)References.Expand(article.SedContraHtml, article.Number))
                    }
                    @if (!string.IsNullOrEmpty(article.RespondeoHtml))
                    {
                        @((MarkupString)References.Expand(article.RespondeoHtml, article.Number))
                    }
                    @foreach (var reply in article.Replies)
                    {
                        @((MarkupString)References.Expand(reply.Html, article.Number))
                    }
                </div>
            </details>
        }
        }

        <nav class="summa-question__pager" aria-label="Question navigation">
            <a class="summa-question__back" href="summa">&larr; All questions</a>
        </nav>
    </article>

    <SummaAttribution />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private SummaQuestionContent? _question;
    private string PartTitle = string.Empty;
    private string? _treatise;
    private bool _loading = true;
    private bool _scrolledToFragment;

    // A concise meta description built from the question's articles, so search results summarize the
    // specific points Aquinas treats rather than repeating the generic Summa description.
    private string SeoDescription
    {
        get
        {
            if (_question is null)
            {
                return SiteMeta.DefaultDescription;
            }

            var articles = string.Join("; ", _question.Articles.Select(a => a.Title));
            if (_question.IsPrologue)
            {
                return $"{PartTitle} · Prologue: {_question.Title}. From St. Thomas Aquinas's Summa Theologiae.";
            }

            return string.IsNullOrWhiteSpace(articles)
                ? $"{PartTitle} · Question {_question.Number}: {_question.Title}. From St. Thomas Aquinas's Summa Theologiae."
                : $"{_question.Title} — St. Thomas Aquinas asks: {articles}.";
        }
    }

    // The ancestor crumbs shown between the Summa root and this question. Currently a single Part
    // crumb (e.g. "First Part") linking to that part's landing page, so the Summa breadcrumb mirrors
    // the part -> question hierarchy the way node breadcrumbs mirror their trail.
    private IReadOnlyList<Breadcrumb.Crumb> _crumbs = Array.Empty<Breadcrumb.Crumb>();

    // Articles render as collapsible panels, all closed on load; multiple may be open at once. Only
    // this ephemeral open-set drives expansion. The shareable state stays the "#article-N" fragment,
    // written by the TOC and consumed on deep-link arrival, so links keep working without encoding
    // the full open-set in the URL.
    private readonly HashSet<int> _openArticles = new();

    // When the reader arrived here by clicking a cross-reference, a "back" breadcrumb links to the
    // exact article they jumped from (recorded client-side at click time in site.js).
    private string? _backHref;
    private string? _backLabel;

    private DotNetObjectReference<SummaQuestion>? _selfRef;

    protected override void OnInitialized()
    {
        // Same-question reference links only change the "#article-N" fragment, which doesn't retrigger
        // OnParametersSetAsync or a full render. Listen for location changes so an in-page deep link
        // still opens (and scrolls to) its target article.
        Nav.LocationChanged += OnLocationChanged;
    }

    // Invoked from the delegated summa-ref click listener in site.js for a reference that stays within
    // this question. Fragment-only clicks on the raw injected anchors don't reliably fire a Blazor
    // navigation, so JS calls straight into the component to open and reveal the target fragment. The
    // fragment may be a bare article ("article-3") or a sub-anchor within it ("article-3-reply-2").
    [JSInvokable]
    public async Task OpenArticleFromReference(string fragment)
    {
        await JS.InvokeVoidAsync("respondeoUrl.replace", $"summa/{Id}#{fragment}");

        if (TryGetArticleNumber(fragment, out var articleNumber) && _openArticles.Add(articleNumber))
        {
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("respondeoScroll.intoView", fragment);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_loading || _question is null)
        {
            return;
        }

        _ = OpenFragmentTargetAsync();
    }

    // Extracts the owning article number from a fragment, whether bare ("article-3") or a sub-anchor
    // such as "article-3-reply-2" / "article-3-objection-1" / "article-3-contra".
    private static bool TryGetArticleNumber(string fragment, out int articleNumber)
    {
        articleNumber = 0;
        if (!fragment.StartsWith("article-", StringComparison.Ordinal))
        {
            return false;
        }

        var rest = fragment["article-".Length..];
        var end = rest.IndexOf('-');
        var digits = end < 0 ? rest : rest[..end];
        return int.TryParse(digits, out articleNumber);
    }

    // Opens the article named by the current fragment (if any) and scrolls it into view.
    // Safe to call repeatedly: it only rerenders when the article wasn't already open.
    private async Task OpenFragmentTargetAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (string.IsNullOrEmpty(fragment))
        {
            return;
        }

        if (TryGetArticleNumber(fragment, out var articleNumber) && _openArticles.Add(articleNumber))
        {
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("respondeoScroll.intoView", fragment);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _selfRef?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Keep URLs canonical: a hand-typed id like "prima-q1" (or "Prima-Q1") should resolve to the
        // padded, lower-cased "prima-q001". Redirect once to the canonical form, preserving any
        // "#article-N" fragment so deep links survive, before loading the question.
        var canonical = Parts.Canonicalize(Id);
        if (canonical is not null)
        {
            var fragment = new Uri(Nav.Uri).Fragment;
            Nav.NavigateTo($"summa/{canonical}{fragment}", replace: true);
            return;
        }

        _loading = true;
        _scrolledToFragment = false;
        _openArticles.Clear();
        _question = await Summa.GetQuestionAsync(Parts.ToStorageId(Id));
        await ResolvePartContextAsync();
        _crumbs = BuildPartCrumbs(_question);
        await ResolveReferenceOriginAsync();
        _loading = false;
    }

    // Builds the Part ancestor crumb from the question's part id, linking to that part's landing page.
    // Falls back to no crumb when the question or its part is unknown.
    private IReadOnlyList<Breadcrumb.Crumb> BuildPartCrumbs(SummaQuestionContent? question)
    {
        if (question is null)
        {
            return Array.Empty<Breadcrumb.Crumb>();
        }

        var part = Parts.ByStorageKey(question.PartId);
        if (part is null)
        {
            return Array.Empty<Breadcrumb.Crumb>();
        }

        return [new Breadcrumb.Crumb(part.Key, part.Title, Href: ContentRoutes.SummaPartHref(part.Slug))];
    }

    // Reads (and consumes) the cross-reference origin recorded when a summa-ref link was clicked. If
    // present and it points at a different question than the one now shown, it becomes a back crumb
    // deep-linking to the origin article so the reader returns to where they were.
    private async Task ResolveReferenceOriginAsync()
    {
        _backHref = null;
        _backLabel = null;

        var origin = await JS.InvokeAsync<ReferenceOrigin?>("respondeoSummaRef.read");
        if (origin is null || string.IsNullOrEmpty(origin.QuestionId))
        {
            return;
        }

        // Consume it so a later refresh or normal browse doesn't keep showing the back crumb.
        await JS.InvokeVoidAsync("respondeoSummaRef.clear");

        // A self-reference (shouldn't happen since site.js filters it) offers nothing to go back to.
        if (string.Equals(origin.QuestionId, Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _backHref = origin.ArticleNumber is int articleNumber
            ? $"summa/{origin.QuestionId}#article-{articleNumber}"
            : $"summa/{origin.QuestionId}";
        _backLabel = $"\u2190 {origin.Label}";
    }

    private sealed record ReferenceOrigin(string QuestionId, int? ArticleNumber, string Label);

    // Toggles a panel open/closed from its own summary. Prevents the native <details> toggle so our
    // set stays the single source of truth for the open/closed marker.
    private void ToggleArticle(int articleNumber)
    {
        if (!_openArticles.Remove(articleNumber))
        {
            _openArticles.Add(articleNumber);
        }
    }

    // Opens the chosen article (leaving any others as they are), updates the shareable URL fragment,
    // and smoothly scrolls it into view. Used by the table of contents.
    private async Task OpenArticleAsync(int articleNumber)
    {
        _openArticles.Add(articleNumber);
        var fragment = $"article-{articleNumber}";
        await JS.InvokeVoidAsync("respondeoUrl.replace", $"summa/{Id}#{fragment}");
        StateHasChanged();
        await JS.InvokeVoidAsync("respondeoScroll.intoView", fragment);
    }

    // The articles render only after the question content loads, so a "#article-N" fragment in the
    // URL has nothing to open/scroll to at initial navigation. Once the content is on the page, open
    // the target article and scroll to it once.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("respondeoSummaRef.registerPage", _selfRef);
        }

        if (_loading || _question is null || _scrolledToFragment)
        {
            return;
        }

        _scrolledToFragment = true;
        await OpenFragmentTargetAsync();
    }

    // The question content stores only the part id; look up the display title and treatise from the index.
    private async Task ResolvePartContextAsync()
    {
        _treatise = null;

        if (_question is null)
        {
            PartTitle = string.Empty;
            return;
        }

        var index = await Summa.GetIndexAsync();
        var part = index.Parts.FirstOrDefault(p =>
            string.Equals(p.Id, _question.PartId, StringComparison.OrdinalIgnoreCase));
        PartTitle = part?.Title ?? string.Empty;

        _treatise = part?.Questions
            .FirstOrDefault(q => string.Equals(q.Id, _question.Id, StringComparison.OrdinalIgnoreCase))
            ?.Treatise;
    }
}
