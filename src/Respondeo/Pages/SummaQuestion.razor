@page "/summa/{Id}"
@implements IDisposable
@inject ISummaService Summa
@inject ISummaPartCatalog Parts
@inject ISummaReferenceRenderer References
@inject SummaQuestionPresenter Presenter
@inject IBreadcrumbTrail Trail
@inject NavigationManager Nav
@inject NavigationInterop Navigation
@inject SummaRefInterop SummaRef
@inject ScrollCoordinator Scroll

<PageShell Title="@_question?.Title" FallbackTitle="Question" Description="@_seoDescription" Article="true" SeoReady="@(_question is not null)"
           TabTitle="@SiteMeta.JoinTitle(_question?.Title, "Summa Theologiae")"
           StageHref="summa" StageLabel="Summa Theologiae" Crumbs="_crumbs" BackHref="@_backHref" BackLabel="@_backLabel" />

@if (_loading)
{
    <Loading>Turning to the question&hellip;</Loading>
}
else if (_question is null)
{
    <ItemNotFound Title="Question not found" BackHref="summa" BackLabel="Return to the Summa" Class="content-article--empty">
        That question is not part of the Summa.
    </ItemNotFound>
}
else
{
    <article id="question-top" class="content-article summa-question" @key="_question.Id">
        <PillarHeader Eyebrow="@($"{PartTitle}{(string.IsNullOrWhiteSpace(_treatise) ? null : $" \u00B7 {_treatise}")} {(_question.IsPrologue ? $"\u00B7 {_question.Title}" : $"\u00B7 Question {_question.Number}")}")"
                      Title="@_question.Title" />

        @if (!string.IsNullOrWhiteSpace(_question.PrologueHtml))
        {
            <div class="summa-question__prologue">
                @((MarkupString)References.Expand(_question.PrologueHtml))
            </div>
        }

        @if (!_question.IsPrologue)
        {
        <nav class="summa-question__toc" aria-label="Articles in this question">
            <ol class="summa-question__toc-list">
                @foreach (var article in _question.Articles)
                {
                    <li class="summa-question__toc-item">
                        <a href="@($"summa/{Id}#article-{article.Number}")" @onclick="() => OpenArticleAsync(article.Number)" @onclick:preventDefault="true">
                            Article @article.Number. @article.Title
                        </a>
                    </li>
                }
            </ol>
        </nav>

        <div class="accordion">
        @foreach (var article in _question.Articles)
        {
            <AccordionItem Mode="AccordionItem.AccordionTriggerMode.Details"
                           Open="_openArticles.Contains(article.Number)"
                           Id="@($"article-{article.Number}")"
                           Eyebrow="@($"Article {article.Number}")"
                           Title="@article.Title"
                           OnToggle="() => ToggleArticle(article.Number)">
                @if (!string.IsNullOrEmpty(article.PreambleHtml))
                {
                    @((MarkupString)References.Expand(article.PreambleHtml, article.Number))
                }
                @foreach (var objection in article.Objections)
                {
                    @((MarkupString)References.Expand(objection.Html, article.Number))
                }
                @if (!string.IsNullOrEmpty(article.SedContraHtml))
                {
                    @((MarkupString)References.Expand(article.SedContraHtml, article.Number))
                }
                @if (!string.IsNullOrEmpty(article.RespondeoHtml))
                {
                    @((MarkupString)References.Expand(article.RespondeoHtml, article.Number))
                }
                @foreach (var reply in article.Replies)
                {
                    @((MarkupString)References.Expand(reply.Html, article.Number))
                }
            </AccordionItem>
        }
        </div>
        }

        <BackLink Href="summa" Label="All questions" />
        <SummaAttribution />
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private SummaQuestionContent? _question;
    private string PartTitle = string.Empty;
    private string? _treatise;
    private bool _loading = true;
    private bool _landPending;

    // Concise meta description for this question, assembled by the presenter from the question's articles so search results summarize the specific points Aquinas treats.
    private string _seoDescription = SiteMeta.DefaultDescription;

    // The ancestor crumbs shown between the Summa root and this question.
    // Currently a single Part crumb (e.g. "First Part") linking to that part's landing page,
    // so the Summa breadcrumb mirrors the part -> question hierarchy the way node breadcrumbs mirror their trail.
    private IReadOnlyList<Breadcrumb.Crumb> _crumbs = Array.Empty<Breadcrumb.Crumb>();

    // Articles render as collapsible panels, all closed on load; multiple may be open at once.
    // Only this ephemeral open-set drives expansion.
    // The shareable state stays the "#article-N" fragment, written by the TOC and consumed on deep-link arrival, so links keep working without encoding the full open-set in the URL.
    private readonly HashSet<int> _openArticles = new();

    // When the reader arrived here by clicking a cross-reference, a "back" breadcrumb links to the exact article they jumped from (recorded client-side at click time in site.js).
    private string? _backHref;
    private string? _backLabel;

    private DotNetObjectReference<SummaQuestion>? _selfRef;

    protected override void OnInitialized()
    {
        // Same-question reference links only change the "#article-N" fragment, which doesn't retrigger OnParametersSetAsync or a full render.
        // Listen for location changes so an in-page deep link still opens (and scrolls to) its target article.
        Nav.LocationChanged += OnLocationChanged;
    }

    // Invoked from the delegated summa-ref click listener in site.js for a reference that stays within this question.
    // Fragment-only clicks on the raw injected anchors don't reliably fire a Blazor navigation, so JS calls straight into the component to open and reveal the target fragment.
    // The fragment may be a bare article ("article-3") or a sub-anchor within it ("article-3-reply-2").
    [JSInvokable]
    public async Task OpenArticleFromReference(string fragment)
    {
        await Navigation.ReplaceUrlAsync($"summa/{Id}#{fragment}");

        if (SummaFragment.TryGetArticleNumber(fragment, out var articleNumber) && _openArticles.Add(articleNumber))
        {
            StateHasChanged();
        }

        await Navigation.RevealAsync(fragment);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_loading || _question is null)
        {
            return;
        }

        // A link to a different question fires this before the new question loads; let the normal load path handle it.
        var path = Nav.ToBaseRelativePath(e.Location).Split('#', '?')[0];
        if (!string.Equals(path, $"summa/{Id}", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = OpenFragmentTargetAsync();
    }

    // Opens the article named by the current fragment (if any) and scrolls it into view.
    // Safe to call repeatedly: it only rerenders when the article wasn't already open.
    private async Task OpenFragmentTargetAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        if (string.IsNullOrEmpty(fragment))
        {
            return;
        }

        if (SummaFragment.TryGetArticleNumber(fragment, out var articleNumber) && _openArticles.Add(articleNumber))
        {
            StateHasChanged();
        }

        await Navigation.RevealAsync(fragment);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _selfRef?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Keep URLs canonical: a hand-typed id like "prima-q1" (or "Prima-Q1") should resolve to the padded, lower-cased "prima-q001".
        // Redirect once to the canonical form, preserving any "#article-N" fragment so deep links survive, before loading the question.
        var canonical = Parts.Canonicalize(Id);
        if (canonical is not null)
        {
            var fragment = new Uri(Nav.Uri).Fragment;
            Nav.NavigateTo($"summa/{canonical}{fragment}", replace: true);
            return;
        }

        // Same as an Inquiry node: hold the default landing until the new question has rendered.
        Scroll.Defer();
        _landPending = true;

        var question = await Summa.GetQuestionAsync(Parts.ToStorageId(Id));
        var view = await Presenter.BuildAsync(question);

        _question = question;
        _openArticles.Clear();

        // Open a deep-linked article up front so it is part of the first full render and the anchor jump lands on it directly.
        if (SummaFragment.TryGetArticleNumber(new Uri(Nav.Uri).Fragment.TrimStart('#'), out var deepLinked))
        {
            _openArticles.Add(deepLinked);
        }

        // The presenter assembles the part context, SEO description, and ancestor part in one pass.
        PartTitle = view.PartTitle;
        _treatise = view.Treatise;
        _seoDescription = view.SeoDescription;
        _crumbs = BuildPartCrumbs(view.Part);

        // Resolve the back crumb synchronously so a cached question renders complete in one pass (no second render, no flicker).
        (_backHref, _backLabel) = Presenter.BuildBackCrumb(SummaRef.TakeOrigin(), Id);
        _loading = false;
    }

    // Maps the presenter's Part ancestor into a plain (non-linked) breadcrumb crumb; there is no dedicated part landing page. Falls back to no crumb when the part is unknown.
    private static IReadOnlyList<Breadcrumb.Crumb> BuildPartCrumbs(SummaPart? part)
    {
        return part is null ? Array.Empty<Breadcrumb.Crumb>() : [new Breadcrumb.Crumb(part.Key, part.Title, Plain: true)];
    }

    // Toggles a panel open/closed from its own summary. Prevents the native <details> toggle so our set stays the single source of truth for the open/closed marker.
    private void ToggleArticle(int articleNumber)
    {
        if (!_openArticles.Remove(articleNumber))
        {
            _openArticles.Add(articleNumber);
        }
    }

    // Opens the chosen article (leaving any others as they are), updates the shareable URL fragment,
    // and smoothly scrolls it into view. Used by the table of contents.
    private async Task OpenArticleAsync(int articleNumber)
    {
        _openArticles.Add(articleNumber);
        var fragment = SummaFragment.ArticleAnchor(articleNumber);
        await Navigation.ReplaceUrlAsync($"summa/{Id}#{fragment}");
        StateHasChanged();
        await Navigation.RevealAsync(fragment);
    }

    // The articles render only after the question content loads, so a "#article-N" fragment in the URL has nothing to open/scroll to at initial navigation.
    // Once the content is on the page, open the target article and scroll to it once.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await SummaRef.RegisterPageAsync(_selfRef);
        }

        if (!_landPending || _loading)
        {
            return;
        }

        _landPending = false;

        // Land exactly like an Inquiry page, unless the URL names a deep-linked article.
        var fragment = new Uri(Nav.Uri).Fragment.TrimStart('#');
        await Scroll.ApplyDeferredAsync();
        if (!string.IsNullOrEmpty(fragment))
        {
            await Scroll.LandAtAsync(fragment);
        }
    }
}
