@page "/discover/articles/{Id}"
@inject IArticleService Articles

<DetailPage Loading="_loading" Id="@Id" Noun="Article" Title="@_article?.Title" Summary="@_article?.Summary"
            LoadingText="Opening the article…" StageHref="discover" StageLabel="Discover" Crumbs="_crumbs"
            ListHref="discover/articles" BackLabel="Back to all articles" NotFoundBackLabel="Return to all articles"
            IsUnvetted="@(_article?.IsUnvetted ?? false)" BodyHtml="@_article?.BodyHtml"
            Tags="@(_article?.Tags ?? [])" Sources="@(_article?.Sources ?? [])" />

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("articles", "Articles", Href: "discover/articles")];

    private Article? _article;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _article = await Articles.GetArticleAsync(Id);
        _loading = false;
    }
}
