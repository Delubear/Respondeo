@page "/bible/{TranslationCode}/{Book}"
@page "/bible/{TranslationCode}/{Book}/{Chapter:int}"
@inject IBibleChapterReader Reader
@inject IBreadcrumbTrail Trail
@inject IBibleTranslationService Translations
@inject NavigationManager Nav
@inject IBibleTranslations AllTranslations
@inject ScrollCoordinator Scroll

<PageShell Description="@($"{Heading} in the {_translation?.Name}.")" 
           SeoReady="@(!_loading)" TabTitle="@SiteMeta.JoinTitle(Heading, "Holy Bible")"
           StageHref="bible" StageLabel="Holy Bible" />

@if (_loading)
{
    <Loading>Opening the Scriptures&hellip;</Loading>
}
else if (_translation is null || _book is null || (_verses is null && !_unavailable))
{
    <ItemNotFound Title="Chapter not found" BackHref="bible" BackLabel="Return to the Bible" Class="content-article--empty">
        That chapter is not part of the @(_translation?.Name ?? "Bible").
    </ItemNotFound>
}
else
{
    <article @key="_fade.Generation" class="content-article bible-chapter @(_fade.Entered ? null : "fade-enter")">
        <PillarHeader Eyebrow="@(_translation.BookNameClarification(_book) is { } modern ? $"{_translation.ShortName} · {modern}" : _translation.ShortName)" Title="@Heading" />
        <BibleTranslationToggle Value="_translation" ValueChanged="OnTranslationChangedAsync" />
        <BibleChapterNav Book="_book" Translation="_translation" Current="Chapter" />

        @if (_unavailable)
        {
            <BibleUnavailableNotice Heading="@Heading" Translation="_translation" OnSwitch="OnTranslationChangedAsync" />
        }
        else if (_verses is not null)
        {
            <BibleChapterText Verses="_verses" Highlight="_highlight" />
        }

        <BiblePager Previous="Previous" Next="Next" OnNavigate="_fade.RequestReplay" />
    </article>
}

@code {
    [Parameter] public string Book { get; set; } = "";
    [Parameter] public int Chapter { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public string? VerseQuery { get; set; }
    [Parameter] public string TranslationCode { get; set; } = "";

    private BibleTranslation? _translation;
    private bool _unavailable;

    private bool _pendingScroll;
    private VerseSelection _highlight = VerseSelection.Empty;

    private BibleBook? _book;
    private IReadOnlyList<BibleVerse>? _verses;
    private bool _loading = true;

    private readonly ChapterFade _fade = new();

    private string? Heading => _book is null || _translation is null ? null : $"{_translation.BookName(_book)} {Chapter}";

    private ChapterLink? Previous => _book is null || _translation is null ? null : BibleChapterNavigation.Previous(_book, Chapter, _translation);

    private ChapterLink? Next => _book is null || _translation is null ? null : BibleChapterNavigation.Next(_book, Chapter, _translation);

    // Everything awaited before the state is ready completes synchronously when RoutePrefetcher has warmed the caches,
    // so the first render is the finished chapter; browser-storage writes (truly async JS calls) happen afterwards.
    protected override async Task OnParametersSetAsync()
    {
        if (_verses is null && !_unavailable) _loading = true;
        if (Chapter == 0) Chapter = 1;

        if (await AllTranslations.FindAsync(TranslationCode) is not { } requested)
        {
            _book = null;
            _verses = null;
            _unavailable = false;
            _loading = false;
            return;
        }

        var translation = requested;
        _fade.Arrive(Book);

        _book = translation.FindBook(Book);
        if (_book is null)
        {
            _verses = null;
            _unavailable = false;
            _loading = false;
            return;
        }

        var result = await Reader.LoadAsync(_book, Chapter, translation);

        _translation = translation;
        _verses = result.Verses;
        _unavailable = result.Unavailable;
        _loading = false;
        _highlight = VerseSelection.Parse(VerseQuery);
        _pendingScroll = !_highlight.IsEmpty && _verses is not null;
        if (_pendingScroll)
        {
            Scroll.Claim();
        }

        if (requested != Translations.Current) await Translations.SetAsync(requested);
    }

    private async Task OnTranslationChangedAsync(BibleTranslation translation)
    {
        await Translations.SetAsync(translation);
        if (_book is null) return;
        var chapter = Math.Min(Chapter, Math.Max(1, translation.ChapterCount(_book)));
        Nav.NavigateTo(translation.ChapterHref(_book, chapter, VerseQuery), replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Trail.ClearAsync();
        if (!_loading) _fade.MarkEntered();
        if (_pendingScroll && !_loading)
        {
            _pendingScroll = false;
            await Scroll.LandAtAsync($"v{_highlight.First}", center: true);
        }
    }

    // The fade plays only for the first chapter shown after arriving on this page (e.g. from the book list) or after
    // a pager click; chapter-link or translation switches swap the text in place without animation.
    private sealed class ChapterFade
    {
        private string? _book;
        private bool _replay;

        public bool Entered { get; private set; }

        // Bumped on every fade so the article is a new element; toggling the class on the same element can be
        // coalesced into one frame by the browser, which then never restarts the animation.
        public int Generation { get; private set; }

        public void RequestReplay() => _replay = true;

        public void Arrive(string book)
        {
            if (!_replay && string.Equals(_book, book, StringComparison.OrdinalIgnoreCase)) return;
            _replay = false;
            _book = book;
            Entered = false;
            Generation++;
        }

        public void MarkEntered() => Entered = true;
    }
}
