@page "/bible/{Book}"
@page "/bible/{Book}/{Chapter:int}"
@inject IBibleText Bible
@inject IBreadcrumbTrail Trail
@inject NavigationInterop Navigation
@inject IBibleTranslationService Translations
@inject NavigationManager Nav

<PageShell Description="@($"{Heading} in the {_translation.Name()}.")" 
           SeoReady="@(!_loading)" TabTitle="@SiteMeta.JoinTitle(Heading, "Holy Bible")"
           StageHref="bible" StageLabel="Holy Bible" />

@if (_loading)
{
    <Loading>Opening the Scriptures&hellip;</Loading>
}
else if (_book is null || (_verses is null && !_unavailable))
{
    <ItemNotFound Title="Chapter not found" BackHref="bible" BackLabel="Return to the Bible" Class="content-article--empty">
        That chapter is not part of the @_translation.Name().
    </ItemNotFound>
}
else
{
    <article class="content-article">
        <PillarHeader Eyebrow="@(_translation.BookNameClarification(_book) is { } modern ? $"{_translation.ShortName()} · {modern}" : _translation.ShortName())" Title="@Heading" />
        <BibleTranslationToggle Value="_translation" ValueChanged="OnTranslationChangedAsync" />
        <BibleChapterNav Book="_book" Translation="_translation" Current="Chapter" />

        @if (_unavailable)
        {
            <BibleUnavailableNotice Heading="@Heading" Translation="_translation" OnSwitch="OnTranslationChangedAsync" />
        }
        else if (_verses is not null)
        {
            <BibleChapterText Verses="_verses" Highlight="_highlight" />
        }

        <BiblePager Previous="Previous" Next="Next" />
    </article>
}

@code {
    [Parameter] public string Book { get; set; } = "";
    [Parameter] public int Chapter { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public string? VerseQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tr")] public string? TranslationCode { get; set; }

    private bool _translationLoaded;
    private BibleTranslation _translation;
    private bool _unavailable;

    private bool _pendingScroll;
    private VerseSelection _highlight = VerseSelection.Empty;

    private BibleBook? _book;
    private IReadOnlyList<BibleVerse>? _verses;
    private bool _loading = true;

    private string? Heading => _book is null ? null : $"{_translation.BookName(_book)} {Chapter}";

    private (string Href, string Label)? Previous
    {
        get
        {
            if (_book is null) return null;
            var count = _translation.ChapterCount(_book);
            if (Chapter > 1 && count > 0)
            {
                var target = Math.Min(Chapter - 1, count);
                return ($"bible/{_book.Slug}/{target}", $"{_translation.BookName(_book)} {target}");
            }

            var books = _translation.Books();
            var prior = BibleBooks.All.Take(IndexOf(_book)).LastOrDefault(books.Contains);
            if (prior is null) return null;
            var last = _translation.ChapterCount(prior);
            return ($"bible/{prior.Slug}/{last}", $"{_translation.BookName(prior)} {last}");
        }
    }

    private (string Href, string Label)? Next
    {
        get
        {
            if (_book is null) return null;
            if (Chapter < _translation.ChapterCount(_book)) return ($"bible/{_book.Slug}/{Chapter + 1}", $"{_translation.BookName(_book)} {Chapter + 1}");
            var books = _translation.Books();
            var following = BibleBooks.All.Skip(IndexOf(_book) + 1).FirstOrDefault(books.Contains);
            if (following is null) return null;
            return ($"bible/{following.Slug}/1", $"{_translation.BookName(following)} 1");
        }
    }

    private static int IndexOf(BibleBook book)
    {
        for (var i = 0; i < BibleBooks.All.Count; i++)
        {
            if (BibleBooks.All[i] == book) return i;
        }

        return -1;
    }

    protected override async Task OnInitializedAsync() => await Trail.ClearAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_verses is null && !_unavailable) _loading = true;
        if (Chapter == 0) Chapter = 1;
        _book = BibleBooks.Find(Book);
        if (!_translationLoaded)
        {
            await Translations.InitializeAsync();
            _translationLoaded = true;
        }

        if (BibleTranslations.Parse(TranslationCode) is { } requested && requested != Translations.Current)
        {
            await Translations.SetAsync(requested);
        }

        var translation = Translations.Current;
        IReadOnlyList<BibleVerse>? verses = null;
        var unavailable = false;
        if (_book is not null && Chapter >= 1 && Chapter <= _book.ChapterCount)
        {
            verses = await Bible.GetChapterAsync(_book.Slug, Chapter, translation);
            if (verses is null)
            {
                foreach (var other in Enum.GetValues<BibleTranslation>())
                {
                    if (other != translation && await Bible.GetChapterAsync(_book.Slug, Chapter, other) is not null)
                    {
                        unavailable = true;
                        break;
                    }
                }
            }
        }

        _translation = translation;
        _verses = verses;
        _unavailable = unavailable;
        _loading = false;
        _highlight = VerseSelection.Parse(VerseQuery);
        _pendingScroll = !_highlight.IsEmpty && _verses is not null;
    }

    private async Task OnTranslationChangedAsync(BibleTranslation translation)
    {
        await Translations.SetAsync(translation);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tr", translation.Code()), replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScroll && !_loading)
        {
            _pendingScroll = false;
            await Navigation.ScrollToVerseAsync($"v{_highlight.First}");
        }
    }
}
