@page "/discover/devotions"
@inject IDevotionService DevotionService
@inject DevotionBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageTitle>Devotions &mdash; Discover &mdash; Respondeo</PageTitle>

<SeoHead Title="Catholic Devotions"
         Description="Pray the Holy Rosary and the chaplets step by step with an interactive guide that carries you through each bead and mystery." />

<section class="pillar browse" data-browse-scroll="devotions">
    <PillarHeader Eyebrow="Pray, bead by bead" Title="Devotions">
        <Lede>
            Choose a devotion and pray it bead by bead. The guide keeps your place, announces each
            mystery, and counts the prayers so you can simply pray.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the devotions guide" />

    @if (_devotions is null)
    {
        <Loading>Gathering the devotions&hellip;</Loading>
    }
    else if (_devotions.Count == 0)
    {
        <p class="empty-state">No devotions are available yet.</p>
    }
    else
    {
        <SearchBox Id="devotion-search" Label="Search devotions" Placeholder="e.g. Rosary, chaplet, mercy..." Value="@_query" ValueChanged="OnSearchChanged" />

        <div class="filter-layout">
            <aside class="filter-rail">
                @if (_kinds.Count > 0)
                {
                    <TopicFilter Title="Kind" Topics="_kindLabels" Selected="_selectedKinds" SelectedChanged="OnKindsChanged" />
                }
                <ClearFiltersButton Active="_selectedKinds.Count > 0" OnClear="ClearFilters" />
            </aside>

            <FilterResults FilteredCount="Filtered.Count" TotalCount="_devotions?.Count ?? 0" Noun="devotions" EmptyMessage="No devotions match your search.">
                <Sort>
                    <SortSelect T="DevotionSummary" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var d in Filtered)
                    {
                        <Card Href="@ContentRoutes.DevotionHref(d.Id)" Title="@d.Title" Pills="@KindPills(d)" Summary="@d.Summary" Cta="Begin &rarr;" Level="2" />
                    }
                </ChildContent>
            </FilterResults>
        </div>
    }
</section>

@code {
    private IReadOnlyList<DevotionSummary>? _devotions;
    private string _query = string.Empty;

    private string _sortKey = _sortOptions[0].Key;

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
    private static readonly SortOption<DevotionSummary>[] _sortOptions =
    [
        new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(d => d.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(d => d.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    private IReadOnlyList<string> _kinds = [];
    private IReadOnlyList<string> _kindLabels = [];
    private IReadOnlySet<string> _selectedKinds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private BrowseSection _browse = default!;

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _browse = Browse.Section("discover/devotions", () => BrowseJs.ClearAsync("devotions"));
        _query = _browse.Query;
        _selectedKinds = new HashSet<string>(_browse.GetFilter("kind"), StringComparer.OrdinalIgnoreCase);

        var devotions = await DevotionService.GetIndexAsync();
        _devotions = devotions;

        _kinds = Browser.Kinds(_devotions);
        _kindLabels = Browser.KindLabels(_kinds);
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("devotions");
        }
    }

    private void OnSearchChanged(string value)
    {
        _query = value;
        _browse.Query = _query;
    }

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnKindsChanged(IReadOnlySet<string> selected)
    {
        _selectedKinds = selected;
        _browse.SetFilter("kind", selected);
    }

    private void ClearFilters()
    {
        _selectedKinds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _browse.SetFilter("kind", _selectedKinds);
    }

    // Turns a kind slug (e.g. "rosary") into a display tag (e.g. "Rosary").
    private IReadOnlyList<DevotionSummary> Filtered =>
        _devotions is null ? [] : Browser.Filter(_devotions, _query, _selectedKinds, _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0]);

    // The card's meta pills: the kind tag, plus an "In progress" flag for drafts still being vetted.
    private IReadOnlyList<string> KindPills(DevotionSummary d)
    {
        var pills = new List<string>();
        var kind = Browser.FormatKind(d.Kind);
        if (!string.IsNullOrWhiteSpace(kind))
        {
            pills.Add(kind);
        }

        if (d.Draft)
        {
            pills.Add("In progress");
        }

        return pills;
    }
}
