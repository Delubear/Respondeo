@page "/discover/devotions"
@inject IDevotionService DevotionService
@inject DevotionBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs

<PageShell Title="Catholic Devotions and Sacraments" TabTitle="Devotions and Sacraments"
         Description="Pray the Rosary and the chaplets, and walk through the Mass and Confession, step by step with an interactive guide that explains each moment." />

<section class="pillar browse" data-browse-scroll="devotions">
    <PillarHeader Eyebrow="Pray, step by step" Title="Devotions and Sacraments">
        <Lede>
            Pray the Rosary and the chaplets, or walk through the Mass and Confession. The guide keeps your
            place, explains what is happening and why, and gives you the words to say, so you can simply pray.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the devotions guide" />

    @if (_devotions is null)
    {
        <Loading>Gathering the devotions&hellip;</Loading>
    }
    else if (_devotions.Count == 0)
    {
        <p class="empty-state">No devotions are available yet.</p>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="devotion-search" Label="Search devotions" Placeholder="e.g. Rosary, chaplet, mercy..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
				@foreach (var (facet, title) in _rail)
				{
					@if (Options(facet).Count > 0)
					{
						<TopicFilter Title="@title" Topics="Options(facet)" Selected="Selected(facet.Key)" SelectedChanged="set => OnFacetChanged(facet.Key, set)" Counts="Counts(facet)" />
					}
				}
				<ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
</Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_devotions?.Count ?? 0" Noun="devotions" EmptyMessage="No devotions match your search.">
                <Sort>
                    <SortSelect T="DevotionSummary" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var d in Filtered)
                    {
                        <Card Href="@ContentRoutes.DevotionHref(d.Id)" Title="@d.Title" Pills="@KindPills(d)" Summary="@d.Summary" Cta="Begin &rarr;" Level="2" Status="@(d.Draft ? CardStatus.InProgress : CardStatus.None)" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
	// Optional shareable-link filters, e.g. discover/devotions?kind=chaplet. Read once on load; the URL is never updated.
	[SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
	[SupplyParameterFromQuery(Name = "kind")] public string[]? LinkKinds { get; set; }

	private IReadOnlyList<DevotionSummary>? _devotions;
	private Dictionary<string, IReadOnlyList<string>> _options = new();
	private readonly Dictionary<string, IReadOnlySet<string>> _selected = new();
	private string _sortKey = _sortOptions[0].Key;
	private BrowseSection _browse = default!;

	// The rail, in display order. Each facet's key is also its shareable-link query name (see the Link* parameters above).
	private static readonly (Facet<DevotionSummary> Facet, string Title)[] _rail = [ (DevotionBrowse.KindFacet, "Kind"), ];

	// Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync.
	private static readonly SortOption<DevotionSummary>[] _sortOptions =
	[
		new("title-asc", "Title (A\u2013Z)", rows => rows.OrderBy(d => d.SortValue, StringComparer.CurrentCultureIgnoreCase)),
		new("title-desc", "Title (Z\u2013A)", rows => rows.OrderByDescending(d => d.SortValue, StringComparer.CurrentCultureIgnoreCase)),
	];

	protected override async Task OnInitializedAsync()
	{
		await Trail.ClearAsync();
		_browse = Browse.Section("discover/devotions", () => BrowseJs.ClearAsync("devotions"));
		_browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?> { [DevotionBrowse.KindFacet.Key] = LinkKinds });
		foreach (var facet in DevotionBrowse.AllFacets)
		{
			_selected[facet.Key] = new HashSet<string>(_browse.GetFilter(facet.Key), StringComparer.OrdinalIgnoreCase);
		}

		_devotions = await DevotionService.GetIndexAsync();
		_options = DevotionBrowse.AllFacets.ToDictionary(f => f.Key, f => Browser.Options(_devotions, f));
	}

	// After the list first renders, ask JS to restore the remembered scroll position.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await BrowseJs.RestoreScrollAsync("devotions");
		}
	}

	private void OnSearchChanged(string value) => _browse.Query = value;

	private void OnSortChanged(string value) => _sortKey = value;

	private static readonly IReadOnlySet<string> None = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

	private IReadOnlyList<string> Options(Facet<DevotionSummary> facet) => _options.GetValueOrDefault(facet.Key) ?? [];

	private IReadOnlySet<string> Selected(string key) => _selected.GetValueOrDefault(key) ?? None;

	private void OnFacetChanged(string key, IReadOnlySet<string> selected)
	{
		_selected[key] = selected;
		_browse.SetFilter(key, selected);
	}

	private void ClearFilters()
	{
		_selected.Clear();
		_browse.Clear();
	}

	private SortOption<DevotionSummary> CurrentSort => _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];

	private IReadOnlyList<DevotionSummary> Filtered =>
		_devotions is null ? [] : Browser.Filter(_devotions, _browse.Query, Selected, CurrentSort);

	// Each facet's counts apply the search and every other facet, but not its own selection.
	private IReadOnlyDictionary<string, int> Counts(Facet<DevotionSummary> facet) =>
		FacetFilter.Counts(Browser.Filter(_devotions ?? [], _browse.Query, Selected, _sortOptions[0], exceptKey: facet.Key), facet);

	// The card's meta pills: just the kind tag. The draft/unvetted state is shown by the card's
	// "In progress" ribbon (via Status), so it is deliberately not duplicated as a pill here.
	private IReadOnlyList<string> KindPills(DevotionSummary d)
	{
		var pills = new List<string>();
		var kind = Browser.FormatKind(d.Kind);
		if (!string.IsNullOrWhiteSpace(kind))
		{
			pills.Add(kind);
		}

		return pills;
	}
}
