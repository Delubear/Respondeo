@page "/discover/devotions"
@inject IDevotionService DevotionService
@inject IBreadcrumbTrail Trail
@inject DiscoverBrowseState BrowseState
@inject IJSRuntime JS

<PageTitle>Devotions &mdash; Credo &mdash; Respondeo</PageTitle>

<SeoHead Title="Catholic Devotions"
         Description="Pray the Holy Rosary and the chaplets step by step with an interactive guide that carries you through each bead and mystery." />

<Breadcrumb CurrentTitle="Devotions"
            StageHref="discover"
            StageLabel="Discover" />

<section class="credo" data-discover-browse="devotions">
    <header class="credo__header">
        <p class="credo__eyebrow">Credo</p>
        <h1 class="credo__title">Devotions</h1>
        <p class="credo__lede">
            Choose a devotion and pray it bead by bead. The guide keeps your place, announces each
            mystery, and counts the prayers so you can simply pray.
        </p>
    </header>

    @if (_devotions is null)
    {
        <Loading>Gathering the devotions&hellip;</Loading>
    }
    else if (_devotions.Count == 0)
    {
        <p class="credo__empty">No devotions are available yet.</p>
    }
    else
    {
        <div class="credo__search">
            <label class="credo__search-label" for="devotion-search">Search devotions</label>
            <input id="devotion-search"
                   class="credo__search-input"
                   type="search"
                   placeholder="e.g. Rosary, chaplet, mercy..."
                   value="@_query"
                   @oninput="OnSearchInput" />
        </div>

        <div class="credo__layout">
            <aside class="credo__sidebar">
                @if (_kinds.Count > 0)
                {
                    <h2 class="credo__sidebar-title">Kind</h2>
                    <TopicFilter Topics="_kindLabels" Selected="_selectedKinds" SelectedChanged="OnKindsChanged" />
                }
                <ClearFiltersButton Active="_selectedKinds.Count > 0" OnClear="ClearFilters" />
            </aside>

            <div class="credo__results">
                <div class="credo__toolbar">
                    <p class="credo__count">@Filtered.Count of @(_devotions?.Count ?? 0) devotions</p>
                    <label class="credo__sort">
                        <span>Sort</span>
                        <select value="@_sort" @onchange="OnSortChanged">
                            <option value="@nameof(DevotionSort.TitleAsc)">Title (A&ndash;Z)</option>
                            <option value="@nameof(DevotionSort.TitleDesc)">Title (Z&ndash;A)</option>
                        </select>
                    </label>
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="credo__empty">No devotions match your search.</p>
                }
                else
                {
                    <CardGrid SingleColumn="true">
                        @foreach (var d in Filtered)
                        {
                            <Card Href="@($"discover/devotions/{d.Id}")"
                                  Title="@d.Title"
                                  Pill="@FormatKind(d.Kind)"
                                  Summary="@d.Summary"
                                  Cta="Begin &rarr;"
                                  Level="2" />
                        }
                    </CardGrid>
                }
            </div>
        </div>
    }
</section>

@code {
    private IReadOnlyList<DevotionSummary>? _devotions;
    private string _query = string.Empty;

    private DevotionSort _sort = DevotionSort.TitleAsc;

    private enum DevotionSort { TitleAsc, TitleDesc }

    private IReadOnlyList<string> _kinds = [];
    private IReadOnlyList<string> _kindLabels = [];
    private IReadOnlySet<string> _selectedKinds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        _query = BrowseState.GetQuery("devotions");
        _selectedKinds = new HashSet<string>(BrowseState.GetFilter("devotions.kind"), StringComparer.OrdinalIgnoreCase);

        var devotions = await DevotionService.GetIndexAsync();
        _devotions = devotions;

        _kinds = _devotions.Select(d => d.Kind)
            .Where(k => !string.IsNullOrWhiteSpace(k) && k != "devotion")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(k => k, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _kindLabels = [.. _kinds.Select(k => FormatKind(k) ?? k)];
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("respondeoDiscoverBrowse.restoreScroll", "devotions");
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        BrowseState.SetQuery("devotions", _query);
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<DevotionSort>(e.Value?.ToString(), out var sort))
        {
            _sort = sort;
        }
    }

    private void OnKindsChanged(IReadOnlySet<string> selected)
    {
        _selectedKinds = selected;
        BrowseState.SetFilter("devotions.kind", selected);
    }

    private void ClearFilters()
    {
        _selectedKinds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        BrowseState.SetFilter("devotions.kind", _selectedKinds);
    }

    // Turns a kind slug (e.g. "rosary") into a display tag (e.g. "Rosary").
    private static string? FormatKind(string kind)
    {
        if (string.IsNullOrWhiteSpace(kind) || kind == "devotion")
        {
            return null;
        }

        return char.ToUpperInvariant(kind[0]) + kind[1..];
    }

    private IReadOnlyList<DevotionSummary> Filtered
    {
        get
        {
            if (_devotions is null)
            {
                return [];
            }

            IEnumerable<DevotionSummary> results = _devotions;

            if (_selectedKinds.Count > 0)
            {
                results = results.Where(d => _selectedKinds.Contains(FormatKind(d.Kind) ?? d.Kind));
            }

            if (!string.IsNullOrWhiteSpace(_query))
            {
                var q = _query.Trim();
                results = results.Where(d =>
                    d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || d.Summary.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            results = _sort == DevotionSort.TitleDesc
                ? results.OrderByDescending(d => d.Title, StringComparer.CurrentCultureIgnoreCase)
                : results.OrderBy(d => d.Title, StringComparer.CurrentCultureIgnoreCase);

            return [.. results];
        }
    }
}
