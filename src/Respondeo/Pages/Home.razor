@page "/"
@inject IContentService Content
@inject IBreadcrumbTrail Trail
@inject IVisitedNodes Visited

<PageTitle>Respondeo &mdash; Real questions. Reasoned answers.</PageTitle>

<SeoHead OgType="website"
         Description="Reason moves from one honest question to the next — from God's existence to His Church. Explore the case for the Catholic faith one question at a time."
         JsonLd="@SiteMeta.WebSiteJsonLd()" />

<section class="pillar">
    <PillarHeader Eyebrow="Veritas" Title="One question leads to the next">
        <Lede>
            Reason moves from one honest question to the next &mdash; from God&rsquo;s existence to His Church.
            This site walks that path with you, one question at a time.
        </Lede>
    </PillarHeader>
</section>

@if (_stages is null)
{
    <Loading>Preparing the way&hellip;</Loading>
}
else
{
    <p class="reel__prompt">What speaks to you?</p>
    <StageReel Stages="_stages" />

    <div class="reel__aside">
        <p class="reel__aside-lead">Already further along the path?</p>
        <div class="reel__aside-paths">
            <a href="discover" class="reel__pill">Discover Catholicism</a>
            <a href="summa" class="reel__pill">Browse the Summa</a>
        </div>
    </div>
}

@code {
    private List<StageReel.ReelStage>? _stages;

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        await Visited.ClearAsync();

        // A card for each stage landing node (id == the stage slug), linking to the stage page.
        var stages = new List<StageReel.ReelStage>();
        foreach (var item in SiteNavigation.Items.Where(i => i.Href.Length > 0))
        {
            var node = await Content.GetByIdAsync(item.Href);
            if (node is not null)
            {
                stages.Add(new StageReel.ReelStage(item.Href, node));
            }
        }

        _stages = stages;
    }
}
