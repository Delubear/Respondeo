@page "/discover/saints"
@inject ISaintService SaintService
@inject SaintBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs
@inject IFeastOfTheDay FeastOfTheDay
@inject IDayWatcher DayWatcher
@implements IDisposable

<PageShell Title="Catholic Saints"
         Description="A growing gallery of the saints &mdash; their lives, patronages, state of life, and the Church's recognition of their holiness, from the early Church to our own day." />

<section class="pillar browse" data-browse-scroll="saints">
    <PillarHeader Eyebrow="A cloud of witnesses" Title="Catholic Saints">
        <Lede>
            A growing gallery of the saints &mdash; the holy men and women the Church holds up as examples
            and intercessors. Each profile tells their story, their patronage, and how the Church recognizes them.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the saints gallery" />

    @if (_all is null)
    {
        <Loading>Gathering the saints&hellip;</Loading>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="saints-search" Label="Search saints" Placeholder="e.g. Francis, missions, Africa..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
                @foreach (var (facet, title) in _rail)
                {
                    <TopicFilter Title="@title" Topics="Options(facet)" Selected="Selected(facet.Key)" SelectedChanged="set => OnFacetChanged(facet.Key, set)" DisplayLabel="SaintBrowse.Label(_facets, facet.Key)" Counts="Counts(facet)" />
                }
                <ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
            </Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_all.Count" Noun="saints" EmptyMessage="No saints match the current filters.">
                <Sort>
                    <SortSelect T="SaintIndexEntry" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var s in Filtered)
                    {
                        <Card Href="@ContentRoutes.SaintHref(s.Id)"
                              Title="@s.Title"
                              Pills="@Browser.Pills(s)"
                              Summary="@Browser.CardSummary(s, _facets)"
                              Cta="Read &rarr;"
                              Status="@(s.IsUnvetted ? CardStatus.InProgress : CardStatus.None)"
                              Feast="@_feastIds.Contains(s.Id)"
                              Level="2" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
    // Optional shareable-link filters, e.g. discover/saints?era=early-church&region=europe. Read once on load; the URL is never updated.
    [SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "era")] public string[]? LinkEras { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string[]? LinkRegions { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string[]? LinkStates { get; set; }
    [SupplyParameterFromQuery(Name = "designation")] public string[]? LinkDesignations { get; set; }
    [SupplyParameterFromQuery(Name = "sex")] public string[]? LinkSexes { get; set; }
    [SupplyParameterFromQuery(Name = "order")] public string[]? LinkOrders { get; set; }
    [SupplyParameterFromQuery(Name = "canonization")] public string[]? LinkCanonizations { get; set; }

    private IReadOnlyList<SaintIndexEntry>? _all;
    private Dictionary<string, IReadOnlyList<string>> _options = new();
    private readonly Dictionary<string, IReadOnlySet<string>> _selected = new();
    private IReadOnlySet<string> _feastIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private SaintFacetCatalog _facets = SaintFacetCatalog.Empty;
    private string _sortKey = _sortOptions[0].Key;
    private BrowseSection _browse = default!;

    // The rail, in display order. Each facet's key is also its shareable-link query name (see the Link* parameters above).
    private static readonly (Facet<SaintIndexEntry> Facet, string Title)[] _rail =
    [
        (SaintBrowse.EraFacet, "Era"),
        (SaintBrowse.RegionFacet, "Region"),
        (SaintBrowse.StateOfLifeFacet, "State of life"),
        (SaintBrowse.DesignationFacet, "Designation"),
        (SaintBrowse.SexFacet, "Sex"),
        (SaintBrowse.ReligiousOrderFacet, "Religious order"),
        (SaintBrowse.CanonizationFacet, "Canonization"),
    ];

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync. Adding a mode is one line.
    private static readonly SortOption<SaintIndexEntry>[] _sortOptions =
    [
        new("title-asc", "Name (A\u2013Z)", rows => rows.OrderBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Name (Z\u2013A)", rows => rows.OrderByDescending(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("era-asc", "Era (earliest first)", rows => rows.OrderBy(s => SaintBrowse.EraRank(s.Era)).ThenBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("era-desc", "Era (latest first)", rows => rows.OrderByDescending(s => SaintBrowse.EraRank(s.Era)).ThenBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        DayWatcher.DayChanged += OnDayChanged;
        _browse = Browse.Section("discover/saints", () => BrowseJs.ClearAsync("saints"));
        _browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?>
        {
            [SaintBrowse.EraFacet.Key] = LinkEras,
            [SaintBrowse.RegionFacet.Key] = LinkRegions,
            [SaintBrowse.StateOfLifeFacet.Key] = LinkStates,
            [SaintBrowse.DesignationFacet.Key] = LinkDesignations,
            [SaintBrowse.SexFacet.Key] = LinkSexes,
            [SaintBrowse.ReligiousOrderFacet.Key] = LinkOrders,
            [SaintBrowse.CanonizationFacet.Key] = LinkCanonizations,
        });
        foreach (var facet in SaintBrowse.AllFacets)
        {
            _selected[facet.Key] = new HashSet<string>(_browse.GetFilter(facet.Key), StringComparer.OrdinalIgnoreCase);
        }

        var facetsTask = SaintService.GetFacetsAsync();
        var indexTask = SaintService.GetIndexAsync();
        await Task.WhenAll(facetsTask, indexTask);
        _facets = await facetsTask;
        var index = await indexTask;
        _all = index.Entries;

        // Cards whose saint's fixed-date feast is today get a subtle golden shimmer.
        _feastIds = await FeastOfTheDay.GetTodayFeastIdsAsync();

        // Only surface facet options that actually occur in the catalog, in a stable display order.
        _options = SaintBrowse.AllFacets.ToDictionary(f => f.Key, f => Browser.Options(_all, _facets, f));
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("saints");
        }
    }

    // The watched day rolled over while the gallery stayed open; re-resolve today's feast ids so the
    // golden shimmer moves to the saints celebrated on the new day.
    private async void OnDayChanged()
    {
        await InvokeAsync(async () =>
        {
            _feastIds = await FeastOfTheDay.GetTodayFeastIdsAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => DayWatcher.DayChanged -= OnDayChanged;

    private void OnSearchChanged(string value) => _browse.Query = value;

    private void OnSortChanged(string value) => _sortKey = value;

    private static readonly IReadOnlySet<string> None = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> Options(Facet<SaintIndexEntry> facet) => _options.GetValueOrDefault(facet.Key) ?? [];

    private IReadOnlySet<string> Selected(string key) => _selected.GetValueOrDefault(key) ?? None;

    private void OnFacetChanged(string key, IReadOnlySet<string> selected)
    {
        _selected[key] = selected;
        _browse.SetFilter(key, selected);
    }

    private void ClearFilters()
    {
        _selected.Clear();
        _browse.Clear();
    }

    private SortOption<SaintIndexEntry> CurrentSort => _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0];

    // A saint matches when it satisfies every active facet group (intersection across groups, union within a group) and its title/summary/dates/tags contain the search query.
    private IReadOnlyList<SaintIndexEntry> Filtered => _all is null ? [] : Browser.Filter(_all, _facets, _browse.Query, Selected, CurrentSort);

    // Counts for one facet apply every OTHER active filter and the search, so each option shows what picking it would add.
    private IReadOnlyDictionary<string, int> Counts(Facet<SaintIndexEntry> facet) =>
        FacetFilter.Counts(Browser.Filter(_all ?? [], _facets, _browse.Query, Selected, _sortOptions[0], exceptKey: facet.Key), facet);
}
