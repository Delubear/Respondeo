@page "/discover/saints"
@inject ISaintService SaintService
@inject SaintBrowse Browser
@inject IBreadcrumbTrail Trail
@inject BrowseState Browse
@inject BrowseStateInterop BrowseJs
@inject IFeastOfTheDay FeastOfTheDay
@inject IDayWatcher DayWatcher
@implements IDisposable

<PageShell Title="Catholic Saints"
         Description="A growing gallery of the saints &mdash; their lives, patronages, state of life, and the Church's recognition of their holiness, from the early Church to our own day." />

<section class="pillar browse" data-browse-scroll="saints">
    <PillarHeader Eyebrow="A cloud of witnesses" Title="Catholic Saints">
        <Lede>
            A growing gallery of the saints &mdash; the holy men and women the Church holds up as examples
            and intercessors. Each profile tells their story, their patronage, and how the Church recognizes them.
        </Lede>
    </PillarHeader>

    <ConstructionNotice Area="the saints gallery" />

    @if (_all is null)
    {
        <Loading>Gathering the saints&hellip;</Loading>
    }
    else
    {
        <FilterLayout>
            <Search>
                <SearchBox Id="saints-search" Label="Search saints" Placeholder="e.g. Francis, missions, Africa..." Value="@_browse.Query" ValueChanged="OnSearchChanged" />
            </Search>
            <Rail>
                <TopicFilter Title="Era" Topics="_eras" Selected="_selectedEras" SelectedChanged="OnErasChanged" DisplayLabel="_facets.Era" Counts="Counts(0)" />
                <TopicFilter Title="Region" Topics="_regions" Selected="_selectedRegions" SelectedChanged="OnRegionsChanged" DisplayLabel="_facets.Region" Counts="Counts(1)" />
                <TopicFilter Title="State of life" Topics="_statesOfLife" Selected="_selectedStatesOfLife" SelectedChanged="OnStatesOfLifeChanged" DisplayLabel="_facets.StateOfLife" Counts="Counts(2)" />
                <TopicFilter Title="Designation" Topics="_designations" Selected="_selectedDesignations" SelectedChanged="OnDesignationsChanged" DisplayLabel="_facets.Designation" Counts="Counts(3)" />
                <TopicFilter Title="Sex" Topics="_sexes" Selected="_selectedSexes" SelectedChanged="OnSexesChanged" DisplayLabel="_facets.Sex" Counts="Counts(4)" />
                <TopicFilter Title="Religious order" Topics="_religiousOrders" Selected="_selectedReligiousOrders" SelectedChanged="OnReligiousOrdersChanged" DisplayLabel="_facets.ReligiousOrder" Counts="Counts(5)" />
                <TopicFilter Title="Canonization" Topics="_canonizations" Selected="_selectedCanonizations" SelectedChanged="OnCanonizationsChanged" DisplayLabel="_facets.Canonization" Counts="Counts(6)" />
                <ClearFiltersButton Active="_browse.HasActiveFilters" OnClear="ClearFilters" />
            </Rail>
            <ChildContent>
            <FilterResults FilteredCount="Filtered.Count" TotalCount="_all.Count" Noun="saints" EmptyMessage="No saints match the current filters.">
                <Sort>
                    <SortSelect T="SaintIndexEntry" Value="@_sortKey" ValueChanged="OnSortChanged" Options="_sortOptions" />
                </Sort>
                <ChildContent>
                    @foreach (var s in Filtered)
                    {
                        <Card Href="@ContentRoutes.SaintHref(s.Id)"
                              Title="@s.Title"
                              Pills="@Browser.Pills(s)"
                              Summary="@Browser.CardSummary(s, _facets)"
                              Cta="Read &rarr;"
                              Status="@(s.IsUnvetted ? CardStatus.InProgress : CardStatus.None)"
                              Feast="@_feastIds.Contains(s.Id)"
                              Level="2" />
                    }
                </ChildContent>
            </FilterResults>
            </ChildContent>
        </FilterLayout>
    }
</section>

@code {
    // Optional shareable-link filters, e.g. discover/saints?era=early-church&region=europe. Read once on load; the URL is never updated.
    [SupplyParameterFromQuery(Name = "q")] public string? LinkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "era")] public string[]? LinkEras { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string[]? LinkRegions { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string[]? LinkStates { get; set; }
    [SupplyParameterFromQuery(Name = "designation")] public string[]? LinkDesignations { get; set; }
    [SupplyParameterFromQuery(Name = "sex")] public string[]? LinkSexes { get; set; }
    [SupplyParameterFromQuery(Name = "order")] public string[]? LinkOrders { get; set; }
    [SupplyParameterFromQuery(Name = "canonization")] public string[]? LinkCanonizations { get; set; }

    private IReadOnlyList<SaintIndexEntry>? _all;
    private IReadOnlyList<string> _eras = [];
    private IReadOnlyList<string> _regions = [];
    private IReadOnlyList<string> _statesOfLife = [];
    private IReadOnlyList<string> _designations = [];
    private IReadOnlyList<string> _sexes = [];
    private IReadOnlyList<string> _religiousOrders = [];
    private IReadOnlyList<string> _canonizations = [];
    private IReadOnlySet<string> _feastIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private SaintFacetCatalog _facets = SaintFacetCatalog.Empty;
    private string _sortKey = _sortOptions[0].Key;
    private BrowseSection _browse = default!;
    private IReadOnlySet<string> _selectedEras = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedRegions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedStatesOfLife = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedDesignations = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedSexes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedReligiousOrders = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlySet<string> _selectedCanonizations = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    // Each sort option carries its own ordering, so the modes are declared once here and the dropdown, current selection, and Filtered logic all stay in sync. Adding a mode is one line.
    private static readonly SortOption<SaintIndexEntry>[] _sortOptions =
    [
        new("title-asc", "Name (A\u2013Z)", rows => rows.OrderBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("title-desc", "Name (Z\u2013A)", rows => rows.OrderByDescending(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("era-asc", "Era (earliest first)", rows => rows.OrderBy(s => SaintBrowse.EraRank(s.Era)).ThenBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
        new("era-desc", "Era (latest first)", rows => rows.OrderByDescending(s => SaintBrowse.EraRank(s.Era)).ThenBy(s => s.SortValue, StringComparer.CurrentCultureIgnoreCase)),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Trail.ClearAsync();
        DayWatcher.DayChanged += OnDayChanged;
        _browse = Browse.Section("discover/saints", () => BrowseJs.ClearAsync("saints"));
        _browse.ApplyLink(LinkQuery, new Dictionary<string, string[]?>
        {
            ["era"] = LinkEras,
            ["region"] = LinkRegions,
            ["state"] = LinkStates,
            ["designation"] = LinkDesignations,
            ["sex"] = LinkSexes,
            ["order"] = LinkOrders,
            ["canonization"] = LinkCanonizations,
        });
        _selectedEras = new HashSet<string>(_browse.GetFilter("era"), StringComparer.OrdinalIgnoreCase);
        _selectedRegions = new HashSet<string>(_browse.GetFilter("region"), StringComparer.OrdinalIgnoreCase);
        _selectedStatesOfLife = new HashSet<string>(_browse.GetFilter("state"), StringComparer.OrdinalIgnoreCase);
        _selectedDesignations = new HashSet<string>(_browse.GetFilter("designation"), StringComparer.OrdinalIgnoreCase);
        _selectedSexes = new HashSet<string>(_browse.GetFilter("sex"), StringComparer.OrdinalIgnoreCase);
        _selectedReligiousOrders = new HashSet<string>(_browse.GetFilter("order"), StringComparer.OrdinalIgnoreCase);
        _selectedCanonizations = new HashSet<string>(_browse.GetFilter("canonization"), StringComparer.OrdinalIgnoreCase);

        var facetsTask = SaintService.GetFacetsAsync();
        var indexTask = SaintService.GetIndexAsync();
        await Task.WhenAll(facetsTask, indexTask);
        _facets = await facetsTask;
        var index = await indexTask;
        _all = index.Entries;

        // Cards whose saint's fixed-date feast is today get a subtle golden shimmer.
        _feastIds = await FeastOfTheDay.GetTodayFeastIdsAsync();

        // Only surface facet options that actually occur in the catalog, in a stable display order.
        _eras = Browser.Eras(_all, _facets);
        _regions = Browser.Regions(_all, _facets);
        _statesOfLife = Browser.StatesOfLife(_all, _facets);
        _designations = Browser.Designations(_all, _facets);
        _sexes = Browser.Sexes(_all, _facets);
        _religiousOrders = Browser.ReligiousOrders(_all, _facets);
        _canonizations = Browser.Canonizations(_all, _facets);
    }

    // After the list first renders, ask JS to restore the remembered scroll position.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowseJs.RestoreScrollAsync("saints");
        }
    }

    // The watched day rolled over while the gallery stayed open; re-resolve today's feast ids so the
    // golden shimmer moves to the saints celebrated on the new day.
    private async void OnDayChanged()
    {
        await InvokeAsync(async () =>
        {
            _feastIds = await FeastOfTheDay.GetTodayFeastIdsAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => DayWatcher.DayChanged -= OnDayChanged;

    private void OnSearchChanged(string value) => _browse.Query = value;

    private void OnSortChanged(string value) => _sortKey = value;

    private void OnErasChanged(IReadOnlySet<string> selected)
    {
        _selectedEras = selected;
        _browse.SetFilter("era", selected);
    }

    private void OnRegionsChanged(IReadOnlySet<string> selected)
    {
        _selectedRegions = selected;
        _browse.SetFilter("region", selected);
    }

    private void OnStatesOfLifeChanged(IReadOnlySet<string> selected)
    {
        _selectedStatesOfLife = selected;
        _browse.SetFilter("state", selected);
    }

    private void OnCanonizationsChanged(IReadOnlySet<string> selected)
    {
        _selectedCanonizations = selected;
        _browse.SetFilter("canonization", selected);
    }

    private void OnDesignationsChanged(IReadOnlySet<string> selected)
    {
        _selectedDesignations = selected;
        _browse.SetFilter("designation", selected);
    }

    private void OnSexesChanged(IReadOnlySet<string> selected)
    {
        _selectedSexes = selected;
        _browse.SetFilter("sex", selected);
    }

    private void OnReligiousOrdersChanged(IReadOnlySet<string> selected)
    {
        _selectedReligiousOrders = selected;
        _browse.SetFilter("order", selected);
    }

    private void ClearFilters()
    {
        _selectedEras = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedRegions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedStatesOfLife = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedDesignations = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedSexes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedReligiousOrders = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _selectedCanonizations = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _browse.Clear();
    }

    // A saint matches when it satisfies every active facet group (intersection across groups, union within a group) and its title/summary/dates/tags contain the search query.
    private IReadOnlyList<SaintIndexEntry> Filtered =>
        _all is null
            ? Array.Empty<SaintIndexEntry>()
            : Browser.Filter(
                _all,
                _facets,
                _browse.Query,
                _selectedEras,
                _selectedRegions,
                _selectedStatesOfLife,
                _selectedDesignations,
                _selectedSexes,
                _selectedReligiousOrders,
                _selectedCanonizations,
                _sortOptions.FirstOrDefault(o => o.Key == _sortKey) ?? _sortOptions[0]);

    private static readonly IReadOnlySet<string> None = new HashSet<string>();

    // Counts for one facet group (by position in the rail) apply every OTHER active filter and the search,
    // so each option shows what picking it would add.
    private IReadOnlyDictionary<string, int> Counts(int facet)
    {
        var rows = Browser.Filter(
            _all ?? [],
            _facets,
            _browse.Query,
            facet == 0 ? None : _selectedEras,
            facet == 1 ? None : _selectedRegions,
            facet == 2 ? None : _selectedStatesOfLife,
            facet == 3 ? None : _selectedDesignations,
            facet == 4 ? None : _selectedSexes,
            facet == 5 ? None : _selectedReligiousOrders,
            facet == 6 ? None : _selectedCanonizations,
            _sortOptions[0]);

        return facet switch
        {
            0 => FacetCounts.Of(rows, s => s.Era),
            1 => FacetCounts.Of(rows, s => s.Region),
            2 => FacetCounts.Of(rows, s => s.StatesOfLife),
            3 => FacetCounts.Of(rows, s => s.Designations),
            4 => FacetCounts.Of(rows, s => s.Sex),
            5 => FacetCounts.Of(rows, s => s.ReligiousOrders),
            _ => FacetCounts.Of(rows, s => s.Canonizations),
        };
    }
}
