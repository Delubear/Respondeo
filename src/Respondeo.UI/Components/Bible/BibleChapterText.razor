<div class="bible-chapter">
    @foreach (var verse in Verses)
    {
        <p class="@VerseClass(verse.Number)" id="@($"v{verse.Number}")"><sup class="bible-verse__number">@verse.Number</sup> @verse.Text</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BibleVerse> Verses { get; set; } = [];
    [Parameter] public VerseSelection? Highlight { get; set; }

    private string VerseClass(int number) => Highlight?.Contains(number) == true ? "bible-verse bible-verse--highlight" : "bible-verse";
}
