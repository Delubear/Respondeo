@inject IBibleTranslations AllTranslations

<div class="bible-translation">
    <SegmentedToggle TValue="BibleTranslation" Options="_all" Value="Value" ValueChanged="SelectAsync"
                     Label="t => t.ShortName" Title="t => t.Name" AriaLabel="Bible translation" />
</div>
@if (!string.IsNullOrEmpty(Value?.Description))
{
    <p class="bible-translation__note">@Value.Description</p>
}

@code {
    private IReadOnlyList<BibleTranslation> _all = [];

    [Parameter] public BibleTranslation? Value { get; set; }

    [Parameter] public EventCallback<BibleTranslation> ValueChanged { get; set; }

    protected override async Task OnInitializedAsync() => _all = await AllTranslations.GetAllAsync();

    private Task SelectAsync(BibleTranslation translation) => ValueChanged.InvokeAsync(translation);
}
