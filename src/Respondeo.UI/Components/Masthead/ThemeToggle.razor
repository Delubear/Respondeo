@using Respondeo.Services
@implements IDisposable
@inject IThemeService Theme

<button type="button" class="theme-toggle" @onclick="ToggleAsync" title="@Label" aria-label="@Label">
    <span class="theme-toggle__glyph" aria-hidden="true">@Glyph</span>
</button>

@code {
    private bool IsDark => Theme.Current == Respondeo.Services.Theme.Dark;

    private string Glyph => IsDark ? "\u2600" : "\u263E"; // sun when dark (offer light), moon when light
    private string Label => IsDark ? "Switch to light theme" : "Switch to dark theme";

    // Several toggles can be on screen at once (masthead and a player/prayer bar); re-render whenever any of them changes the theme.
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
        }
    }

    private Task ToggleAsync() => Theme.ToggleAsync();

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
