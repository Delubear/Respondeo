@* Read-only row of tag "pill" chips shown at the foot of detail pages (articles, prayers, miracles).
    Renders nothing when there are no tags, and formats each slug through TagLabel so the chips read identically to the browse-page filters. *@

@if (Tags.Count > 0)
{
    <ul class="tag-list">
        @foreach (var tag in Tags)
        {
            <li class="tag">@TagLabel.Format(tag)</li>
        }
    </ul>
}

@code {
    /// <summary>The tag slugs to render as chips. An empty list renders nothing.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Tags { get; set; } = [];
}
