@* Reusable card used for stage cards and branches. Renders as a link by default, or as a button when an OnClick handler is supplied (e.g. an in-page action). *@

@if (OnClick.HasDelegate)
{
    <button type="button" class="@CssClass" @onclick="OnClick">
        @CardBody
    </button>
}
else
{
    <a class="@CssClass" href="@Href">
        @CardBody
    </a>
}

@code {
    [Parameter] public string? Href { get; set; }

    /// <summary>Optional in-page click handler. When set, the card renders as a button instead of a link.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional secondary title (e.g. a prayer's Latin name) shown beneath the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? Summary { get; set; }

    /// <summary>Optional set of short meta tags, each rendered as its own pill.</summary>
    [Parameter] public IReadOnlyList<string>? Pills { get; set; }

    /// <summary>Call-to-action text shown at the foot of the card.</summary>
    [Parameter] public string Cta { get; set; } = "Continue \u2192";

    /// <summary>Heading level for the title (2 or 3) so cards nest correctly under their section.</summary>
    [Parameter] public int Level { get; set; } = 2;

    /// <summary>
    /// The card's corner badge, which is mutually exclusive: a card shows at most one of a visited
    /// checkmark or an "in progress" ribbon, since both occupy the same top-right corner.
    /// </summary>
    [Parameter] public CardStatus Status { get; set; } = CardStatus.None;

    /// <summary>
    /// When true, the card renders a celebratory golden glow (e.g. a saint whose feast is today).
    /// This is a full-card treatment, not a corner badge, so it is orthogonal to <see cref="Status"/>
    /// and may be shown alongside a visited or in-progress card.
    /// </summary>
    [Parameter] public bool Feast { get; set; }

    private string CssClass => string.Concat(
        "card",
        Status == CardStatus.Visited ? " card--visited" : "",
        Status == CardStatus.InProgress ? " card--wip" : "",
        Feast ? " card--feast" : "");

    private IReadOnlyList<string> AllPills =>
        (Pills ?? [])
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

    // Split a trailing arrow glyph off the CTA so it can drift on hover independently of the label.
    private static readonly char[] ArrowGlyphs = ['\u2192', '\u2794', '\u279C', '\u27A4', '\u2B95'];

    private string? CtaArrow
    {
        get
        {
            var trimmed = Cta.TrimEnd();
            return trimmed.Length > 0 && ArrowGlyphs.Contains(trimmed[^1])
                ? trimmed[^1].ToString()
                : null;
        }
    }

    private string CtaLabel =>
        CtaArrow is null ? Cta : Cta[..Cta.LastIndexOfAny(ArrowGlyphs)].TrimEnd();

    private RenderFragment CardBody => __builder =>
    {
        @if (Status == CardStatus.InProgress)
        {
            <span class="card__ribbon" aria-label="Work in progress">In progress</span>
        }
        @if (Status == CardStatus.Visited)
        {
            <span class="card__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" focusable="false"><path d="M13.5 4.5 6.5 11.5 2.5 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
        }
        @if (Level <= 2)
        {
            <h2 class="card__title"><span class="card__title-text">@Title</span>@foreach (var pill in AllPills) {<span class="card__pill">@pill</span>}</h2>
        }
        else
        {
            <h3 class="card__title"><span class="card__title-text">@Title</span>@foreach (var pill in AllPills) {<span class="card__pill">@pill</span>}</h3>
        }
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="card__subtitle">@Subtitle</p>
        }
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <p class="card__summary">@Summary</p>
        }
        <span class="card__cta">@CtaLabel@if (CtaArrow is not null) {<span class="card__cta-arrow" aria-hidden="true">@CtaArrow</span>}</span>
    };
}
