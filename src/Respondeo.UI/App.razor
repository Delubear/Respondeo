@inject RoutePrefetcher Prefetcher
@inject ScrollCoordinator Scroll

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusContent RouteData="@routeData" />
    </Found>
</Router>

@code {
    // Prepare the native mask before any destination render; WebAssembly keeps its synchronous landing.
    private async Task OnNavigateAsync(NavigationContext context)
    {
        await Scroll.BeginNavigationAsync(context.Path);
        context.CancellationToken.ThrowIfCancellationRequested();
        await Prefetcher.PrefetchAsync(context.Path);
    }
}
