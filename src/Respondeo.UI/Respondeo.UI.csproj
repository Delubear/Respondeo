<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>Respondeo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="Respondeo.UnitTests" />
  </ItemGroup>

  <!--
	Emit content-hashed asset file names (_content/Respondeo.UI/css/<name>.<hash>.css, js/*.<hash>.js) at publish time.
	The host's OverrideHtmlAssetPlaceholders rewrites the #[.{fingerprint}] script placeholders in index.html,
	and the host's FingerprintAppStylesheet task rewrites the stylesheet links.
  -->
  <ItemGroup>
	<StaticWebAssetFingerprintPattern Include="Css" Pattern="*.css" Expression="#[.{fingerprint}]!" />
	<StaticWebAssetFingerprintPattern Include="Js" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Respondeo.Bible\Respondeo.Bible.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Shared\Respondeo.Content.Shared.csproj" />
	<ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
	<ProjectReference Include="..\Respondeo.Content\Respondeo.Content.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgicalCalendar\Respondeo.LiturgicalCalendar.csproj" />
	<ProjectReference Include="..\Respondeo.LiturgyOfTheHours\Respondeo.LiturgyOfTheHours.csproj" />
  </ItemGroup>

</Project>
