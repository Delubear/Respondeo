@page "/discover/articles/{Id}"
@inherits LoadableComponentBase<Article>
@inject IArticleService Articles

<DetailPage Loading="IsLoading" Id="@Id" Noun="Article" Title="@_article?.Title" Summary="@_article?.Summary"
            LoadingText="Opening the article…" StageHref="@ContentRoutes.Discover" StageLabel="Discover" Crumbs="_crumbs"
            ListHref="@ContentRoutes.Articles" BackLabel="Back to all articles" NotFoundBackLabel="Return to all articles"
            IsUnvetted="@(_article?.IsUnvetted ?? false)" BodyHtml="@_article?.BodyHtml"
            Tags="@(_article?.Tags ?? [])" Sources="@(_article?.Sources ?? [])" />

@if (!IsLoading && _article is not null)
{
    <ReaderMode Active="true" />
    <ReaderBar LeaveHref="@ContentRoutes.Articles" LeaveLabel="Articles" AriaLabel="Article tools" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private static readonly Breadcrumb.Crumb[] _crumbs = [new("articles", "Articles", Href: ContentRoutes.Articles)];

    private Article? _article => Value;

    protected override Task<Article?> LoadAsync(CancellationToken cancellationToken) => Articles.GetArticleAsync(Id);
}
