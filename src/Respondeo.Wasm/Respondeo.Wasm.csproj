<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      English-only site: drop the runtime's ICU globalization data (~hundreds of KB) from the
      download so first load is smaller. Culture-aware APIs behave as invariant; the app's
      CurrentCulture string sorting stays correct for the Latin/English content it orders.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Respondeo</RootNamespace>
    <AssemblyName>Respondeo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Respondeo.UnitTests" />
    <EmbeddedResource Include="..\Respondeo.UI\Configuration\appsettings.json" Link="appsettings.json" LogicalName="Respondeo.appsettings.json" />
  </ItemGroup>

  <!--
    The global css/js assets live in Respondeo.UI (served at _content/Respondeo.UI/), which declares the
    StaticWebAssetFingerprintPattern items. OverrideHtmlAssetPlaceholders rewrites the #[.{fingerprint}]
    placeholders in index.html to the hashed names, so assets can be cached forever yet always
    refresh after a deploy (needed on GitHub Pages, where we cannot set cache headers).
  -->

  <!-- .NET 11 packages this asset with an optional fingerprint. Static hosting needs a fingerprinted
       physical file, not just a server endpoint alias. Set this before HTML and PWA inventory generation. -->
  <Target Name="RequireFingerprintedBlazorBootstrap" AfterTargets="ReadPackageStaticWebAssetManifests">
    <ItemGroup>
      <StaticWebAsset Update="@(StaticWebAsset)"
        Condition="'%(StaticWebAsset.RelativePath)' == '_framework/blazor.webassembly#[.{fingerprint}]?.js'">
        <RelativePath>_framework/blazor.webassembly#[.{fingerprint}]!.js</RelativePath>
      </StaticWebAsset>
    </ItemGroup>
  </Target>

  <!--
    Publish-time stylesheet fingerprinting + PWA SRI re-sync. Extracted to its own file to keep
    this project file readable; see build/FingerprintAppStylesheet.targets for the rationale.
  -->
  <Import Project="build\FingerprintAppStylesheet.targets" />

  <!--
    Regenerate wwwroot/sitemap.xml from the content manifests before build. Extracted to its own
    file for readability; see build/GenerateSitemap.targets for the rationale.
  -->
  <Import Project="build\GenerateSitemap.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Progressive Web App support. The SDK generates service-worker-assets.js (the integrity
    manifest of every published static asset) from the ServiceWorkerAssetsManifest hint, and
    swaps service-worker.js for service-worker.published.js at publish time via the ServiceWorker
    item. The published worker precaches that manifest so the app - including the bundled Summa
    corpus and Markdown content - runs fully offline once installed.
  -->
  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respondeo.Bible\Respondeo.Bible.csproj" />
    <ProjectReference Include="..\Respondeo.Content.Shared\Respondeo.Content.Shared.csproj" />
    <ProjectReference Include="..\Respondeo.Content.Summa\Respondeo.Content.Summa.csproj" />
    <ProjectReference Include="..\Respondeo.Content\Respondeo.Content.csproj" />
    <ProjectReference Include="..\Respondeo.LiturgicalCalendar\Respondeo.LiturgicalCalendar.csproj" />
    <ProjectReference Include="..\Respondeo.LiturgyOfTheHours\Respondeo.LiturgyOfTheHours.csproj" />
    <ProjectReference Include="..\Respondeo.UI\Respondeo.UI.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\BuildManifest.targets" />
  <Import Project="..\..\build\ComposeHostShell.targets" />

</Project>
