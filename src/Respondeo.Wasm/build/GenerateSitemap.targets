<Project>

  <!--
	Regenerate wwwroot/sitemap.xml from the content manifests.

	The sitemap must list the app's real, crawlable routes, and those routes derive from the Summa
	part slug mapping (SummaParts) plus the shipped content manifests. Rather than duplicate that
	logic in MSBuild, we invoke the tools/Respondeo.SitemapGenerator tool, which references
	Respondeo.Content.Summa and parses the manifests to emit an accurate sitemap.

	Build ordering: we use the <MSBuild> task (an in-process build, NOT `dotnet run`) to build the
	generator and capture its output DLL, then exec that DLL. A nested `dotnet run` inside the outer
	build fails (MSB3073) because the child process inherits the outer build's MSBuild state; the
	in-process <MSBuild> task avoids that entirely and does not pollute the WASM app with a
	ProjectReference to an Exe.

	Opt-in only: this runs ONLY when GenerateSitemapOnBuild=true. The file is a generated artifact
	(NOT tracked in git — see .gitignore).

	IMPORTANT ordering caveat: the Blazor WASM SDK builds its static web asset list from the
	wwwroot/** content glob, which MSBuild evaluates ONCE at project-load time, before any target
	runs. Because sitemap.xml is gitignored, it is absent at evaluation on a clean checkout, so a
	file written here (BeforeBuild, i.e. after evaluation) is NOT in the glob and would be omitted
	from the published site (a live 404). For that reason the DEPLOY PIPELINE generates the sitemap
	in a dedicated step BEFORE `dotnet publish` (see .github/workflows/deploy.yml) so the file exists
	at evaluation and is globbed/published correctly. This in-build target remains only as a local
	convenience for an incremental rebuild where the file already exists on disk from a prior run.
	The generator no-ops (leaves the file untouched) when nothing changed.
  -->
  <PropertyGroup>
	<!-- Off by default; the deploy workflow passes -p:GenerateSitemapOnBuild=true on publish. -->
	<GenerateSitemapOnBuild Condition="'$(GenerateSitemapOnBuild)' == ''">false</GenerateSitemapOnBuild>
	<SitemapGeneratorProject>$(MSBuildThisFileDirectory)..\..\..\tools\Respondeo.SitemapGenerator\Respondeo.SitemapGenerator.csproj</SitemapGeneratorProject>
	<SitemapGeneratorDll>$(MSBuildThisFileDirectory)..\..\..\tools\Respondeo.SitemapGenerator\bin\$(Configuration)\net10.0\Respondeo.SitemapGenerator.dll</SitemapGeneratorDll>
	<SitemapOutputPath>$(MSBuildProjectDirectory)\wwwroot\sitemap.xml</SitemapOutputPath>
	<!-- No trailing slash: a trailing '\' immediately before the closing quote in the Exec command
		 would escape the quote and merge the arguments. -->
	<RepoRootPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</RepoRootPath>
  </PropertyGroup>

  <Target Name="GenerateSitemap"
		  BeforeTargets="BeforeBuild"
		  Condition="'$(GenerateSitemapOnBuild)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(BuildingForLiveUnitTesting)' != 'true'">
	<Message Importance="high" Text="Generating sitemap.xml from content manifests..." />

	<!-- The generator is NOT referenced by the app (it is invoked, not linked), so it is outside the
		 app's restore graph. On a clean CI checkout its obj/project.assets.json does not exist yet,
		 and a bare Build fails with NETSDK1004. Restore it in-process first, then build it. Both use
		 the <MSBuild> task (NOT `dotnet run`/`dotnet restore`, which fail nested inside this build). -->
	<MSBuild Projects="$(SitemapGeneratorProject)"
			 Targets="Restore"
			 Properties="Configuration=$(Configuration)" />

	<MSBuild Projects="$(SitemapGeneratorProject)"
			 Targets="Build"
			 Properties="Configuration=$(Configuration)" />

	<Exec Command="dotnet exec &quot;$(SitemapGeneratorDll)&quot; &quot;$(RepoRootPath)&quot; &quot;$(SitemapOutputPath)&quot;"
		  WorkingDirectory="$(RepoRootPath)" />
  </Target>

</Project>
